---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/ovladani-systemu.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Chytré funkce', href: '/chytre-funkce' }, { label: 'Ovládání systému', href: '/chytre-funkce/ovladani-systemu' }]}
  />

  <!-- Intro + obrázek PGDx -->
  <section class="pt-10 pb-12 lg:pt-12 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-6">{data.intro_headline}</h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p set:html={data.intro_text} />
          </div>
        </div>
        <div class="flex justify-center">
          <img src={data.intro_image_src} alt={data.intro_image_alt} class="rounded-2xl shadow-lg max-w-full h-auto" />
        </div>
      </div>
    </div>
  </section>

  <!-- Q&A sekce -->
  <section class="pb-16 lg:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-12">

        {data.questions.map((q) => (
          <div>
            <h2 class="text-xl lg:text-2xl font-bold text-charcoal-900 mb-4 flex items-start gap-3">
              <span class="w-8 h-8 bg-brand-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </span>
              {q.question}
            </h2>
            <div class="pl-11 space-y-4 text-charcoal-600 leading-relaxed">
              <p set:html={q.answer} />
              {q.answer2 && <p>{q.answer2}</p>}
              {q.callout && (
                <div class="bg-brand-50 border border-brand-200 rounded-xl p-5 mt-2">
                  <p class="text-sm text-brand-800 font-semibold">{q.callout}</p>
                </div>
              )}
              {q.example && (
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 mt-2">
                  <p class="text-sm text-charcoal-700"><strong>Příklad:</strong> {q.example}</p>
                </div>
              )}
            </div>
          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>
</Layout>