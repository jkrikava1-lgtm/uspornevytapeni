---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/inverter.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Chytré funkce', href: '/chytre-funkce/inverter' }, { label: 'Inverterová technologie', href: '/chytre-funkce/inverter' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.intro_label}</div>
          <h2 class="text-3xl font-extrabold text-charcoal-900 mb-6">{data.intro_headline}</h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>{data.intro_text1}</p>
            <p>{data.intro_text2}</p>
          </div>

          <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
              <div class="text-xs font-bold text-charcoal-400 uppercase tracking-wider mb-3">{data.onoff_title}</div>
              <div class="space-y-2 text-sm text-charcoal-600">
                {data.onoff_items.map(item => (
                  <div class="flex items-center gap-2"><span class="text-red-400">✗</span> {item}</div>
                ))}
              </div>
            </div>
            <div class="bg-brand-50 rounded-xl p-6 border border-brand-200">
              <div class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-3">{data.inverter_title}</div>
              <div class="space-y-2 text-sm text-charcoal-700">
                {data.inverter_items.map(item => (
                  <div class="flex items-center gap-2"><span class="text-brand-500">✓</span> {item}</div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-navy-700 rounded-2xl p-8 text-white">
            <div class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-4">{data.stats_label}</div>
            <div class="space-y-5">
              {[
                { hodnota: data.stat1_hodnota, popis: data.stat1_popis },
                { hodnota: data.stat2_hodnota, popis: data.stat2_popis },
                { hodnota: data.stat3_hodnota, popis: data.stat3_popis },
              ].map(item => (
                <div class="border-b border-navy-600 pb-4 last:border-0 last:pb-0">
                  <div class="text-3xl font-extrabold text-brand-300 mb-1">{item.hodnota}</div>
                  <div class="text-sm text-navy-100">{item.popis}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h3 class="font-bold text-charcoal-900 mb-2">{data.box_headline}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed">{data.box_text}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Výkonová tabulka TČ -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6 text-center">Podívejte se, jak se mění parametry tepelného čerpadla vzduch-voda v závislosti na otáčkách</h2>
      <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
        <iframe src="/tools/vykon-tc.html" class="w-full" style="height:700px;border:0;" loading="lazy" title="Výkonová tabulka tepelného čerpadla"></iframe>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Co je inverterová technologie u tepelného čerpadla?", "acceptedAnswer": { "@type": "Answer", "text": "Inverterová technologie umožňuje tepelnému čerpadlu plynule přizpůsobovat výkon kompresoru aktuální potřebě tepla — od minimálního po maximální výkon. Starší on/off systémy buď jedou na 100 %, nebo stojí. Inverter eliminuje zbytečné starty a zastávky." } },
      { "@type": "Question", "name": "Proč je inverterové tepelné čerpadlo lepší než on/off?", "acceptedAnswer": { "@type": "Answer", "text": "Inverterové čerpadlo šetří přibližně 20–30 % elektřiny oproti on/off systémům. Méně startů kompresoru znamená nižší opotřebení a delší životnost. Provoz je tišší a výkyvy teploty v domě jsou minimální." } },
      { "@type": "Question", "name": "Jsou všechna tepelná čerpadla Master Therm inverterová?", "acceptedAnswer": { "@type": "Answer", "text": "Ano. Dodáváme výhradně inverterová tepelná čerpadla Master Therm. Tento český výrobce s vlastní výrobou od roku 1994 staví inverterovou technologii jako standard ve všech svých modelech." } },
      { "@type": "Question", "name": "Jak moc šetří inverterové tepelné čerpadlo elektřinu?", "acceptedAnswer": { "@type": "Answer", "text": "Oproti on/off systémům šetří inverterové čerpadlo průměrně 20–30 % elektrické energie. Přesná úspora závisí na klimatických podmínkách a způsobu provozu. Díky plynulé regulaci je čerpadlo efektivní i při mírném mrazu, kdy je potřeba tepla nižší." } }
    ]
  })} />
</Layout>
