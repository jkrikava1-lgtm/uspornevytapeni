  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": {
      "@type": "LocalBusiness",
      "name": "Úsporné vytápění s.r.o.",
      "url": "https://uspornevytapeni.cz"
    },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "author": { "@type": "Person", "name": "Roman Vojtek" },
    "reviewBody": "Firma Úsporné vytápění s.r.o. nám místo elektrokotle namontovala tepelné čerpadlo vzduch-voda Master Therm. Provoz je jednoduchý, bezproblémový a hlavně o dvě třetiny levnější. S jejich prací jsme velmi spokojeni.",
    "name": "Tepelné čerpadlo vzduch-voda - Praha"
  })} />

</Layout>

<script>
  const slides = document.querySelectorAll('[data-hero-slide]');
  const dots = document.querySelectorAll('[data-hero-dot]');
  if (slides.length > 1) {
    let current = 0;

    /* Snímky 2 a 3 nemají src, jen data-src - jinak by si je prohlížeč stáhl
       hned při načtení stránky (leží v ploše obrazovky, takže na ně lazy
       nezabírá) a přidal 220 kB k tomu, co je potřeba pro první vykreslení.
       Dotahují se až v klidu po načtení a vždy o krok napřed, aby přechod
       neprobleskl. */
    function nacti(i) {
      const img = slides[i] && slides[i].querySelector('img[data-src]');
      if (!img) return;
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
    }
    const vKlidu = window.requestIdleCallback || (fn => setTimeout(fn, 1500));
    vKlidu(() => nacti(1));

    let timer = setInterval(next, 4000);

    function goTo(i) {
      nacti(i);
      nacti((i + 1) % slides.length);
      slides[current].classList.replace('opacity-100', 'opacity-0');
      dots[current].classList.replace('bg-white', 'bg-white/40');
      current = i;
      slides[current].classList.replace('opacity-0', 'opacity-100');
      dots[current].classList.replace('bg-white/40', 'bg-white');
    }

    function next() { goTo((current + 1) % slides.length); }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        clearInterval(timer);
        goTo(Number(dot.dataset.heroDot));
        timer = setInterval(next, 4000);
      });
    });
  }

  // Slide-in animace formuláře
  const formLeft = document.getElementById('hp-form-left');
  const formRight = document.getElementById('hp-form-right');
  if (formLeft && formRight) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          formLeft.style.opacity = '1';
          formLeft.style.transform = 'translateX(0)';
          formRight.style.opacity = '1';
          formRight.style.transform = 'translateX(0)';
        } else {
          formLeft.style.opacity = '0';
          formLeft.style.transform = 'translateX(-100px)';
          formRight.style.opacity = '0';
          formRight.style.transform = 'translateX(100px)';
        }
      });
    }, { threshold: 0.15 });
    obs.observe(formLeft);
  }

  // HP quick form – odeslání
  const hpForm = document.getElementById('hp-quick-form') as HTMLFormElement | null;
  const hpStatus = document.getElementById('hp-form-status');
  const hpBtn = document.getElementById('hp-submit-btn');
  const hpLoaded = document.getElementById('hp-loaded') as HTMLInputElement | null;
  if (hpLoaded) hpLoaded.value = String(Date.now());

  hpForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!hpBtn || !hpStatus) return;
    hpBtn.textContent = 'Odesílám…';
    (hpBtn as HTMLButtonElement).disabled = true;
    const fd = new FormData(hpForm);
    const payload: Record<string, string> = { zdroj: 'Web (homepage)' };
    fd.forEach((v, k) => { payload[k] = String(v); });
    try {
      const res = await fetch('/api/poptavka', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (json.success) {
        hpStatus.textContent = 'Poptávka odeslána! Ozveme se do 24 hodin.';
        hpStatus.className = 'text-sm py-2 px-3 rounded-lg bg-green-500/20 text-green-200';
        hpForm.reset();
        (window as any).uvTrack?.('odeslani_poptavky', { umisteni: 'homepage' }, { konverze: 'poptavka' });
      } else {
        throw new Error(json.error || 'Chyba');
      }
    } catch {
      hpStatus.textContent = 'Nepodařilo se odeslat. Zavolejte nám nebo pošlete e-mail.';
      hpStatus.className = 'text-sm py-2 px-3 rounded-lg bg-red-500/20 text-red-200';
      hpBtn.textContent = 'Odeslat poptávku';
      (hpBtn as HTMLButtonElement).disabled = false;
    }
    hpStatus.classList.remove('hidden');
  });

  // Lightbox pro Značku kvality
  const zkEl = document.querySelector('[data-hp-lightbox-img]');
  const zkLb = document.getElementById('hp-zk-lightbox');
  if (zkEl && zkLb) {
    zkLb.querySelector('img').src = '/images/znacka-kvality.webp';
    zkEl.addEventListener('click', () => zkLb.classList.remove('hidden'));
    zkLb.addEventListener('click', () => zkLb.classList.add('hidden'));
  }
</script>
