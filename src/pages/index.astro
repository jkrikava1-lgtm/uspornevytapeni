---
import Layout from '../layouts/Layout.astro';
import hp from '../data/homepage.json';
import site from '../data/site.json';

const whyUsIcons = [
  'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  'M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z',
];

const maxChart = Math.max(...hp.chart_items.map(i => i.value));
---

<Layout title={hp.meta_title} description={hp.meta_description} heroImg={hp.hero_slides[0]?.src}>

  <!-- HERO -->
  <section class="relative bg-navy-700 text-white overflow-hidden pt-12 lg:pt-16">
    <div class="absolute inset-0 opacity-5">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>


    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-navy-600 text-navy-100 text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full"></span>
            {hp.hero_badge}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-4">
            {hp.hero_h1_line1}<br>
            <span class="text-brand-300">{hp.hero_h1_highlight}</span>
          </h1>
          <p class="text-xl sm:text-2xl font-semibold text-navy-100 mb-6 max-w-xl">
            {hp.hero_h1_line3}
          </p>
          <p class="text-base text-navy-100 mb-10 max-w-xl leading-relaxed">
            {hp.hero_text}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-base">
              {hp.hero_cta_primary}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/reference" class="inline-flex items-center justify-center px-6 py-3.5 border border-navy-500 hover:border-navy-300 text-navy-100 hover:text-white font-semibold rounded-md transition-colors text-base">
              {hp.hero_cta_secondary}
            </a>
          </div>

          <!-- Trust bar -->
          <div class="mt-12 pt-10 border-t border-navy-600 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-xl">
            <div>
              <div class="text-2xl font-extrabold text-white">{hp.stat1_number}</div>
              <div class="text-xs text-navy-100 mt-0.5">{hp.stat1_label}</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-white">{hp.stat2_number}</div>
              <div class="text-xs text-navy-100 mt-0.5">{hp.stat2_label}</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-white">{hp.stat3_number}</div>
              <div class="text-xs text-navy-100 mt-0.5">{hp.stat3_label}</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-white whitespace-nowrap">{hp.stat4_number}</div>
              <div class="text-xs text-navy-100 mt-0.5">{hp.stat4_label}</div>
            </div>
          </div>
        </div>

        <!-- Hero carousel -->
        <div class="hidden lg:block">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl" id="hero-carousel">
            <div class="relative h-[460px]">
              {hp.hero_slides.map((slide, i) => (
                <div class={`absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`} data-hero-slide>
                  <div class="absolute inset-0">
                    <img src={i === 0 ? slide.src : undefined} data-src={i === 0 ? undefined : slide.src}
                      alt={slide.label} class="w-full h-full object-cover"
                      loading="lazy"
                      {/* Přednačtení prvního snímku řeší <link rel="preload" media="(min-width:1024px)">
                          v Layoutu. Tady schválně zůstává lazy: karusel je hidden lg:block, takže
                          na mobilu by se eager obrázek stáhl (110 kB), i když ho nikdo neuvidí.
                          LCP na mobilu je nadpis, na desktopu tenhle obrázek - a ten si zajistí preload. */}
                      onerror="this.style.display='none'" />
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-6">
                    <div class="text-white font-bold text-lg">{slide.label}</div>
                    <div class="text-white/70 text-sm">{slide.desc}</div>
                  </div>
                </div>
              ))}
            </div>
            <!-- Dots -->
            <div class="absolute bottom-6 right-6 flex gap-2">
              {hp.hero_slides.map((_, i) => (
                <button class={`w-2.5 h-2.5 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-white/40'}`} data-hero-dot={i} aria-label={`Slide ${i + 1}`}></button>
              ))}
            </div>
            <!-- Badge -->
            <div class="absolute top-5 left-5 inline-flex items-center gap-2 bg-black/50 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-brand-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {hp.hero_experience_badge}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA CARDS -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-charcoal-900 mb-3">{hp.cards_headline}</h2>
        <p class="text-charcoal-500 max-w-xl mx-auto">{hp.cards_subtitle}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {[
          { href: hp.card1_href, img: hp.card1_img, title: hp.card1_title, desc: hp.card1_desc, alt: hp.card1_title },
          { href: hp.card2_href, img: hp.card2_img, title: hp.card2_title, desc: hp.card2_desc, alt: hp.card2_title },
          { href: hp.card3_href, img: hp.card3_img, title: hp.card3_title, desc: hp.card3_desc, alt: hp.card3_title },
        ].map(card => (
          <a href={card.href} class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all duration-200">
            <div class="h-64 overflow-hidden">
              <img src={card.img} alt={card.alt} class="w-full h-full object-cover object-[center_15%] group-hover:scale-105 transition-transform duration-500" loading="lazy"
                   srcset={card.img.includes("novostavba-vizual") ? "/images/hero/novostavba-vizual-712.webp 712w, /images/hero/novostavba-vizual.webp 1328w" : undefined}
                   sizes="(max-width: 768px) 100vw, 440px" />
            </div>
            <div class="p-8 pt-5">
              <h3 class="text-lg font-bold text-charcoal-900 mb-2">{card.title}</h3>
              <p class="text-sm text-charcoal-500 leading-relaxed mb-4">{card.desc}</p>
              <span class="text-sm font-semibold text-brand-500 group-hover:text-brand-600 flex items-center gap-1">
                {hp.cards_cta}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <!-- PROČ TEPELNÁ ČERPADLA -->
  <section class="py-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{hp.savings_label}</div>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-6">{hp.savings_headline}</h2>
          <p class="text-charcoal-500 mb-8 leading-relaxed">
            {hp.savings_text}
          </p>
          <div class="space-y-5">
            {hp.savings_benefits.map(item => (
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-brand-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-charcoal-900 text-sm mb-0.5">{item.title}</div>
                  <div class="text-sm text-charcoal-500">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Graf úspory -->
        <div class="bg-navy-700 rounded-2xl p-8 lg:p-10 text-white relative overflow-hidden">
          <div class="absolute -right-8 -top-8 w-40 h-40 bg-navy-600 rounded-full opacity-60"></div>
          <div class="absolute -left-4 -bottom-4 w-28 h-28 bg-brand-500 rounded-full opacity-15"></div>
          <div class="relative">
            <div class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-4">{hp.chart_label}</div>
            <div class="text-5xl font-extrabold mb-2">{hp.chart_highlight_number}</div>
            <div class="text-navy-100 text-sm mb-8">{hp.chart_highlight_text}</div>
            <div class="space-y-3">
              {hp.chart_items.map(item => (
                <div>
                  <div class="flex justify-between text-xs text-navy-100 mb-1.5">
                    <span>{item.label}</span><span>~{item.value.toLocaleString('cs-CZ')} Kč/rok</span>
                  </div>
                  <div class="h-2 bg-navy-600 rounded-full">
                    <div class={`h-2 bg-${item.color} rounded-full`} style={`width: ${Math.round(item.value / maxChart * 100)}%`}></div>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-8 pt-6 border-t border-navy-600 text-xs text-navy-200">
              {hp.chart_footnote}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROČ MY -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{hp.why_us_label}</div>
        <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900">{hp.why_us_headline}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {hp.why_us_items.map((item, i) => (
          <div class="bg-white rounded-xl p-7 border border-gray-200">
            <div class="w-11 h-11 bg-navy-700 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={whyUsIcons[i]}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ZNAČKA KVALITY + AVTČ ČLENSTVÍ -->
  <section class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Značka kvality -->
        <div class="bg-gray-50 rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-6 cursor-pointer hover:shadow-md hover:border-brand-200 border border-gray-200 transition-all group" data-hp-lightbox-img>
          <img src="/images/znacka-kvality.webp" alt="Značka kvality AVTČ" class="w-32 sm:w-36 rounded-xl object-cover flex-shrink-0 self-stretch" loading="lazy" />
          <div>
            <div class="text-sm font-bold text-charcoal-900 mb-2">Značka kvality AVTČ</div>
            <p class="text-sm text-charcoal-500 leading-relaxed mb-4">Nositeli Značky kvality se mohou stát pouze firmy splňující přísná kritéria odbornosti a kvality instalací.</p>
            <span class="text-xs text-brand-500 font-semibold flex items-center gap-1 group-hover:gap-2 transition-all">Zobrazit detail <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg></span>
          </div>
        </div>

        <!-- Členství AVTČ -->
        <div class="bg-gray-50 rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-6 border border-gray-200">
          <div class="flex-shrink-0 flex items-center justify-center w-32 sm:w-36">
            <img src="/images/avtc-logo.svg" alt="Asociace pro využití tepelných čerpadel" class="w-full" loading="lazy" />
          </div>
          <div>
            <div class="text-sm font-bold text-charcoal-900 mb-2">Členové AVTČ</div>
            <p class="text-sm text-charcoal-500 leading-relaxed">Jsme členy Asociace pro využití tepelných čerpadel - profesní organizace sdružující přední firmy v oboru.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <div id="hp-zk-lightbox" class="fixed inset-0 z-50 bg-black/70 flex items-center justify-center hidden cursor-pointer">
    <img src="" alt="" class="max-w-2xl max-h-[80vh] rounded-2xl shadow-2xl object-contain" />
  </div>

  <!-- TESTIMONIAL -->
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gray-50 rounded-2xl p-8 lg:p-10 flex flex-col sm:flex-row items-center gap-6">
        <img src="/images/ilustrace/vojtek-reference.webp" alt={hp.testimonial_name} class="w-36 sm:w-44 rounded-xl object-cover object-top flex-shrink-0 self-stretch" loading="lazy" />
        <div>
          <blockquote class="text-sm text-charcoal-600 leading-relaxed mb-4">
            „{hp.testimonial_text}"
          </blockquote>
          <div class="font-bold text-charcoal-900 text-sm">{hp.testimonial_name}</div>
          <div class="text-xs text-charcoal-500">{hp.testimonial_location}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TYPY TČ -->
  <section class="bg-navy-700 py-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-3">{hp.products_label}</div>
        <h2 class="text-3xl font-extrabold text-white">{hp.products_headline}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {hp.products.map(item => (
          <a href={item.href} class="group bg-navy-600 hover:bg-navy-500 rounded-xl overflow-hidden transition-colors">
            {item.image && <img src={item.image} alt={item.title} class="w-full h-36 object-cover" loading="lazy" />}
            <div class="p-7">
            <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
            <p class="text-sm text-navy-100 leading-relaxed mb-4">{item.desc}</p>
            <span class="text-sm font-semibold text-brand-200 group-hover:text-brand-100 flex items-center gap-1">
              {hp.products_cta}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DOTACE BANNER -->
  <section class="bg-brand-500 py-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="text-white/90 text-sm font-semibold uppercase tracking-wider mb-1">{hp.dotace_label}</div>
          <h3 class="text-2xl font-extrabold text-white">{hp.dotace_headline}</h3>
          <p class="text-white/90 text-sm mt-1">{hp.dotace_text}</p>
        </div>
        <a href="/dotace" class="flex-shrink-0 inline-flex items-center px-6 py-3 bg-white text-brand-600 font-semibold rounded-md hover:bg-brand-50 transition-colors text-sm">
          {hp.dotace_cta}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- KONTAKTNÍ FORMULÁŘ HP -->
  <section class="relative bg-navy-900 py-16 lg:py-24 overflow-hidden" id="hp-kontakt">
    <!-- Topografický vzor -->
    <div class="absolute inset-0 opacity-[0.07] pointer-events-none select-none">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="rg" cx="70%" cy="50%" r="60%">
            <stop offset="0%" stop-color="white" stop-opacity="1"/>
            <stop offset="100%" stop-color="white" stop-opacity="0"/>
          </radialGradient>
          <mask id="rm"><rect width="100%" height="100%" fill="url(#rg)"/></mask>
        </defs>
        <g mask="url(#rm)" fill="none" stroke="white" stroke-width="1">
          {Array.from({ length: 18 }).map((_, i) => (
            <ellipse cx="72%" cy="50%" rx={`${8 + i * 6}%`} ry={`${5 + i * 4}%`} />
          ))}
        </g>
      </svg>
    </div>

    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Levý sloupec: text + kontakt -->
        <div id="hp-form-left" style="opacity:0;transform:translateX(-100px);transition:opacity .9s ease,transform .9s ease;">
          <div class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-4">Rychlá poptávka</div>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-white leading-tight mb-5">
            Připraveni zahájit<br/>váš projekt?
          </h2>
          <p class="text-navy-100 leading-relaxed mb-10 max-w-sm">
            Napište nám — nezávazně zjistíme, jaké tepelné čerpadlo vám nejlépe sedí, a připravíme orientační cenovou nabídku.
          </p>
          <div class="space-y-4 text-sm text-navy-100">
            <a href={site.phone_href} data-place="hp-kontakt" class="flex items-center gap-3 hover:text-white transition-colors">
              <div class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <span class="font-semibold">{site.phone}</span>
            </a>
            <a href={`mailto:${site.email}`} data-place="hp-kontakt" class="flex items-center gap-3 hover:text-white transition-colors">
              <div class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span>{site.email}</span>
            </a>
