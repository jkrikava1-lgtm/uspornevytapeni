---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/velky-vykon.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/velky-vykon' }, { label: 'Velký výkon', href: '/navrh-reseni/velky-vykon' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.intro_label}</div>
          <h2 class="text-3xl font-extrabold text-charcoal-900 mb-6">{data.intro_headline}</h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>{data.intro_text1}</p>
            <p>{data.intro_text2}</p>
          </div>

          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {[
              { typ: data.segment1_typ, popis: data.segment1_popis },
              { typ: data.segment2_typ, popis: data.segment2_popis },
              { typ: data.segment3_typ, popis: data.segment3_popis },
              { typ: data.segment4_typ, popis: data.segment4_popis },
              { typ: data.segment5_typ, popis: data.segment5_popis },
            ].map(item => (
              <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                <h4 class="font-bold text-charcoal-900 text-sm mb-2">{item.typ}</h4>
                <p class="text-xs text-charcoal-500 leading-relaxed">{item.popis}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <img src="/images/ilustrace/velky-vykon.webp" alt="BoxAir 60I s managerem" class="rounded-2xl w-full object-cover" loading="lazy" />
          <div class="bg-navy-700 rounded-2xl p-8 text-white">
            <div class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-4">{data.params_label}</div>
            <div class="space-y-3">
              {[
                { label: data.param1_label, value: data.param1_value },
                { label: data.param2_label, value: data.param2_value },
                { label: data.param3_label, value: data.param3_value },
                { label: data.param5_label, value: data.param5_value },
                { label: data.param6_label, value: data.param6_value },
              ].map(item => (
                <div class="flex justify-between py-2 border-b border-navy-600 last:border-0">
                  <span class="text-sm text-navy-100">{item.label}</span>
                  <span class="text-sm font-semibold">{item.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h3 class="font-bold text-charcoal-900 mb-3">{data.offer_headline}</h3>
            <ul class="space-y-2">
              {[data.offer_item1, data.offer_item2, data.offer_item3, data.offer_item4, data.offer_item5, data.offer_item6].map(item => (
                <li class="flex items-center gap-2 text-sm text-charcoal-600">
                  <svg class="w-4 h-4 text-brand-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-8 text-center">{data.konfigurace_headline}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-sm mb-4">1</div>
          <h3 class="font-bold text-charcoal-900 mb-2">{data.konfig_jedno_title}</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed mb-3">{data.konfig_jedno_desc}</p>
          <div class="text-xs text-charcoal-400"><strong class="text-charcoal-700">Modely:</strong> {data.konfig_jedno_modely}</div>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-sm mb-4">2</div>
          <h3 class="font-bold text-charcoal-900 mb-2">{data.konfig_dvou_title}</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed mb-3">{data.konfig_dvou_desc}</p>
          <div class="space-y-1">
            {data.konfig_dvou_body.map(item => (
              <div class="flex gap-2 items-start">
                <svg class="w-3.5 h-3.5 text-brand-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                <span class="text-xs text-charcoal-600">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-sm mb-4">3+</div>
          <h3 class="font-bold text-charcoal-900 mb-2">{data.konfig_kaskady_title}</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed mb-3">{data.konfig_kaskady_desc}</p>
          <div class="space-y-1">
            {data.konfig_kaskady_body.map(item => (
              <div class="flex gap-2 items-start">
                <svg class="w-3.5 h-3.5 text-brand-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                <span class="text-xs text-charcoal-600">{item}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button1}</a>
        <a href={`tel:${data.cta_button2.replace(/\s/g, '')}`} class="inline-flex items-center justify-center px-6 py-3.5 border-2 border-gray-200 hover:border-gray-400 text-charcoal-700 font-semibold rounded-md transition-colors">{data.cta_button2}</a>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Pro jaké objekty jsou tepelná čerpadla velkého výkonu vhodná?", "acceptedAnswer": { "@type": "Answer", "text": "Tepelná čerpadla velkého výkonu jsou vhodná pro bytové domy, hotely, penziomy, komerční objekty, průmyslové haly a zemědělské provozy. Výkon systému v kaskádovém zapojení může dosáhnout 1 000+ kW." } },
      { "@type": "Question", "name": "Co je kaskádové zapojení tepelných čerpadel?", "acceptedAnswer": { "@type": "Answer", "text": "Kaskáda je propojení více tepelných čerpadel za sebou pro dosažení vysokého celkového výkonu. Umožňuje modulární škálování výkonu, záložní provoz při výpadku jedné jednotky a optimální regulaci dle aktuální potřeby tepla." } },
      { "@type": "Question", "name": "Jaká je úspora při vytápění bytového domu tepelným čerpadlem?", "acceptedAnswer": { "@type": "Answer", "text": "Čím větší objekt, tím větší úspora — velké budovy typicky topí na starý způsob (plyn, elektřina) s vysokými náklady. Přechod na tepelné čerpadlo může snížit roční náklady na vytápění o 50–70 %. Zpracujeme konkrétní kalkulaci pro váš objekt." } },
      { "@type": "Question", "name": "Lze u tepelného čerpadla pro velký objekt zajistit bezobslužný provoz?", "acceptedAnswer": { "@type": "Answer", "text": "Ano. Systém zajišťuje minimální údržbu nebo zcela bezobslužný provoz s online monitoringem 24/7. Veškeré parametry sledujeme a nastavujeme na dálku." } }
    ]
  })} />
</Layout>
