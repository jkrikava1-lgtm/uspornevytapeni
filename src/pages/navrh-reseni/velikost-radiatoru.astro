---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/velikost-radiatoru.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/stavajici-dum' }, { label: 'Úprava radiátorů', href: '/navrh-reseni/velikost-radiatoru' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro1}
        </p>
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro2}
        </p>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-10 mb-4">{data.check_title}</h2>

        <div class="space-y-5">
          {data.check_steps.map((item, i) => (
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 bg-charcoal-800 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{i + 1}</div>
              <p class="text-charcoal-600 text-sm leading-relaxed pt-1">{item}</p>
            </div>
          ))}
        </div>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-10 mb-4">{data.alt_title}</h2>
        <p class="text-charcoal-600 leading-relaxed mb-4">
          {data.alt_intro}
        </p>
        <div class="space-y-3">
          {data.alt_points.map(item => (
            <div class="flex gap-2 items-start">
              <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-charcoal-600 text-sm">{item}</span>
            </div>
          ))}
        </div>

        <div class="bg-gray-100 rounded-xl p-6 mt-8">
          <p class="font-semibold text-sm text-charcoal-800">
            {data.tip_box}
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 mt-6">
          <h3 class="font-bold text-charcoal-900 mb-3 text-sm">{data.example_title}</h3>
          <div class="text-sm text-charcoal-600 space-y-1">
            <p set:html={data.example_line1} />
            <p set:html={data.example_line2} />
            <p class="text-charcoal-500 italic mt-2">{data.example_note}</p>
          </div>
        </div>

        <p class="text-charcoal-600 text-sm mt-6">
          {data.outro}
        </p>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>
</Layout>
