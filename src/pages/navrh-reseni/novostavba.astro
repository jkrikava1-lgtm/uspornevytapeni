---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/novostavba.json';
---

<Layout title={data.meta_title} description={data.meta_description} breadcrumbs={[{ label: 'Návrh řešení', href: '/navrh-reseni' }, { label: 'Novostavba', href: '/navrh-reseni/novostavba' }]}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/novostavba' }, { label: 'Novostavba', href: '/navrh-reseni/novostavba' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.why_label}</div>
          <h2 class="text-3xl font-extrabold text-charcoal-900 mb-6">{data.why_headline}</h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>{data.why_text1}</p>
            <p>{data.why_text2}</p>
          </div>

          <div class="mt-8 space-y-4">
            {[
              { title: data.feat1_title, desc: data.feat1_desc },
              { title: data.feat2_title, desc: data.feat2_desc },
              { title: data.feat3_title, desc: data.feat3_desc },
              { title: data.feat4_title, desc: data.feat4_desc },
            ].map(item => (
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-brand-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-charcoal-900 text-sm">{item.title}</div>
                  <div class="text-sm text-charcoal-500">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <img src="/images/hero/novostavba-vizual.jpg" alt="Tepelné čerpadlo u moderní novostavby" class="rounded-2xl w-full object-cover max-h-80" loading="lazy" />
      </div>

    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6 text-center">{data.related_headline}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        {data.related_items.map(item => (
          <a href={item.href} class="group bg-white rounded-xl border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all p-6">
            <img src={item.icon_img} alt={item.title} class="w-12 h-12 object-contain mb-3" />
            <h3 class="font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-sm text-charcoal-500 mb-3">{item.desc}</p>
            <span class="text-xs font-semibold text-brand-500 flex items-center gap-1">
              Více <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Jaký topný systém je nejlepší pro novostavbu?", "acceptedAnswer": { "@type": "Answer", "text": "Pro novostavby doporučujeme tepelné čerpadlo vzduch-voda nebo země-voda v kombinaci s podlahovým vytápěním. Systém zajišťuje 100% bezobslužný provoz, minimální náklady (z 1 kW elektřiny 3–4 kW tepla) a možnost chlazení v létě jednou technologií. Topení navrhujeme vždy na míru konkrétnímu projektu." } },
      { "@type": "Question", "name": "Lze v novostavbě kombinovat tepelné čerpadlo s podlahovým topením a chlazením?", "acceptedAnswer": { "@type": "Answer", "text": "Ano. Tepelné čerpadlo pokryje vytápění i chlazení jednou technologií. Podlahové topení v létě reverzně slouží k chlazení (pasivní nebo aktivní), v zimě k vytápění. Je to nejkomfortnější řešení s nejvyšší energetickou účinností." } },
      { "@type": "Question", "name": "Kdy je nejlepší začít řešit vytápění novostavby?", "acceptedAnswer": { "@type": "Answer", "text": "Ideálně před hrubou stavbou — topný systém lze navrhnout optimálně, rozvody podlahového topení zabetonovat a vrt nebo kolektor realizovat bez dodatečných prací. Konzultaci poskytneme zdarma." } },
      { "@type": "Question", "name": "Jaká dotace je dostupná na tepelné čerpadlo pro novostavbu?", "acceptedAnswer": { "@type": "Answer", "text": "Pro novostavby je dostupná podpora z programu Nová zelená úsporám 2026. Běžné domácnosti mohou získat bezúročný úvěr: až 400 000 Kč na zemní čerpadlo nebo až 350 000 Kč na vzduch-voda. Zranitelné domácnosti mají nárok na přímou dotaci NZÚ Light až 150 000 Kč. S žádostí pomůžeme." } }
    ]
  })} />
</Layout>
