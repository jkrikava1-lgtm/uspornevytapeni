---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SouvisejiciTemata from '../../components/SouvisejiciTemata.astro';
import SkladbaPodlahy from '../../components/SkladbaPodlahy.astro';
import VideoFasada from '../../components/VideoFasada.astro';
import vetev from '../../data/stavajici-dum.json';
import data from '../../data/podlahove-topeni-starsi-dum.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }, { label: 'Podlahové topení ve starším domě', href: '/navrh-reseni/podlahove-topeni-starsi-dum' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro1}
        </p>
        <p class="text-charcoal-700 font-semibold">
          {data.intro2}
        </p>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-12 mb-4">{data.porovnani_title}</h2>
        <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
          <table class="w-full min-w-[520px] border-collapse text-sm">
            <thead>
              <tr>
                {data.porovnani_hlavicka.map((h, i) => (
                  <th
                    scope="col"
                    class:list={[
                      'bg-navy-700 px-3 py-2.5 text-xs font-semibold text-white',
                      i === 0 ? 'text-left' : 'text-center',
                    ]}
                  >
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {data.porovnani_radky.map(radek => (
                <tr class="border-b border-gray-100 last:border-0 odd:bg-white even:bg-gray-50/70">
                  {radek.map((bunka, i) => (
                    <td
                      class:list={[
                        'px-3 py-2',
                        i === 0
                          ? 'font-semibold text-charcoal-800'
                          : 'text-center tabular-nums text-charcoal-600',
                      ]}
                    >
                      {bunka}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-charcoal-400">{data.porovnani_pozn}</p>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-12 mb-3">{data.suchy_title}</h2>
        <p class="text-charcoal-600 leading-relaxed">{data.suchy_text1}</p>
        <ul class="mt-4 space-y-2.5">
          {data.suchy_body.map(item => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-500"></span>
              <span class="text-sm leading-relaxed text-charcoal-600">{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {data.suchy_fotky.map(f => (
            <figure>
              <img
                src={f.src}
                width={f.w}
                height={f.h}
                loading="lazy"
                alt={f.alt}
                class="aspect-[3/2] w-full rounded-xl object-cover"
              />
              <figcaption class="mt-2 text-xs leading-snug text-charcoal-400">{f.popisek}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-2 text-xs text-charcoal-400">{data.suchy_foto_zdroj}</p>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-10 mb-3">{data.spider_title}</h2>
        <p class="text-charcoal-600 leading-relaxed">{data.spider_text1}</p>
        <ul class="mt-4 space-y-2.5">
          {data.spider_body.map(item => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-500"></span>
              <span class="text-sm leading-relaxed text-charcoal-600">{item}</span>
            </li>
          ))}
        </ul>

        <VideoFasada
          id={data.video_id}
          titulek={data.video_titulek}
          nahled="/images/video/spider-nahled.webp"
          start={data.video_start}
          konec={data.video_konec}
          popisek={data.video_popisek}
          pozn={data.video_pozn}
        />

        <div class="mt-10 rounded-xl border border-amber-200 bg-amber-50 p-5 sm:p-6">
          <div class="text-xs font-semibold uppercase tracking-wider text-amber-700">{data.limit_title}</div>
          <p class="mt-1.5 text-sm leading-relaxed text-charcoal-700">{data.limit_lead}</p>
          <ul class="mt-3 space-y-2.5">
            {data.limit_body.map(item => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-amber-500"></span>
                <span class="text-sm leading-relaxed text-charcoal-700">{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-sm leading-relaxed text-charcoal-600">{data.limit_zaver}</p>
        </div>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-12 mb-4">{data.klasika_title}</h2>

        <div class="space-y-5 mt-8">
          {data.steps.map((item, i) => (
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 bg-charcoal-800 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{i + 1}</div>
              <p class="text-charcoal-600 text-sm leading-relaxed pt-1">{item}</p>
            </div>
          ))}
        </div>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-12 mb-1">{data.skladba_title}</h2>
        <p class="text-charcoal-600 leading-relaxed">{data.skladba_intro}</p>
        <SkladbaPodlahy />

        <div class="bg-brand-50 rounded-xl p-6 border border-brand-100 mt-8">
          <p class="text-charcoal-700 text-sm leading-relaxed">
            {data.note}
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>

  <SouvisejiciTemata
    headline={vetev.related_headline}
    items={vetev.related_items}
    krome="/navrh-reseni/podlahove-topeni-starsi-dum"
  />

</Layout>
