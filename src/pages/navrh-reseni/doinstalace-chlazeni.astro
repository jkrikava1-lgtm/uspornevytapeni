---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SouvisejiciTemata from '../../components/SouvisejiciTemata.astro';
import vetev from '../../data/stavajici-dum.json';
import data from '../../data/doinstalace-chlazeni.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/stavajici-dum' }, { label: 'Doinstalace chlazení', href: '/navrh-reseni/doinstalace-chlazeni' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h2 class="text-lg font-extrabold text-charcoal-900 mb-4">{data.podlaha_title}</h2>
            <p class="text-charcoal-600 text-sm leading-relaxed mb-4">
              {data.podlaha_intro}
            </p>
            <div class="space-y-3">
              {data.podlaha_points.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <img src="/images/ilustrace/fancoil.webp" alt="Fancoil jednotka" class="w-full rounded-xl mb-4" loading="lazy" />
            <h2 class="text-lg font-extrabold text-charcoal-900 mb-4">{data.fancoil_title}</h2>
            <p class="text-charcoal-600 text-sm leading-relaxed mb-4">
              {data.fancoil_intro}
            </p>
            <div class="space-y-3">
              {data.fancoil_points.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

        <div class="bg-gray-100 rounded-xl p-6 mt-8">
          <p class="font-semibold text-sm text-charcoal-800">
            {data.tip_box}
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>

  <SouvisejiciTemata
    headline={vetev.related_headline}
    items={vetev.related_items}
    krome="/navrh-reseni/doinstalace-chlazeni"
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Lze chlazení doinstalovat k existujícímu tepelnému čerpadlu?", "acceptedAnswer": { "@type": "Answer", "text": "Ano, pokud čerpadlo podporuje reverzní chod — což většina moderních jednotek zvládá. Pak dokáže z topné vody vyrobit vodu chladící. Fancoily lze přidat dodatečně, podlahové pasivní chlazení je dostupné u zemních čerpadel. Posoudíme možnosti pro váš systém." } },
      { "@type": "Question", "name": "Dá se chladit stávajícím podlahovým topením?" , "acceptedAnswer": { "@type": "Answer", "text": "Ano, a je to nejjednodušší případ — chladí se stejným okruhem, kterým se topí, takže se do domu nijak nezasahuje. Dokoupí se prostorové termostaty s čidlem rosného bodu a zkontroluje se podlahová krytina. Vhodná je dlažba, kámen, lino, vinyl i plovoucí podlahy." } },
      { "@type": "Question", "name": "Co když podlahové topení nemám?", "acceptedAnswer": { "@type": "Answer", "text": "Pak se chladí fancoily — speciálními radiátory s vestavěným ventilátorem. Do hotového domu je doplnit lze, ale znamená to zásah: ke každému fancoilu se musí dodatečně natáhnout měděné potrubí, každý okruh má vlastní oběhové čerpadlo a je potřeba malé odpadní potrubí pro odvod kondenzátu." } },
      { "@type": "Question", "name": "Kolik stojí doinstalace chlazení?", "acceptedAnswer": { "@type": "Answer", "text": "Pokud máte podlahové topení, jde hlavně o prostorové termostaty s čidlem rosného bodu a nastavení systému. U fancoilů počítejte s investicí přibližně 20 000 Kč za místnost včetně rozvodů." } }
    ]
  })} />
</Layout>
