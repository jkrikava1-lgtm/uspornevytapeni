---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/doinstalace-chlazeni.json';
---

<Layout title="Jak doinstalovat chlazení" description="Standardy bydlení se zvyšují a chlazení je komfort, který si můžete s tepelným čerpadlem dopřát relativně jednoduše.">
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/stavajici-dum' }, { label: 'Doinstalace chlazení', href: '/navrh-reseni/doinstalace-chlazeni' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h2 class="text-lg font-extrabold text-charcoal-900 mb-4">{data.podlaha_title}</h2>
            <p class="text-charcoal-600 text-sm leading-relaxed mb-4">
              {data.podlaha_intro}
            </p>
            <div class="space-y-3">
              {data.podlaha_points.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h2 class="text-lg font-extrabold text-charcoal-900 mb-4">{data.fancoil_title}</h2>
            <p class="text-charcoal-600 text-sm leading-relaxed mb-4">
              {data.fancoil_intro}
            </p>
            <div class="space-y-3">
              {data.fancoil_points.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

        <div class="bg-gray-100 rounded-xl p-6 mt-8">
          <p class="font-semibold text-sm text-charcoal-800">
            {data.tip_box}
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>
</Layout>
