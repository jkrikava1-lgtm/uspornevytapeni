---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SouvisejiciTemata from '../../components/SouvisejiciTemata.astro';
import vetev from '../../data/novostavba.json';
import data from '../../data/podlahove-topeni.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }, { label: 'Podlahové topení', href: '/navrh-reseni/podlahove-topeni' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="prose-custom space-y-6 overflow-hidden">
        <img src="/images/ilustrace/podlahove-topeni.webp" alt="Podlahové topení" class="float-right ml-8 mb-4 w-64 lg:w-80 rounded-2xl shadow-md" loading="lazy" />
        <p class="max-w-3xl text-charcoal-600 leading-relaxed" set:html={data.intro1} />
        <p class="max-w-3xl text-charcoal-600 leading-relaxed">
          {data.intro2}
        </p>

        <div class="bg-brand-50 rounded-xl p-6 border border-brand-100">
          <p class="text-charcoal-800 font-semibold">{data.warranty}</p>
        </div>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-10 mb-4">{data.installation_title}</h2>

        <div class="space-y-4">
          {data.installation_steps.map((item, i) => (
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 bg-charcoal-800 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{i + 1}</div>
              <p class="text-charcoal-600 text-sm leading-relaxed pt-1">{item}</p>
            </div>
          ))}
        </div>

        <figure class="clear-both mt-8">
          <video
            src={data.video_soubor}
            poster={data.video_nahled}
            controls
            muted
            playsinline
            preload="none"
            width="1280"
            height="720"
            class="w-full rounded-2xl bg-charcoal-900"
          ></video>
          <figcaption class="mt-2.5 text-sm text-charcoal-500">
            {data.video_popisek}
            <span class="block text-xs">{data.video_pozn}</span>
          </figcaption>
        </figure>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>

  <SouvisejiciTemata
    headline={vetev.related_headline}
    items={vetev.related_items}
    krome="/navrh-reseni/podlahove-topeni"
  />

</Layout>
