---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/jednokompresorova.json';
---

<Layout title="Velká jednokompresorová tepelná čerpadla" description="Jednokompresorová tepelná čerpadla s výkonem až 45 kW. Vzduch-voda, země-voda i voda-voda. Nižší cena, levnější instalace.">
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/velky-vykon' }, { label: 'Jednokompresorová TČ', href: '/navrh-reseni/jednokompresorova' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          {data.cards.map(card => (
            <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
              <h2 class="text-lg font-extrabold text-charcoal-900 mb-3">{card.title}</h2>
              <p class="text-charcoal-600 text-sm leading-relaxed mb-3">
                {card.desc}
              </p>
              <h3 class="text-sm font-bold text-charcoal-800 mb-2">{card.models_label}</h3>
              <ul class="space-y-1 text-sm text-charcoal-600">
                {card.models.map(model => (
                  <li>{model}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>
</Layout>
