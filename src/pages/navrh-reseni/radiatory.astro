---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SouvisejiciTemata from '../../components/SouvisejiciTemata.astro';
import vetev from '../../data/novostavba.json';
import data from '../../data/radiatory.json';
import RadikTabulka from '../../components/RadikTabulka.astro';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }, { label: 'Radiátory', href: '/navrh-reseni/radiatory' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro1}
        </p>
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro2}
        </p>

        <figure class="pt-2">
          <img
            src="/images/ilustrace/radiatory-novy-dum.webp"
            width="1536"
            height="1024"
            fetchpriority="high"
            alt={data.foto_alt}
            class="rounded-2xl w-full object-cover"
          />
          <figcaption class="mt-2.5 text-sm text-charcoal-400">{data.foto_popisek}</figcaption>
        </figure>

        <div class="bg-gray-100 rounded-xl p-6">
          <p class="font-semibold text-charcoal-800">
            {data.highlight}
          </p>
        </div>

        <h2 class="text-xl font-extrabold text-charcoal-900 mt-10 mb-4">{data.tabulka_title}</h2>
        <p class="text-charcoal-600 leading-relaxed mb-6">{data.tabulka_intro}</p>

        <RadikTabulka />

        <p class="text-charcoal-600 leading-relaxed mt-10">
          {data.outro}
        </p>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>

  <SouvisejiciTemata
    headline={vetev.related_headline}
    items={vetev.related_items}
    krome="/navrh-reseni/radiatory"
  />

</Layout>
