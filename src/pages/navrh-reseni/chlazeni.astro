---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/chlazeni.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni/novostavba' }, { label: 'Chlazení', href: '/navrh-reseni/chlazeni' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro1}
        </p>
        <p class="text-charcoal-600 leading-relaxed">
          {data.intro2}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h2 class="text-lg font-extrabold text-charcoal-900 mb-4">{data.podlaha_title}</h2>
            <div class="space-y-3">
              {data.podlaha_points.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
            <div class="mt-4 bg-brand-50 rounded-lg p-4 border border-brand-100">
              <p class="text-sm text-charcoal-700 italic">
                {data.podlaha_quote}
              </p>
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <img src="/images/ilustrace/fancoil.webp" alt="Fancoil jednotka" class="w-full rounded-xl mb-4" loading="lazy" />
            <h2 class="text-lg font-extrabold text-charcoal-900 mb-4">{data.fancoil_title}</h2>
            <div class="space-y-3">
              {data.fancoil_points.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Jak se chladí dům tepelným čerpadlem?", "acceptedAnswer": { "@type": "Answer", "text": "Tepelné čerpadlo umí pracovat reverzně — místo výroby tepla odvádí teplo z interiéru ven. Chlazení probíhá buď pasivně podlahovým systémem (cirkulace studené vody z vrtu nebo kolektoru — téměř zdarma), nebo aktivně pomocí fancoilů (klimatizační jednotky na stěně či stropu)." } },
      { "@type": "Question", "name": "Jaký je rozdíl mezi podlahovým chlazením a fancoily?", "acceptedAnswer": { "@type": "Answer", "text": "Podlahové chlazení je pasivní — využívá stálou teplotu zemního zdroje (u zemních čerpadel). Je tiché, rovnoměrné a provozně téměř zdarma. Fancoily jsou aktivní klimatizační jednotky — reagují rychleji, jsou vhodné pro rychlé ochlazení nebo pro domy bez podlahy. Lze je kombinovat." } },
      { "@type": "Question", "name": "Je chlazení tepelným čerpadlem drahé?", "acceptedAnswer": { "@type": "Answer", "text": "Pasivní podlahové chlazení (free cooling) je téměř zdarma — spotřebuje pouze elektřinu oběhového čerpadla. Aktivní chlazení přes fancoily spotřebuje část výkonu kompresoru, ale stále výrazně méně než klasická klimatizace." } },
      { "@type": "Question", "name": "Lze chlazení doinstalovat k existujícímu tepelnému čerpadlu?", "acceptedAnswer": { "@type": "Answer", "text": "Ano, pokud čerpadlo podporuje reverzní chod (většina moderních jednotek). Fancoily lze přidat dodatečně. Podlahové pasivní chlazení je dostupné u zemních čerpadel. Posoudíme možnosti pro váš systém." } }
    ]
  })} />
</Layout>
