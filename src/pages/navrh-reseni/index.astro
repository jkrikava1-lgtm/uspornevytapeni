---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/navrh-reseni-index.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Typ objektu -->
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">{data.section_typ_objektu}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
        {data.typ_objektu_cards.map(item => (
          <a href={item.href} class="group bg-white rounded-xl border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all overflow-hidden">
            <img src={item.img} alt={item.title} class="w-full h-44 object-cover" loading="lazy" />
            <div class="p-7">
              <h3 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{item.title}</h3>
              <p class="text-sm text-charcoal-500 leading-relaxed mb-3">{item.desc}</p>
              <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
                {data.link_more}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Topný systém -->
      <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 bg-brand-50 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
          </svg>
        </div>
        <h2 class="text-xl font-extrabold text-charcoal-900">{data.section_topny_system}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-10">
        {data.topny_system_links.map(item => (
          <a href={item.href} class="group bg-gray-50 rounded-xl p-5 border border-gray-200 hover:bg-white hover:shadow-md hover:border-brand-300 transition-all">
            <div class="w-8 h-8 bg-brand-50 rounded-lg flex items-center justify-center mb-3 group-hover:bg-brand-100 transition-colors">
              <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 text-sm mb-1.5 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-xs text-charcoal-500 leading-relaxed mb-3">{item.desc}</p>
            <span class="text-xs font-semibold text-brand-500 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              Více <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Chlazení -->
      <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 bg-sky-50 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07"/>
          </svg>
        </div>
        <h2 class="text-xl font-extrabold text-charcoal-900">{data.section_chlazeni}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        {data.chlazeni_links.map(item => (
          <a href={item.href} class="group bg-gray-50 rounded-xl p-5 border border-gray-200 hover:bg-white hover:shadow-md hover:border-sky-300 transition-all">
            <div class="w-8 h-8 bg-sky-50 rounded-lg flex items-center justify-center mb-3 group-hover:bg-sky-100 transition-colors">
              <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 text-sm mb-1.5 group-hover:text-sky-600 transition-colors">{item.title}</h3>
            <p class="text-xs text-charcoal-500 leading-relaxed mb-3">{item.desc}</p>
            <span class="text-xs font-semibold text-sky-500 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              Více <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Konfigurace systému -->
      <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 bg-navy-50 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h2 class="text-xl font-extrabold text-charcoal-900">{data.section_konfigurace}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {data.konfigurace_links.map(item => (
          <a href={item.href} class="group bg-gray-50 rounded-xl p-5 border border-gray-200 hover:bg-white hover:shadow-md hover:border-navy-300 transition-all">
            <div class="w-8 h-8 bg-navy-50 rounded-lg flex items-center justify-center mb-3 group-hover:bg-navy-100 transition-colors">
              <svg class="w-4 h-4 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 text-sm mb-1.5 group-hover:text-navy-700 transition-colors">{item.title}</h3>
            <p class="text-xs text-charcoal-500 leading-relaxed mb-3">{item.desc}</p>
            <span class="text-xs font-semibold text-navy-500 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              Více <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>
</Layout>
