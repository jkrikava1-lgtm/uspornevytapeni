---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Návrh řešení vytápění" description="Najděte optimální řešení vytápění pro váš dům. Novostavby, rekonstrukce, podlahové topení, chlazení i kaskádové systémy.">
  <PageHero
    title="Návrh řešení"
    subtitle="Vybereme správné řešení pro váš dům — ať stavíte, rekonstruujete nebo potřebujete velký výkon."
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Typ objektu -->
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">Podle typu objektu</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
        {[
          { href: '/navrh-reseni/novostavba', title: 'Novostavba', desc: 'Optimální systém vytápění pro nový dům — tepelné čerpadlo, podlahové vytápění i chlazení v jednom projektu.', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
          { href: '/navrh-reseni/stavajici-dum', title: 'Stávající dům', desc: 'Výměna starého kotle za tepelné čerpadlo. Napojíme na stávající rozvody bez zbytečných komplikací.', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
          { href: '/navrh-reseni/velky-vykon', title: 'Velký výkon', desc: 'Kaskádové systémy pro bytové domy, komerční objekty i průmysl. Výkon od 20 do 200 kW.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
        ].map(item => (
          <a href={item.href} class="group bg-white rounded-xl p-7 border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all">
            <div class="w-11 h-11 bg-brand-50 group-hover:bg-brand-500 rounded-lg flex items-center justify-center mb-4 transition-colors">
              <svg class="w-5 h-5 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed mb-3">{item.desc}</p>
            <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
              Více informací
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Topný systém -->
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">Topný systém</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-14">
        {[
          { href: '/navrh-reseni/podlahove-topeni', title: 'Podlahové topení', desc: 'Ideální kombinace s tepelným čerpadlem. Rovnoměrné teplo v celém domě.' },
          { href: '/navrh-reseni/podlahove-topeni-starsi-dum', title: 'Podlahovka ve starším domě', desc: 'Ano, jde to. Vysvětlíme kdy a jak.' },
          { href: '/navrh-reseni/radiatory', title: 'Radiátory', desc: 'Tepelné čerpadlo funguje i s radiátory — záleží na typu a velikosti.' },
          { href: '/navrh-reseni/velikost-radiatoru', title: 'Velikost radiátorů', desc: 'Jak správně dimenzovat radiátory pro nízkoteplotní systém.' },
          { href: '/navrh-reseni/kombinace-topnych-okruhu', title: 'Kombinace okruhů', desc: 'Podlahovka + radiátory v jednom systému — běžné a funkční řešení.' },
        ].map(item => (
          <a href={item.href} class="group bg-gray-50 rounded-lg p-5 border border-gray-200 hover:border-brand-300 hover:bg-white hover:shadow transition-all">
            <h3 class="font-bold text-charcoal-900 text-sm mb-1.5 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>

      <!-- Chlazení -->
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">Chlazení</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-14">
        {[
          { href: '/navrh-reseni/chlazeni', title: 'Chlazení tepelným čerpadlem', desc: 'Tepelné čerpadlo v létě chladí — dvě funkce za cenu jedné.' },
          { href: '/navrh-reseni/doinstalace-chlazeni', title: 'Doinstalace chlazení', desc: 'Máte už tepelné čerpadlo a chcete přidat chlazení? Poradíme, jak na to.' },
        ].map(item => (
          <a href={item.href} class="group bg-gray-50 rounded-lg p-5 border border-gray-200 hover:border-brand-300 hover:bg-white hover:shadow transition-all">
            <h3 class="font-bold text-charcoal-900 text-sm mb-1.5 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>

      <!-- Konfigurace systému -->
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">Konfigurace systému</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          { href: '/navrh-reseni/jednokompresorova', title: 'Jednokompresorová sestava', desc: 'Standardní řešení pro běžný rodinný dům.' },
          { href: '/navrh-reseni/dvoukompresorova', title: 'Dvoukompresorová sestava', desc: 'Vyšší výkon a spolehlivost pro náročnější objekty.' },
          { href: '/navrh-reseni/kaskady', title: 'Kaskádové zapojení', desc: 'Více jednotek pro bytové domy a komerční budovy.' },
        ].map(item => (
          <a href={item.href} class="group bg-gray-50 rounded-lg p-5 border border-gray-200 hover:border-brand-300 hover:bg-white hover:shadow transition-all">
            <h3 class="font-bold text-charcoal-900 text-sm mb-1.5 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>

    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">Nevíte si rady?</h2>
      <p class="text-charcoal-500 mb-8">Pošlete poptávku a navrhneme řešení přesně pro váš dům — zdarma.</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">Odeslat poptávku</a>
    </div>
  </section>
</Layout>
