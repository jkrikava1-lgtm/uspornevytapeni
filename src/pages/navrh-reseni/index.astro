---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/navrh-reseni-index.json';

// Na mobilu se obě mřížky rozpadnou do jedné (`contents`), aby karta a její
// podstránky zůstaly u sebe; `order` je prostřídá. Třídy musí být zapsané celé,
// jinak si jich Tailwind nevšimne.
const poradiKaret = ['order-1', 'order-3', 'order-5'];
const poradiPodstranek = ['order-2', 'order-4', 'order-6'];
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }]}
  />

  <article class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-charcoal-600 text-sm leading-relaxed max-w-3xl mb-10">Tepelné čerpadlo je investice na desítky let. Proto je důležité vybrat správný typ a konfiguraci systému přesně podle vašeho domu. Pomůžeme vám s výběrem — ať stavíte nový dům, rekonstruujete vytápění ve stávajícím, nebo potřebujete řešení pro větší objekt.</p>

      <div class="grid grid-cols-1 gap-4 md:block">
      <!-- Hlavní karty — vlastní mřížka, aby se všechny tři srovnaly na stejnou výšku -->
      <div class="contents md:grid md:grid-cols-3 md:gap-8">
        {data.typ_objektu_cards.map((card, ci) => (
          <a
            href={card.href}
            class:list={['group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-all hover:border-brand-300 hover:shadow-lg', poradiKaret[ci]]}
          >
            <img src={card.img} alt={card.title} class="h-52 w-full object-cover object-[center_15%]" loading="lazy" />
            <div class="flex flex-1 flex-col p-7">
              <h3 class="mb-2 text-lg font-bold text-charcoal-900 transition-colors group-hover:text-brand-500">{card.title}</h3>
              <p class="mb-3 text-sm leading-relaxed text-charcoal-500">{card.desc}</p>
              {/* mt-auto drží odkaz u dolní hrany i u kratšího popisu */}
              <span class="mt-auto flex items-center gap-1 text-sm font-semibold text-brand-500">
                {data.link_more}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Podstránky pod každou větví; kombinace okruhů patří do obou -->
      <div class="contents md:mt-3 md:grid md:grid-cols-3 md:gap-8">
        {data.typ_objektu_cards.map((card, ci) => (
          <div class="contents md:flex md:flex-col md:gap-3">
            {[...(card.children ?? []), ...(card.children?.length && data.shared_link ? [data.shared_link] : [])].map(item => (
              <a
                href={item.href}
                class:list={['group flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3.5 transition-all hover:border-brand-300 hover:bg-white hover:shadow-md', poradiPodstranek[ci]]}
              >
                <img src={item.icon_img} alt={item.title} class="w-8 h-8 object-contain flex-shrink-0" />
                <span class="flex-1 text-sm font-semibold text-charcoal-700 transition-colors group-hover:text-brand-500">{item.title}</span>
                <svg class="w-3.5 h-3.5 flex-shrink-0 text-charcoal-300 transition-all group-hover:translate-x-0.5 group-hover:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            ))}
          </div>
        ))}
      </div>
      </div>

    </div>
  </article>

  <!-- Jak probíhá návrh -->
  <section class="py-12 lg:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-8">Jak probíhá návrh systému</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-extrabold text-lg flex items-center justify-center mx-auto mb-3">1</div>
          <h3 class="font-bold text-charcoal-800 mb-1 text-sm">Konzultace zdarma</h3>
          <p class="text-xs text-charcoal-500 leading-relaxed">Pošlete poptávku nebo zavolejte. Zjistíme základní parametry — typ objektu, stávající vytápění, plocha.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-extrabold text-lg flex items-center justify-center mx-auto mb-3">2</div>
          <h3 class="font-bold text-charcoal-800 mb-1 text-sm">Prohlídka objektu</h3>
          <p class="text-xs text-charcoal-500 leading-relaxed">Technik přijede na místo, změří, posoudí stávající rozvody a navrhne optimální řešení přímo pro váš dům.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-extrabold text-lg flex items-center justify-center mx-auto mb-3">3</div>
          <h3 class="font-bold text-charcoal-800 mb-1 text-sm">Technický návrh a nabídka</h3>
          <p class="text-xs text-charcoal-500 leading-relaxed">Vypracujeme přesný projekt s výběrem čerpadla, schématem zapojení a nacenění včetně možných dotací.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-extrabold text-lg flex items-center justify-center mx-auto mb-3">4</div>
          <h3 class="font-bold text-charcoal-800 mb-1 text-sm">Instalace a servis</h3>
          <p class="text-xs text-charcoal-500 leading-relaxed">Naši technici systém nainstalují a uvedou do provozu. Servis a záruční i pozáruční podporu zajišťujeme sami.</p>
        </div>
      </div>
      <p class="mt-8 text-sm text-charcoal-600 leading-relaxed max-w-3xl">Správně navržený systém je základ ekonomického provozu. Chyba ve výkonu čerpadla nebo nevhodně zvolený typ topení může znamenat zbytečně vysoké účty za elektřinu po celou dobu životnosti systému — tj. 20 a více let. Proto každý projekt konzultujeme individuálně a neprodáváme standardizovaná řešení z katalogu bez prohlídky.</p>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>
</Layout>
