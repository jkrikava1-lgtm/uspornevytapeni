---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/navrh-reseni-index.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Návrh řešení', href: '/navrh-reseni' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {data.typ_objektu_cards.map(card => (
          <div class="flex flex-col">
            <!-- Hlavní karta -->
            <a href={card.href} class="group bg-white rounded-xl border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all overflow-hidden flex-shrink-0">
              <img src={card.img} alt={card.title} class="w-full h-52 object-cover object-[center_15%]" loading="lazy" />
              <div class="p-7">
                <h3 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{card.title}</h3>
                <p class="text-sm text-charcoal-500 leading-relaxed mb-3">{card.desc}</p>
                <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
                  {data.link_more}
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>

            <!-- Spojovací čára -->
            {card.children && card.children.length > 0 && (
              <div class="flex flex-col items-center">
                <div class="w-0.5 h-6 bg-gray-300"></div>
              </div>
            )}

            <!-- Podstrom -->
            {card.children && card.children.length > 0 && (
              <div class="space-y-2">
                {card.children.map(child => (
                  <a href={child.href} class="group flex items-center gap-3 bg-gray-50 rounded-lg px-4 py-3 border border-gray-200 hover:bg-white hover:border-brand-300 hover:shadow-sm transition-all">
                    <div class="w-1.5 h-1.5 bg-brand-400 rounded-full flex-shrink-0"></div>
                    <span class="text-sm font-semibold text-charcoal-700 group-hover:text-brand-500 transition-colors flex-1">{child.title}</span>
                    <svg class="w-3.5 h-3.5 text-charcoal-300 group-hover:text-brand-400 transition-colors group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>
</Layout>
