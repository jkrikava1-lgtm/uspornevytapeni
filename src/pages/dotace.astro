---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/dotace.json';
---

<Layout title={data.meta_title} description={data.meta_description} breadcrumbs={[{ label: 'Dotace', href: '/dotace' }]}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Dotace', href: '/dotace' }]}
  />

  <!-- Intro -->
  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <img src="/images/nzu-logo.webp" alt="Nová zelená úsporám" class="h-10 w-auto" />
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <p class="text-charcoal-600 text-lg leading-relaxed mb-8" set:html={data.intro} />

          <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.harmonogram_headline}</h2>
          <p class="text-charcoal-500 text-sm mb-6">{data.harmonogram_intro}</p>

          <div class="space-y-0">
            {data.harmonogram.map((item, i) => (
              <div class="flex gap-4 items-start relative">
                <div class="flex flex-col items-center">
                  <div class="w-8 h-8 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 z-10">{i + 1}</div>
                  {i < data.harmonogram.length - 1 && <div class="w-0.5 bg-navy-200 flex-1 min-h-6"></div>}
                </div>
                <div class="pb-5">
                  <div class="font-bold text-charcoal-900 text-sm">{item.datum}</div>
                  <p class="text-charcoal-600 text-sm mt-0.5 leading-relaxed">{item.popis}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <img src="/images/ilustrace/dotace.webp" alt="Dotace na tepelné čerpadlo" class="rounded-2xl w-full shadow-md sticky top-24" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Hlavní změna: Dotace vs Úvěry -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.zmena_headline}</h2>
      <p class="text-charcoal-500 text-sm mb-6">{data.zmena_intro}</p>

      <div class="max-w-2xl">
        <div class="bg-white border border-gray-200 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-9 h-9 bg-navy-700 text-white rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
            </div>
            <div>
              <h3 class="font-extrabold text-charcoal-900">{data.bezne_title}</h3>
              <p class="text-charcoal-400 text-xs">{data.bezne_subtitle}</p>
            </div>
          </div>

          <div class="space-y-3 mt-4">
            <p class="text-charcoal-600 text-sm leading-relaxed" set:html={data.bezne_desc} />
            <p class="text-charcoal-600 text-sm leading-relaxed" set:html={data.bezne_jak} />
            <div class="bg-green-50 border border-green-200 rounded-lg p-3">
              <p class="text-green-800 text-sm" set:html={data.bezne_vyhoda} />
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-lg p-3">
              <p class="text-amber-800 text-sm" set:html={data.bezne_nevyhoda} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Podpora tepelných čerpadel -->
  <section class="bg-gray-50 py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.tc_headline}</h2>
      <p class="text-charcoal-500 text-sm mb-6">{data.tc_intro}</p>

      <div class="bg-navy-700 rounded-xl p-5 text-white mb-4">
        <div class="space-y-0">
          {data.tc_body.map(item => (
            <div class="flex justify-between py-2.5 border-b border-navy-600 last:border-0 gap-4">
              <span class="text-sm text-navy-100">{item.label}</span>
              <span class="text-sm font-bold flex-shrink-0">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      <p class="text-charcoal-600 text-sm leading-relaxed">{data.tc_note}</p>
    </div>
  </section>

  <!-- Renovační pas -->
  <section class="bg-gray-50 py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.renovacni_headline}</h2>
      <p class="text-charcoal-500 text-sm mb-5">{data.renovacni_intro}</p>

      <div class="space-y-3">
        {data.renovacni_body.map(item => (
          <div class="flex gap-2.5 items-start">
            <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <span class="text-charcoal-600 text-sm leading-relaxed" set:html={item} />
          </div>
        ))}
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mt-6">
        <div class="flex gap-2.5">
          <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-sm text-amber-800 leading-relaxed">{data.tip_box}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ schema markup -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Kolik je dotace na tepelné čerpadlo v roce 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Záleží na kategorii žadatele. Běžné domácnosti získají bezúročný úvěr (RPSN 0%) — stát hradí veškeré úroky. Maximální výše úvěru: TČ vzduch-vzduch 200 000 Kč, TČ vzduch-voda 350 000 Kč, TČ země-voda 400 000 Kč. Zranitelné domácnosti (NZÚ Light) mají nárok na přímou dotaci: TČ vzduch-vzduch 100 000 Kč, TČ vzduch-voda nebo země-voda 150 000 Kč."
        }
      },
      {
        "@type": "Question",
        "name": "Kdy se otevřel příjem žádostí o podporu NZÚ v roce 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Program NZÚ byl dočasně uzavřen v listopadu 2025 kvůli vyčerpání alokace. V roce 2026 přešel do nové etapy s bezúročnými úvěry pro běžné domácnosti a přímými dotacemi NZÚ Light pro zranitelné. Žádosti se podávají přes portál zadosti.sfzp.cz. Síť certifikovaných energetických poradců (EKIS) je v provozu od dubna 2026."
        }
      },
      {
        "@type": "Question",
        "name": "Kdo má nárok na podporu na tepelné čerpadlo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bezúročný úvěr z programu NZÚ 2026 může čerpat každá domácnost instalující certifikované tepelné čerpadlo. Podmínkou je renovační pas (zdarma přes poradce EKIS) a splnění podmínek banky pro úvěr. Výše úvěru: TČ vzduch-vzduch až 200 000 Kč, TČ vzduch-voda až 350 000 Kč, TČ země-voda až 400 000 Kč."
        }
      },
      {
        "@type": "Question",
        "name": "Jak funguje bezúročný úvěr na tepelné čerpadlo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Půjčíte si v bance nebo stavební spořitelně a stát uhradí veškeré úroky po celou dobu splatnosti — RPSN 0%. Splácíte pouze jistinu. Maximální výše úvěru: TČ vzduch-vzduch 200 000 Kč, TČ vzduch-voda 350 000 Kč, TČ země-voda 400 000 Kč. Dílčí renovace: až 750 000 Kč celkem, komplexní renovace: až 2 000 000 Kč. Žádost se podává přes portál zadosti.sfzp.cz."
        }
      },
      {
        "@type": "Question",
        "name": "Co je Renovační pas a potřebuji ho pro dotaci?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Renovační pas je dokument od certifikovaného energetického poradce, který posoudí váš dům a stanoví optimální postup renovace. Pro bezúročný úvěr NZÚ je renovační pas povinný — zpracuje ho poradce EKIS zdarma. Síť poradců EKIS funguje od dubna 2026."
        }
      }
    ]
  })} />

  <!-- CTA -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>
</Layout>
