---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/dotace.json';
import site from '../data/site.json';
---

<Layout title={data.meta_title} description={data.meta_description} breadcrumbs={[{ label: 'Dotace', href: '/dotace' }]}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": data.faq.map((item: {q: string, a: string}) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Dotace', href: '/dotace' }]}
  />

  <!-- Intro -->
  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <img src="/images/nzu-logo.webp" alt="Nová zelená úsporám" class="h-10 w-auto" />
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <p class="text-charcoal-600 text-lg leading-relaxed mb-8" set:html={data.intro} />

          <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.harmonogram_headline}</h2>
          <p class="max-w-3xl text-charcoal-500 text-sm mb-6">{data.harmonogram_intro}</p>

          <div class="space-y-0">
            {data.harmonogram.map((item, i) => (
              <div class="flex gap-4 items-start relative">
                <div class="flex flex-col items-center">
                  <div class="w-8 h-8 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 z-10">{i + 1}</div>
                  {i < data.harmonogram.length - 1 && <div class="w-0.5 bg-navy-200 flex-1 min-h-6"></div>}
                </div>
                <div class="pb-5">
                  <div class="font-bold text-charcoal-900 text-sm">{item.datum}</div>
                  <p class="text-charcoal-600 text-sm mt-0.5 leading-relaxed" set:html={item.popis} />
                </div>
              </div>
            ))}
          </div>
        </div>
        <img src="/images/ilustrace/dotace.webp" alt="Dotace na tepelné čerpadlo" class="rounded-2xl w-full shadow-md sticky top-24" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Dvě větve programu. Každá má úplný výčet podmínek včetně těch
       společných - stránka je vstupní bránou z vyhledávání pro obě skupiny
       zvlášť, takže opakování je tu záměrné a lepší než odkaz jinam. -->
  <section class="py-10 lg:py-14">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.skupiny_headline}</h2>
      <p class="max-w-3xl text-charcoal-500 text-sm mb-7">{data.skupiny_intro}</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        {[
          { s: data.skupina_bezne, tmavy: false },
          { s: data.skupina_zranitelne, tmavy: true },
        ].map(({ s, tmavy }) => (
          <div class:list={["rounded-2xl p-6 lg:p-7 border",
                            tmavy ? "bg-navy-700 border-navy-700 text-white" : "bg-white border-gray-200"]}>
            <div class="flex items-center gap-3">
              <div class:list={["w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0",
                                tmavy ? "bg-brand-500" : "bg-navy-700"]}>
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {tmavy
                    ? <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    : <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>}
                </svg>
              </div>
              <div>
                <h3 class:list={["font-extrabold text-lg", tmavy ? "text-white" : "text-charcoal-900"]}>{s.title}</h3>
                <p class:list={["text-xs", tmavy ? "text-white/70" : "text-charcoal-500"]}>{s.subtitle}</p>
              </div>
            </div>

            <p class:list={["text-sm leading-relaxed mt-4", tmavy ? "text-white/90" : "text-charcoal-600"]}>{s.lead}</p>

            <div class:list={["text-xs font-bold uppercase tracking-wider mt-6 mb-1",
                              tmavy ? "text-white/60" : "text-charcoal-500"]}>{s.castky_title}</div>
            <div class="space-y-0">
              {s.castky.map(c => (
                <div class:list={["flex justify-between gap-4 py-2.5 border-b last:border-0",
                                  tmavy ? "border-navy-600" : "border-gray-100"]}>
                  <span class:list={["text-sm", tmavy ? "text-white/80" : "text-charcoal-600"]}>{c.label}</span>
                  <span class:list={["text-sm font-bold flex-shrink-0", tmavy ? "text-white" : "text-charcoal-900"]}>{c.value}</span>
                </div>
              ))}
            </div>

            <div class:list={["text-xs font-bold uppercase tracking-wider mt-7 mb-3",
                              tmavy ? "text-white/60" : "text-charcoal-500"]}>{s.podminky_title}</div>
            <ul class="space-y-2.5">
              {s.podminky.map(p => (
                <li class="flex gap-2.5 items-start">
                  <span class:list={["w-4 h-4 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5",
                                     tmavy ? "bg-brand-500" : "bg-brand-500"]}>
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </span>
                  <span class:list={["text-sm leading-relaxed", tmavy ? "text-white/90" : "text-charcoal-600"]} set:html={p} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 max-w-3xl rounded-xl border border-gray-200 bg-white p-5 sm:p-6">
        <p class="text-charcoal-700 leading-relaxed">
          <strong class="text-charcoal-900">Nevíte, do které skupiny patříte?</strong> Zjistíme to za vás v rámci nabídky a řekneme rovnou, kolik si můžete odečíst. S žádostí i s renovačním pasem pak pomůžeme.
        </p>
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <a href="/poptavka" data-place="dotace-po-castkach"
             class="inline-flex items-center justify-center px-5 py-3 bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold rounded-lg transition-colors">
            Zjistit, na co mám nárok
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <span class="text-sm text-charcoal-500">
            nebo zavolejte
            <a href={site.phone_href} data-place="dotace-po-castkach" class="font-bold text-navy-700 hover:text-brand-500 transition-colors whitespace-nowrap">{site.phone}</a>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Renovační pas - má id, protože se na něj odkazuje z míst, kde se
       o pasu mluví. Clarity ukázala, že tam lidé klikali naprázdno.
       scroll-mt kompenzuje lepivou hlavičku, jinak by nadpis zmizel pod ní. -->
  <section id="renovacni-pas" class="scroll-mt-20 lg:scroll-mt-28 bg-gray-50 py-10 lg:py-14">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.renovacni_headline}</h2>
      <p class="text-charcoal-500 text-sm mb-5">{data.renovacni_intro}</p>

      <div class="space-y-3">
        {data.renovacni_body.map(item => (
          <div class="flex gap-2.5 items-start">
            <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <span class="max-w-3xl text-charcoal-600 text-sm leading-relaxed" set:html={item} />
          </div>
        ))}
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mt-6">
        <div class="flex gap-2.5">
          <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-sm text-amber-800 leading-relaxed">{data.tip_box}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ sekce -->
  <section class="py-10 lg:py-14">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-3">{data.faq_headline}</h2>
      <p class="text-charcoal-500 mb-8 max-w-2xl">Rozklikněte otázku, která vás zajímá.</p>
      <div class="max-w-4xl space-y-3">
        {data.faq.map((item: any, i: number) => (
          <details open={i === 0} id={item.id ? `faq-${item.id}` : undefined} class="group scroll-mt-28 bg-white border border-gray-200 rounded-xl open:border-brand-200 open:shadow-sm transition-colors">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none px-6 py-4 font-bold text-charcoal-900 marker:hidden [&::-webkit-details-marker]:hidden hover:text-brand-500 transition-colors">
              {item.q}
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 group-open:bg-brand-50 flex items-center justify-center transition-colors mt-0.5">
                <svg class="w-4 h-4 text-charcoal-500 group-open:text-brand-500 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <p class="px-6 pb-5 -mt-1 max-w-3xl text-charcoal-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>

  <script>
    // Odkazy z podmínek vedou na konkrétní dotaz. Zavřený <details> se sám
    // neotevře ve všech prohlížečích, proto ho otevřeme a odrolujeme pod hlavičku.
    function otevriDotaz(plynule: boolean) {
      if (!location.hash.startsWith('#faq-')) return;
      const cil = document.querySelector<HTMLDetailsElement>(location.hash);
      if (!cil) return;
      cil.open = true;
      const hlavicka = document.getElementById('header');
      const odsazeni = (hlavicka ? hlavicka.offsetHeight : 0) + 16;
      const y = cil.getBoundingClientRect().top + window.scrollY - odsazeni;
      const bezAnimace = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: Math.max(0, y), behavior: plynule && !bezAnimace ? 'smooth' : 'auto' });
    }
    window.addEventListener('hashchange', () => otevriDotaz(true));
    otevriDotaz(false);
  </script>
</Layout>
