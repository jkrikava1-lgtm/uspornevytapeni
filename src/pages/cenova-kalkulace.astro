---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/cenova-kalkulace.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Cenová kalkulace', href: '/cenova-kalkulace' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">

      <!-- Progress bar -->
      <div id="progress-wrap" class="mb-10">
        <div class="flex items-center justify-between text-xs text-charcoal-400 mb-2">
          <span id="progress-label" data-template={data.progress_template}>{data.progress_template.replace('{n}', '1').replace('{total}', '6')}</span>
          <span id="progress-pct">17 %</span>
        </div>
        <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
          <div id="progress-fill" class="h-full bg-brand-500 rounded-full transition-all duration-500" style="width:17%"></div>
        </div>
      </div>

      <!-- STEP 1 -->
      <div id="step-1" class="step-panel">
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.step1_title}</h2>
        <p class="text-charcoal-500 text-sm mb-8">{data.step1_desc}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <button class="choice-card" data-field="typ_objektu" data-value="Novostavba">
            <span class="choice-icon"><img src="/images/ikony/novostavba.webp" alt="Ikona novostavby" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step1_opt1_label}</span>
            <span class="choice-desc">{data.step1_opt1_desc}</span>
          </button>
          <button class="choice-card" data-field="typ_objektu" data-value="Stávající dům">
            <span class="choice-icon"><img src="/images/ikony/stavajici-dum.webp" alt="Ikona stávajícího domu" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step1_opt2_label}</span>
            <span class="choice-desc">{data.step1_opt2_desc}</span>
          </button>
        </div>
      </div>

      <!-- STEP 2 -->
      <div id="step-2" class="step-panel hidden">
        <button class="back-btn" data-target="1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> {data.back_button}</button>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2 mt-4">{data.step2_title}</h2>
        <p class="text-charcoal-500 text-sm mb-8">{data.step2_desc}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <button class="choice-card" data-field="ohrev_tuv" data-value="Ano">
            <span class="choice-icon"><img src="/images/ikony/desuperheater.webp" alt="Ikona ohřevu teplé vody" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step2_opt1_label}</span>
            <span class="choice-desc">{data.step2_opt1_desc}</span>
          </button>
          <button class="choice-card" data-field="ohrev_tuv" data-value="Ne">
            <span class="choice-icon relative"><img src="/images/ikony/desuperheater.webp" alt="Bez ohřevu teplé vody" class="w-10 h-10 object-contain opacity-40" /><div class="absolute inset-0 flex items-center justify-center"><div class="w-10 h-0.5 bg-red-500 rotate-45 rounded-full"></div></div></span>
            <span class="choice-label">{data.step2_opt2_label}</span>
            <span class="choice-desc">{data.step2_opt2_desc}</span>
          </button>
        </div>
      </div>

      <!-- STEP 3 -->
      <div id="step-3" class="step-panel hidden">
        <button class="back-btn" data-target="2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> {data.back_button}</button>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2 mt-4">{data.step3_title}</h2>
        <p class="text-charcoal-500 text-sm mb-8">{data.step3_desc}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <button class="choice-card" data-field="topny_system" data-value="Podlahové topení">
            <span class="choice-icon"><img src="/images/ikony/podlahove-topeni.webp" alt="Ikona podlahového topení" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step3_opt1_label}</span>
          </button>
          <button class="choice-card" data-field="topny_system" data-value="Radiátory">
            <span class="choice-icon"><img src="/images/ikony/radiatory.webp" alt="Ikona radiátorů" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step3_opt2_label}</span>
          </button>
          <button class="choice-card" data-field="topny_system" data-value="Více topných okruhů">
            <span class="choice-icon"><img src="/images/ikony/kombinace-okruhu.webp" alt="Ikona kombinace topných okruhů" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step3_opt3_label}</span>
          </button>
        </div>
      </div>

      <!-- STEP 4 -->
      <div id="step-4" class="step-panel hidden">
        <button class="back-btn" data-target="3"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> {data.back_button}</button>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2 mt-4">{data.step4_title}</h2>
        <p class="text-charcoal-500 text-sm mb-8">{data.step4_desc}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <button class="choice-card" data-field="typ_tc" data-value="Vzduch–voda">
            <span class="choice-icon"><img src="/images/ikony/vzduch-voda.webp" alt="Ikona tepelného čerpadla vzduch-voda" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step4_opt1_label}</span>
            <span class="choice-desc">{data.step4_opt1_desc}</span>
          </button>
          <button class="choice-card" data-field="typ_tc" data-value="Voda–voda">
            <span class="choice-icon"><img src="/images/ikony/voda-voda.webp" alt="Ikona tepelného čerpadla voda-voda" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step4_opt2_label}</span>
            <span class="choice-desc">{data.step4_opt2_desc}</span>
          </button>
          <button class="choice-card" data-field="typ_tc" data-value="Země–voda, vrt">
            <span class="choice-icon"><img src="/images/ikony/vrt.webp" alt="Ikona vrtu" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step4_opt3_label}</span>
            <span class="choice-desc">{data.step4_opt3_desc}</span>
          </button>
          <button class="choice-card" data-field="typ_tc" data-value="Země–voda, plošný kolektor">
            <span class="choice-icon"><img src="/images/ikony/plosny-kolektor.webp" alt="Ikona plošného kolektoru" class="w-14 h-14 object-contain" /></span>
            <span class="choice-label">{data.step4_opt4_label}</span>
            <span class="choice-desc">{data.step4_opt4_desc}</span>
          </button>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <button class="choice-card--help" data-field="typ_tc" data-value="Nevím">
            <span class="w-9 h-9 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center flex-shrink-0 text-amber-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
            <span class="text-left">
              <span class="choice-label block">{data.step4_help_label}</span>
              <span class="choice-desc">{data.step4_help_desc}</span>
            </span>
            <svg class="w-4 h-4 text-gray-300 ml-auto flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- STEP 5 -->
      <div id="step-5" class="step-panel hidden">
        <button class="back-btn" data-target="4"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> {data.back_button}</button>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2 mt-4">{data.step5_title}</h2>
        <p class="text-charcoal-500 text-sm mb-8">{data.step5_desc}</p>
        <div class="space-y-8">
          <div>
            <div class="flex items-center justify-between mb-3">
              <label class="text-sm font-semibold text-charcoal-800">{data.step5_ztrata_label}</label>
              <label id="nevis-toggle" for="ztrata-nevis" style="display:inline-flex;align-items:center;gap:0.375rem;padding:0.25rem 0.75rem;border-radius:9999px;border:2px solid #e5e7eb;font-size:0.8125rem;font-weight:500;color:#6b7280;cursor:pointer;transition:all 150ms;user-select:none;">
                <input type="checkbox" id="ztrata-nevis" class="sr-only" />
                <svg style="width:0.875rem;height:0.875rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {data.step5_nevis_label}
              </label>
            </div>
            <div id="ztrata-wrap" class="space-y-2">
              <div class="flex items-center gap-4">
                <input type="range" id="ztrata-slider" min="2" max="30" value="10" step="1" class="flex-1 accent-brand-500 cursor-pointer" />
                <div class="w-20 text-right">
                  <span id="ztrata-val" class="text-2xl font-extrabold text-brand-500">10</span>
                  <span class="text-sm text-charcoal-400 ml-1">kW</span>
                </div>
              </div>
              <div class="flex justify-between text-xs text-charcoal-400"><span>2 kW</span><span>30 kW</span></div>
            </div>
          </div>
          <div id="plocha-wrap" class="hidden">
            <label class="block text-sm font-semibold text-charcoal-800 mb-3">{data.step5_plocha_label}</label>
            <div class="flex items-center gap-3">
              <input type="number" id="plocha-input" min="20" max="2000" placeholder="150" class="w-32 px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors text-center text-lg font-bold" />
              <span class="text-charcoal-500 font-medium">m²</span>
            </div>
          </div>
        </div>
        <button id="btn-step5" class="mt-10 inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors w-full sm:w-auto">
          {data.step5_continue}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </button>
      </div>

      <!-- STEP 6 -->
      <div id="step-6" class="step-panel hidden">
        <button class="back-btn" data-target="5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> {data.back_button}</button>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2 mt-4">{data.step6_title}</h2>
        <p class="text-charcoal-500 text-sm mb-8">{data.step6_desc}</p>
        <div class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.step6_label_jmeno}</label>
              <input type="text" id="f-jmeno" required placeholder={data.step6_placeholder_jmeno} class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.step6_label_telefon}</label>
              <input type="tel" id="f-telefon" required placeholder={data.step6_placeholder_telefon} class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.step6_label_email}</label>
            <input type="email" id="f-email" required placeholder={data.step6_placeholder_email} class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.step6_label_obec}</label>
            <input type="text" id="f-obec" required placeholder={data.step6_placeholder_obec} class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
          </div>
          <div class="flex items-start gap-3 pt-2">
            <input type="checkbox" id="f-souhlas" class="mt-1 w-4 h-4 accent-brand-500 flex-shrink-0" />
            <label for="f-souhlas" class="text-xs text-charcoal-500 leading-relaxed cursor-pointer">{data.step6_souhlas}</label>
          </div>
        </div>
        <div id="form-error" class="hidden mt-4 p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-700"
          data-error-required={data.error_required}
          data-error-send={data.error_send}
          data-submit-loading={data.submit_loading}
          data-submit-label={data.submit_button}
        ></div>
        <button id="btn-submit" class="mt-8 inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors w-full sm:w-auto">
          <span id="btn-submit-label">{data.submit_button}</span>
          <svg id="btn-submit-icon" class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          <svg id="btn-submit-spin" class="hidden w-4 h-4 ml-2 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/></svg>
        </button>
      </div>

      <!-- SUCCESS -->
      <div id="step-success" class="step-panel hidden text-center py-8">
        <div class="w-16 h-16 bg-brand-50 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.success_title}</h2>
        <p class="text-charcoal-500 mb-8 max-w-sm mx-auto">{data.success_text}</p>
        <a href="/" class="inline-flex items-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-charcoal-700 font-semibold rounded-md transition-colors text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> {data.success_back}
        </a>
      </div>

    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .choice-card {
    @apply flex flex-col items-center text-center gap-3 p-6 rounded-xl border-2 border-gray-200 bg-white hover:border-brand-400 hover:bg-brand-50 transition-all duration-150 cursor-pointer;
  }
  .choice-card.selected { @apply border-brand-500 bg-brand-50; }
  .choice-icon { @apply w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center text-charcoal-500; }
  .choice-card.selected .choice-icon { @apply bg-brand-100 text-brand-600; }
  .choice-label { @apply font-bold text-charcoal-900 text-sm; }
  .choice-desc { @apply text-xs text-charcoal-400 leading-snug; }
  .back-btn { @apply inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-charcoal-600 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors cursor-pointer border border-gray-200 hover:border-gray-300; }
  .choice-card--help { width:100%; display:flex; flex-direction:row; align-items:center; gap:1rem; padding:1rem 1.25rem; border-radius:0.75rem; border:2px dashed #fde68a; background-color:rgba(255,251,235,0.5); transition:all 150ms; cursor:pointer; text-align:left; }
  .choice-card--help:hover { border-color:#f59e0b; background-color:#fffbeb; }
  .choice-card--help.selected { border-color:#f59e0b; background-color:#fffbeb; }
</style>

<script>
  const answers: Record<string, string> = {};
  let currentStep = 1;
  const TOTAL_STEPS = 6;

  function showStep(n: number) {
    document.querySelectorAll('.step-panel').forEach(el => el.classList.add('hidden'));
    const el = document.getElementById(`step-${n}`);
    if (el) el.classList.remove('hidden');
    if (n <= TOTAL_STEPS) {
      const pct = Math.round((n / TOTAL_STEPS) * 100);
      (document.getElementById('progress-fill') as HTMLElement).style.width = pct + '%';
      const tpl = (document.getElementById('progress-label') as HTMLElement).dataset.template || '';
      (document.getElementById('progress-label') as HTMLElement).textContent = tpl.replace('{n}', String(n)).replace('{total}', String(TOTAL_STEPS));
      (document.getElementById('progress-pct') as HTMLElement).textContent = pct + ' %';
      document.getElementById('progress-wrap')!.classList.remove('hidden');
    } else {
      document.getElementById('progress-wrap')!.classList.add('hidden');
    }
    currentStep = n;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLButtonElement>('.choice-card, .choice-card--help').forEach(card => {
    card.addEventListener('click', () => {
      const field = card.dataset.field!;
      const value = card.dataset.value!;
      answers[field] = value;
      card.closest('.step-panel')!.querySelectorAll('.choice-card, .choice-card--help').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      if (field === 'typ_tc' && value === 'Nevím') {
        setTimeout(() => { window.location.href = '/poptavka'; }, 260);
        return;
      }
      setTimeout(() => showStep(currentStep + 1), 260);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.back-btn').forEach(btn => {
    btn.addEventListener('click', () => showStep(Number(btn.dataset.target)));
  });

  const slider = document.getElementById('ztrata-slider') as HTMLInputElement;
  const ztrataVal = document.getElementById('ztrata-val')!;
  slider?.addEventListener('input', () => { ztrataVal.textContent = slider.value; });

  const ztrataNevis = document.getElementById('ztrata-nevis') as HTMLInputElement;
  const ztrataWrap = document.getElementById('ztrata-wrap')!;
  const plochWrap = document.getElementById('plocha-wrap')!;
  const nevisToggle = document.getElementById('nevis-toggle') as HTMLElement;
  const updateNevisToggle = () => {
    if (ztrataNevis.checked) {
      nevisToggle.style.borderColor = '#f59e0b'; nevisToggle.style.color = '#b45309'; nevisToggle.style.backgroundColor = '#fffbeb';
    } else {
      nevisToggle.style.borderColor = '#e5e7eb'; nevisToggle.style.color = '#6b7280'; nevisToggle.style.backgroundColor = '';
    }
  };
  ztrataNevis?.addEventListener('change', () => {
    ztrataWrap.classList.toggle('hidden', ztrataNevis.checked);
    plochWrap.classList.toggle('hidden', !ztrataNevis.checked);
    updateNevisToggle();
  });

  document.getElementById('btn-step5')?.addEventListener('click', () => {
    if (ztrataNevis.checked) {
      const plocha = (document.getElementById('plocha-input') as HTMLInputElement).value;
      if (!plocha) { (document.getElementById('plocha-input') as HTMLInputElement).focus(); return; }
      answers['plocha'] = plocha + ' m²';
    }
    answers['tepelna_ztrata'] = ztrataNevis.checked ? 'Nevím' : slider.value + ' kW';
    showStep(6);
  });

  document.getElementById('btn-submit')?.addEventListener('click', async () => {
    const jmeno = (document.getElementById('f-jmeno') as HTMLInputElement).value.trim();
    const email = (document.getElementById('f-email') as HTMLInputElement).value.trim();
    const telefon = (document.getElementById('f-telefon') as HTMLInputElement).value.trim();
    const obec = (document.getElementById('f-obec') as HTMLInputElement).value.trim();
    const souhlas = (document.getElementById('f-souhlas') as HTMLInputElement).checked;
    const errorEl = document.getElementById('form-error')!;
    errorEl.classList.add('hidden');
    if (!jmeno || !email || !telefon || !obec) {
      errorEl.textContent = errorEl.dataset.errorRequired || '';
      errorEl.classList.remove('hidden');
      return;
    }
    const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
    const labelEl = document.getElementById('btn-submit-label')!;
    const iconEl = document.getElementById('btn-submit-icon')!;
    const spinEl = document.getElementById('btn-submit-spin')!;
    submitBtn.disabled = true;
    labelEl.textContent = errorEl.dataset.submitLoading || '';
    iconEl.classList.add('hidden');
    spinEl.classList.remove('hidden');
    try {
      const res = await fetch('/api/kalkulace/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...answers, jmeno, email, telefon, obec, souhlas_obchodni: souhlas }) });
      if (!res.ok) throw new Error('server error');
      showStep(99);
      document.getElementById('step-success')!.classList.remove('hidden');
    } catch {
      errorEl.textContent = errorEl.dataset.errorSend || '';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      labelEl.textContent = errorEl.dataset.submitLabel || '';
      iconEl.classList.remove('hidden');
      spinEl.classList.add('hidden');
    }
  });
</script>
