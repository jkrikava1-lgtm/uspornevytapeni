---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ref from '../data/reference.json';
---

<Layout title={ref.meta_title} description={ref.meta_description}>
  <PageHero
    title={ref.hero_title}
    subtitle={ref.hero_subtitle}
    breadcrumb={[{ label: 'Reference', href: '/reference' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14">
        {[
          { num: ref.stat1_num, label: ref.stat1_label },
          { num: ref.stat2_num, label: ref.stat2_label },
          { num: ref.stat3_num, label: ref.stat3_label },
          { num: ref.stat4_num, label: ref.stat4_label },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
            <div class="text-3xl font-extrabold text-navy-700">{item.num}</div>
            <div class="text-xs text-charcoal-500 mt-1">{item.label}</div>
          </div>
        ))}
      </div>

      <!-- Reference grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ref.references.map((item) => (
          <div
            class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow cursor-pointer js-gallery-card"
            data-title={`${item.lokalita} — ${item.system}`}
            data-gallery={JSON.stringify(item.gallery)}
          >
            <div class="relative">
              <img src={item.image} alt={`Instalace ${item.system} — ${item.lokalita}`} class="h-56 w-full object-cover" loading="lazy" />
              <div class="absolute bottom-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded-md flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                {item.gallery.length}
              </div>
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-brand-500 uppercase tracking-wider">{item.lokalita}</span>
                <span class="text-xs text-charcoal-400">{item.rok}</span>
              </div>
              <h3 class="font-bold text-charcoal-900 text-sm mb-0.5">{item.typ}</h3>
              <div class="text-xs text-navy-700 font-semibold">{item.system}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa realizací -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"/>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"/>
  <section class="pb-16 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{ref.map_headline}</h2>
        <p class="text-charcoal-500">{ref.map_subtitle}</p>
      </div>
      <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
        <div style="background:#1B3A5C;color:white;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <div style="font-size:0.82rem;display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
            <strong>{ref.map_legend_label}</strong>
            <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:50%;background:#C41E2A;border:2px solid white;display:inline-block;"></span>{ref.map_legend_vzduch}</span>
            <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:50%;background:#27AE60;border:2px solid white;display:inline-block;"></span>{ref.map_legend_zeme}</span>
            <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:50%;background:#1464a0;border:2px solid white;display:inline-block;"></span>{ref.map_legend_voda}</span>
          </div>
          <div style="display:flex;gap:16px;text-align:right;">
            <div><div style="font-size:1.3rem;font-weight:700;line-height:1;">{ref.map_stat1_num}</div><div style="font-size:0.65rem;opacity:0.6;text-transform:uppercase;letter-spacing:0.05em;">{ref.map_stat1_label}</div></div>
            <div><div style="font-size:1.3rem;font-weight:700;line-height:1;">{ref.map_stat2_num}</div><div style="font-size:0.65rem;opacity:0.6;text-transform:uppercase;letter-spacing:0.05em;">{ref.map_stat2_label}</div></div>
          </div>
        </div>
        <div id="ref-map" style="height:520px;width:100%;"></div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{ref.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{ref.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">
        {ref.cta_button}
      </a>
    </div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script is:inline>
    (function() {
      fetch('/data/cities.json').then(function(r){return r.json()}).then(function(CITIES){
        var map = L.map('ref-map', { center: [50.0, 15.5], zoom: 8, scrollWheelZoom: false });
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution: '\u00a9 OpenStreetMap \u00a9 CartoDB', maxZoom: 19
        }).addTo(map);
        var cluster = L.markerClusterGroup({
          maxClusterRadius: 45,
          iconCreateFunction: function(c) {
            var n = c.getChildCount(), s = n<5?32:n<20?40:50;
            return L.divIcon({
              html: '<div style="background:#1B3A5C;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3);width:'+s+'px;height:'+s+'px;font-size:'+(n<10?13:11)+'px">'+n+'</div>',
              className: '', iconSize: [s,s], iconAnchor: [s/2,s/2]
            });
          }
        });
        function clr(d) {
          var m = Math.max(d.vzduch, d.zeme, d.voda);
          return d.vzduch===m ? '#C41E2A' : d.zeme===m ? '#27AE60' : '#1464a0';
        }
        function pop(d) {
          var b = [];
          if (d.vzduch>0) b.push('<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:0.74rem;font-weight:600;background:#fad7d3;color:#7b1a1a">vzduch\u2013voda: '+d.vzduch+'\u00d7</span>');
          if (d.zeme>0) b.push('<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:0.74rem;font-weight:600;background:#d5f5e3;color:#1a6b3a">zem\u011b\u2013voda: '+d.zeme+'\u00d7</span>');
          if (d.voda>0) b.push('<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:0.74rem;font-weight:600;background:#cce3f5;color:#0d4a7a">voda\u2013voda: '+d.voda+'\u00d7</span>');
          return '<div style="font-weight:700;font-size:1rem;color:#1a2e12;margin-bottom:6px">'+d.city+'</div>'+
            '<div style="font-size:0.82rem;color:#555;margin:2px 0">\ud83d\udce6 Instalac\u00ed: <strong>'+d.count+'</strong></div>'+
            '<div style="margin-top:7px;display:flex;flex-wrap:wrap;gap:4px">'+b.join('')+'</div>';
        }
        CITIES.forEach(function(d) {
          var r = d.count===1?7:d.count<=3?9:d.count<=7?12:16;
          var m = L.circleMarker([d.lat, d.lng], {
            radius:r, fillColor:clr(d), color:'white', weight:2, opacity:1, fillOpacity:0.87
          });
          m.bindPopup(pop(d), {maxWidth:270});
          cluster.addLayer(m);
        });
        map.addLayer(cluster);
        map.on('click', function() { map.scrollWheelZoom.enable(); });
      });
    })();
  </script>

  <!-- Lightbox overlay -->
  <div id="lb" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.92);">
    <div style="position:absolute; top:0; left:0; right:0; display:flex; align-items:center; justify-content:space-between; padding:12px 16px; color:#fff;">
      <div>
        <span id="lb-title" style="font-weight:700; font-size:14px;"></span>
        <span id="lb-counter" style="opacity:0.6; font-size:14px; margin-left:8px;"></span>
      </div>
      <button id="lb-close" style="background:none; border:none; color:#fff; font-size:28px; cursor:pointer; padding:4px 8px;">&times;</button>
    </div>
    <div style="position:absolute; top:50px; bottom:90px; left:0; right:0; display:flex; align-items:center; justify-content:center;">
      <button id="lb-prev" style="position:absolute; left:8px; background:rgba(255,255,255,0.15); border:none; color:#fff; font-size:24px; cursor:pointer; width:44px; height:44px; border-radius:50%;">&#8249;</button>
      <img id="lb-img" src="" alt="" style="max-height:100%; max-width:calc(100% - 100px); object-fit:contain; border-radius:8px;" />
      <button id="lb-next" style="position:absolute; right:8px; background:rgba(255,255,255,0.15); border:none; color:#fff; font-size:24px; cursor:pointer; width:44px; height:44px; border-radius:50%;">&#8250;</button>
    </div>
    <div id="lb-thumbs" style="position:absolute; bottom:0; left:0; right:0; display:flex; gap:6px; justify-content:center; padding:12px; overflow-x:auto;"></div>
  </div>

  <script is:inline>
    (function() {
      var lb = document.getElementById('lb');
      var img = document.getElementById('lb-img');
      var title = document.getElementById('lb-title');
      var counter = document.getElementById('lb-counter');
      var thumbs = document.getElementById('lb-thumbs');
      var gallery = [];
      var idx = 0;

      function show(i) {
        idx = i;
        img.src = gallery[i];
        counter.textContent = (i + 1) + ' / ' + gallery.length;
        var ts = thumbs.querySelectorAll('img');
        for (var j = 0; j < ts.length; j++) {
          ts[j].style.opacity = j === i ? '1' : '0.4';
          ts[j].style.borderColor = j === i ? '#fff' : 'transparent';
        }
      }

      function open(card) {
        gallery = JSON.parse(card.dataset.gallery);
        title.textContent = card.dataset.title;
        thumbs.innerHTML = '';
        for (var i = 0; i < gallery.length; i++) {
          var t = document.createElement('img');
          t.src = gallery[i];
          t.style.cssText = 'width:60px;height:44px;object-fit:cover;border-radius:4px;cursor:pointer;border:2px solid transparent;';
          t.dataset.i = i;
          t.addEventListener('click', function(e) {
            e.stopPropagation();
            show(parseInt(this.dataset.i));
          });
          thumbs.appendChild(t);
        }
        show(0);
        lb.style.display = 'block';
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lb.style.display = 'none';
        document.body.style.overflow = '';
      }

      // Card clicks
      var cards = document.querySelectorAll('.js-gallery-card');
      for (var c = 0; c < cards.length; c++) {
        cards[c].addEventListener('click', function() { open(this); });
      }

      // Navigation
      document.getElementById('lb-close').addEventListener('click', function(e) { e.stopPropagation(); close(); });
      document.getElementById('lb-prev').addEventListener('click', function(e) { e.stopPropagation(); show((idx - 1 + gallery.length) % gallery.length); });
      document.getElementById('lb-next').addEventListener('click', function(e) { e.stopPropagation(); show((idx + 1) % gallery.length); });

      // Close on background click
      lb.addEventListener('click', function(e) {
        if (e.target === lb) close();
      });

      // Keyboard
      document.addEventListener('keydown', function(e) {
        if (lb.style.display === 'none') return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show((idx - 1 + gallery.length) % gallery.length);
        if (e.key === 'ArrowRight') show((idx + 1) % gallery.length);
      });
    })();
  </script>
</Layout>
