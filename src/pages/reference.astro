---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ref from '../data/reference.json';
---

<Layout title={ref.meta_title} description={ref.meta_description}>
  <PageHero
    title={ref.hero_title}
    subtitle={ref.hero_subtitle}
    breadcrumb={[{ label: 'Reference', href: '/reference' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14">
        {[
          { num: ref.stat1_num, label: ref.stat1_label },
          { num: ref.stat2_num, label: ref.stat2_label },
          { num: ref.stat3_num, label: ref.stat3_label },
          { num: ref.stat4_num, label: ref.stat4_label },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
            <div class="text-3xl font-extrabold text-navy-700">{item.num}</div>
            <div class="text-xs text-charcoal-500 mt-1">{item.label}</div>
          </div>
        ))}
      </div>

      <!-- Reference grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ref.references.map((item, idx) => (
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow cursor-pointer" data-gallery-trigger={idx}>
            <div class="relative">
              <img src={item.image} alt={`Instalace ${item.system} — ${item.lokalita}`} class="h-56 w-full object-cover" loading="lazy" />
              <div class="absolute bottom-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded-md flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                {item.gallery.length}
              </div>
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-brand-500 uppercase tracking-wider">{item.lokalita}</span>
                <span class="text-xs text-charcoal-400">{item.rok}</span>
              </div>
              <h3 class="font-bold text-charcoal-900 text-sm mb-0.5">{item.typ}</h3>
              <div class="text-xs text-navy-700 font-semibold">{item.system}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa realizací -->
  <section class="pb-16 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{ref.map_headline}</h2>
        <p class="text-charcoal-500">{ref.map_subtitle}</p>
      </div>
      <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1IsvhYr_QxHViLa4fSGC-nyo_iN4&hl=cs&ll=50.1575730464532%2C15.42214604453126&z=8"
          width="100%"
          height="520"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa realizací tepelných čerpadel"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{ref.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{ref.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">
        {ref.cta_button}
      </a>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/90" id="lightbox-backdrop"></div>
    <div class="relative z-10 flex flex-col h-full">
      <!-- Header -->
      <div class="flex items-center justify-between px-4 py-3 text-white">
        <div>
          <span id="lb-title" class="font-bold text-sm"></span>
          <span id="lb-counter" class="text-white/60 text-sm ml-2"></span>
        </div>
        <button id="lb-close" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <!-- Image -->
      <div class="flex-1 flex items-center justify-center px-12 pb-4 relative">
        <button id="lb-prev" class="absolute left-2 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <img id="lb-image" src="" alt="" class="max-h-full max-w-full object-contain rounded-lg" />
        <button id="lb-next" class="absolute right-2 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <!-- Thumbnails -->
      <div class="px-4 pb-4">
        <div id="lb-thumbs" class="flex gap-2 justify-center overflow-x-auto py-2"></div>
      </div>
    </div>
  </div>

  <script define:vars={{ references: ref.references }}>
    const lightbox = document.getElementById('lightbox');
    const lbImage = document.getElementById('lb-image');
    const lbTitle = document.getElementById('lb-title');
    const lbCounter = document.getElementById('lb-counter');
    const lbThumbs = document.getElementById('lb-thumbs');
    let currentGallery = [];
    let currentIndex = 0;

    function openLightbox(refIdx, imgIdx = 0) {
      const ref = references[refIdx];
      currentGallery = ref.gallery;
      lbTitle.textContent = ref.lokalita + ' — ' + ref.system;
      showImage(imgIdx);
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // Build thumbnails
      lbThumbs.innerHTML = '';
      currentGallery.forEach((src, i) => {
        const thumb = document.createElement('img');
        thumb.src = src;
        thumb.alt = '';
        thumb.className = 'w-16 h-12 object-cover rounded cursor-pointer border-2 transition-all ' +
          (i === imgIdx ? 'border-white opacity-100' : 'border-transparent opacity-50 hover:opacity-80');
        thumb.addEventListener('click', () => showImage(i));
        lbThumbs.appendChild(thumb);
      });
    }

    function showImage(idx) {
      currentIndex = idx;
      lbImage.src = currentGallery[idx];
      lbCounter.textContent = (idx + 1) + ' / ' + currentGallery.length;

      // Update thumb highlights
      const thumbs = lbThumbs.querySelectorAll('img');
      thumbs.forEach((t, i) => {
        if (i === idx) {
          t.className = t.className.replace('border-transparent opacity-50 hover:opacity-80', 'border-white opacity-100');
        } else {
          t.className = t.className.replace('border-white opacity-100', 'border-transparent opacity-50 hover:opacity-80');
        }
      });
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Event listeners
    document.querySelectorAll('[data-gallery-trigger]').forEach(card => {
      card.addEventListener('click', () => {
        openLightbox(parseInt(card.dataset.galleryTrigger));
      });
    });

    document.getElementById('lb-close').addEventListener('click', closeLightbox);
    document.getElementById('lb-backdrop').addEventListener('click', closeLightbox);
    document.getElementById('lb-prev').addEventListener('click', () => {
      showImage((currentIndex - 1 + currentGallery.length) % currentGallery.length);
    });
    document.getElementById('lb-next').addEventListener('click', () => {
      showImage((currentIndex + 1) % currentGallery.length);
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showImage((currentIndex - 1 + currentGallery.length) % currentGallery.length);
      if (e.key === 'ArrowRight') showImage((currentIndex + 1) % currentGallery.length);
    });
  </script>
</Layout>
