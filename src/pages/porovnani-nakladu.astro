---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/porovnani-nakladu.json';

const maxChart = Math.max(...data.chart_items.map(i => i.value));

// Sazba za kWh dodaného tepla u každého zdroje. Počítá se z hodnot grafu,
// takže kalkulačka a tabulka si nikdy nemůžou odporovat.
const sazby = data.chart_items.map(i => ({
  label: i.label,
  value: i.value,
  sazba: i.value / data.potreba_referencni,
}));
const vychoziZdroj = data.chart_items.findIndex(i => /plyn/i.test(i.label));
const hodnotaTC = data.chart_items.find(i => /tepelné čerpadlo/i.test(i.label))?.value ?? 0;
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Porovnání nákladů', href: '/porovnani-nakladu' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Vizuální srovnání -->
      <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-16">
        <h2 class="text-xl font-extrabold text-charcoal-900 mb-2">{data.kalkulacka_title}</h2>
        <p class="text-sm text-charcoal-500 leading-relaxed mb-5 max-w-3xl">{data.kalkulacka_lead}</p>

        <div class="mb-8 rounded-xl border border-gray-200 bg-gray-50 p-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="kalk-zdroj" class="block text-xs font-bold uppercase tracking-wider text-charcoal-500 mb-1.5">{data.kalkulacka_label_zdroj}</label>
              <select id="kalk-zdroj" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-charcoal-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30">
                {data.chart_items.map((item, i) => (
                  <option value={i} selected={i === vychoziZdroj}>{item.label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="kalk-castka" class="block text-xs font-bold uppercase tracking-wider text-charcoal-500 mb-1.5">{data.kalkulacka_label_castka}</label>
              <div class="relative">
                <input id="kalk-castka" type="number" inputmode="numeric" min="1000" max="500000" step="1000"
                       value={data.chart_items[vychoziZdroj]?.value}
                       class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 pr-14 text-charcoal-900 tabular-nums focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" />
                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-charcoal-500">Kč</span>
              </div>
            </div>
          </div>
          <p id="kalk-shrnuti" aria-live="polite" class="mt-4 text-sm leading-relaxed text-charcoal-700"></p>
          <p class="mt-3 text-xs leading-relaxed text-charcoal-500">{data.kalkulacka_pozn}</p>
        </div>

        <h2 class="text-xl font-extrabold text-charcoal-900 mb-8">{data.chart_headline}</h2>
        <div class="space-y-6">
          {data.chart_items.map((item, i) => (
            <div data-radek={i} data-sazba={(item.value / data.potreba_referencni).toFixed(6)}
                 class={`rounded-xl p-5 ${item.highlight ? 'bg-brand-50 border-2 border-brand-500' : 'bg-gray-50 border border-gray-200'}`}>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <span class="text-sm font-bold text-charcoal-900">{item.label}</span>
                  {item.highlight && <span class="mt-1 block text-xs font-bold leading-snug text-brand-600 sm:mt-0 sm:ml-2 sm:inline">{data.highlight_badge}</span>}
                  <div class="text-xs text-charcoal-500 mt-0.5">{item.poznamka}</div>
                </div>
                <div class="text-right">
                  <span data-castka class={`text-lg font-extrabold ${item.highlight ? 'text-brand-600' : 'text-charcoal-800'}`}>{item.value.toLocaleString('cs-CZ')} Kč/rok</span>
                  {item.uspory && (
                    <div data-uspora data-uspora-text={item.uspory} class="text-xs font-semibold text-brand-600 mt-0.5">
                      {item.value > hodnotaTC ? `${data.savings_prefix} ${item.uspory}` : item.uspory}
                    </div>
                  )}
                </div>
              </div>
              <div class="h-3 bg-gray-100 rounded-full overflow-hidden">
                <div data-pruh class={`h-3 ${item.color} rounded-full transition-all`} style={`width:${Math.round(item.value/maxChart*100)}%`}></div>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-6 border-t border-gray-100 pt-4 text-xs leading-relaxed text-charcoal-500">{data.note_text}</p>
      </div>

      <!-- Faktory -->
      <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200">
        <h3 class="text-xl font-extrabold text-charcoal-900 mb-4">{data.factors_headline}</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { title: data.factor1_title, desc: data.factor1_desc },
            { title: data.factor2_title, desc: data.factor2_desc },
            { title: data.factor3_title, desc: data.factor3_desc },
            { title: data.factor4_title, desc: data.factor4_desc },
          ].map(item => (
            <div class="flex gap-3">
              <svg class="w-4 h-4 text-brand-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              <div>
                <span class="font-semibold text-charcoal-900 text-sm">{item.title}: </span>
                <span class="text-sm text-charcoal-500">{item.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
        <a href="/cena" class="inline-flex items-center justify-center px-6 py-3.5 border-2 border-gray-200 hover:border-gray-400 text-charcoal-700 font-semibold rounded-md transition-colors">Kolik stojí tepelné čerpadlo</a>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Kolik stojí vytápění plynem oproti tepelnému čerpadlu ročně?", "acceptedAnswer": { "@type": "Answer", "text": "Pro průměrný rodinný dům s tepelnou ztrátou 13 kW jsou roční náklady na vytápění a ohřev vody plynem přibližně 71 000 Kč, tepelným čerpadlem vzduch-voda přibližně 39 000 Kč. Výpočty vycházejí z dat TZB-info (listopad 2026)." } },
      { "@type": "Question", "name": "Jaká je roční úspora při přechodu z plynu na tepelné čerpadlo?", "acceptedAnswer": { "@type": "Answer", "text": "Při přechodu z plynového kotle na tepelné čerpadlo vzduch-voda ušetříte přibližně 23 000 Kč ročně (pro dům s tepelnou ztrátou 13 kW). Přesná úspora závisí na zateplení domu, způsobu vytápění a aktuálních cenách energií." } },
      { "@type": "Question", "name": "Jaká je návratnost investice do tepelného čerpadla?", "acceptedAnswer": { "@type": "Answer", "text": "Návratnost tepelného čerpadla je typicky 5-8 let po odečtení dotace z NZÚ 2026. Po celou dobu životnosti (20-25 let) platíte pouze za elektřinu - bez fixních poplatků za plyn a bez závislosti na cenách fosilních paliv." } },
      { "@type": "Question", "name": "Jak velký vliv má zateplení domu na náklady na vytápění?", "acceptedAnswer": { "@type": "Answer", "text": "Lépe zateplený dům má nižší tepelnou ztrátu a potřebuje méně tepla - to snižuje náklady u všech zdrojů vytápění. Zateplení a tepelné čerpadlo se vzájemně doplňují: čerpadlo pracuje efektivněji při nižších topných teplotách, které zateplený dům umožňuje." } }
    ]
  })} />

  <script is:inline define:vars={{ potrebaRef: data.potreba_referencni, prefixUspory: data.savings_prefix }}>
    (function () {
      var zdroj = document.getElementById('kalk-zdroj');
      var castka = document.getElementById('kalk-castka');
      var shrnuti = document.getElementById('kalk-shrnuti');
      if (!zdroj || !castka || !shrnuti) return;

      var radky = Array.prototype.slice.call(document.querySelectorAll('[data-radek]'));
      var sazby = radky.map(function (r) { return parseFloat(r.getAttribute('data-sazba')); });
      // index tepelného čerpadla = nejlevnější zdroj, který nabízíme
      var iTC = radky.findIndex(function (r) { return /tepelné čerpadlo/i.test(r.textContent || ''); });

      var cislo = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 0 });

      function prepocti() {
        var i = parseInt(zdroj.value, 10);
        var zaplaceno = parseFloat(castka.value);
        if (!(zaplaceno > 0) || !sazby[i]) { shrnuti.textContent = ''; return; }

        // Kolik tepla dům potřebuje: zaplacená částka dělená sazbou zvoleného zdroje.
        var potreba = zaplaceno / sazby[i];
        var castky = sazby.map(function (s) { return s * potreba; });
        var max = Math.max.apply(null, castky);

        radky.forEach(function (r, n) {
          var c = r.querySelector('[data-castka]');
          var p = r.querySelector('[data-pruh]');
          var u = r.querySelector('[data-uspora]');
          if (c) c.textContent = cislo.format(Math.round(castky[n] / 1000) * 1000) + ' Kč/rok';
          if (p) p.style.width = Math.round(castky[n] / max * 100) + '%';
          if (u) {
            var rozdil = castky[n] - castky[iTC];
            // U zdrojů levnějších než čerpadlo nemá „úspora" smysl - vrátíme
            // původní poznámku z dat místo toho, aby řádek zůstal prázdný.
            u.textContent = rozdil > 0
              ? prefixUspory + ' ~' + cislo.format(Math.round(rozdil / 1000) * 1000) + ' Kč/rok'
              : (u.getAttribute('data-uspora-text') || '');
          }
        });

        var uspora = castky[i] - castky[iTC];
        var kwh = cislo.format(Math.round(potreba / 100) * 100);
        if (i === iTC) {
          shrnuti.textContent = 'Při takové částce potřebuje váš dům zhruba ' + kwh +
            ' kWh tepla za rok. Tepelné čerpadlo už máte, takže jste na nejnižších nákladech ze všech zdrojů.';
        } else if (uspora > 0) {
          shrnuti.textContent = 'Při takové částce potřebuje váš dům zhruba ' + kwh +
            ' kWh tepla za rok. S tepelným čerpadlem byste za totéž teplo zaplatili asi ' +
            cislo.format(Math.round(castky[iTC] / 1000) * 1000) + ' Kč, tedy o ' +
            cislo.format(Math.round(uspora / 1000) * 1000) + ' Kč ročně méně.';
        } else {
          shrnuti.textContent = 'Při takové částce potřebuje váš dům zhruba ' + kwh +
            ' kWh tepla za rok. Váš současný zdroj vychází levněji než tepelné čerpadlo - ' +
            'bývá to případ dřeva, kde se ovšem nepočítá vaše práce.';
        }
      }

      zdroj.addEventListener('change', function () {
        // při přepnutí zdroje nabídneme typickou částku pro ten zdroj
        var i = parseInt(zdroj.value, 10);
        castka.value = Math.round(sazby[i] * potrebaRef / 1000) * 1000;
        prepocti();
      });
      castka.addEventListener('input', prepocti);
      prepocti();
    })();
  </script>
</Layout>
