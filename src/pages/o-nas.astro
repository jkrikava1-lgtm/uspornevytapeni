---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/o-nas.json';
import site from '../data/site.json';
---

<Layout title={data.meta_title} description={data.meta_description} breadcrumbs={[{ label: 'O nás', href: '/o-nas' }]}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'O nás', href: '/o-nas' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="space-y-6">
          <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.philosophy_label}</div>
          <h2 class="text-3xl font-extrabold text-charcoal-900 mb-6" set:html={data.philosophy_headline}></h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>{data.philosophy_text1}</p>
            <p>{data.philosophy_text2}</p>
            <p>{data.philosophy_text3}</p>
          </div>

          <div class="bg-navy-700 rounded-xl p-6 text-white">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold text-sm">JS</div>
              <div>
                <blockquote class="text-sm text-navy-100 leading-relaxed italic mb-3">
                  "{data.testimonial_quote}"
                </blockquote>
                <div class="text-sm font-semibold text-white">{data.testimonial_name}</div>
                <div class="text-xs text-navy-100">{data.testimonial_company}</div>
              </div>
            </div>
          </div>

          <div class="flex items-stretch gap-4 bg-gray-50 rounded-xl overflow-hidden border border-gray-200 cursor-pointer hover:shadow-md hover:border-brand-200 transition-all group" data-lightbox-img>
            <img src="/images/znacka-kvality.webp" alt="Značka kvality AVTČ" class="w-28 object-cover flex-shrink-0" />
            <div class="py-4 pr-4 flex flex-col justify-center">
              <div class="text-sm font-bold text-charcoal-900">Značka kvality AVTČ</div>
              <p class="text-xs text-charcoal-500 leading-relaxed">Jsme členy Asociace pro využití tepelných čerpadel a nositeli Značky kvality.</p>
              <span class="text-xs text-brand-500 font-semibold mt-2 flex items-center gap-1 group-hover:gap-2 transition-all">Zobrazit detail <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg></span>
            </div>
          </div>

          <div id="onas-lightbox" class="fixed inset-0 z-50 bg-black/70 flex items-center justify-center hidden cursor-pointer">
            <img id="onas-lightbox-img" src="" alt="" class="max-w-2xl max-h-[80vh] rounded-2xl shadow-2xl object-contain" />
          </div>
          <script>
            document.querySelector('[data-lightbox-img]')?.addEventListener('click', () => {
              const lb = document.getElementById('onas-lightbox');
              document.getElementById('onas-lightbox-img').src = '/images/znacka-kvality.webp';
              lb.classList.remove('hidden');
            });
            document.getElementById('onas-lightbox')?.addEventListener('click', (e) => {
              e.currentTarget.classList.add('hidden');
            });
          </script>
        </div>

        <div class="space-y-4">
          <img src="/images/ilustrace/o-nas.webp" alt="Technik Master Therm u tepelného čerpadla" class="rounded-xl w-full object-cover" loading="lazy" />

          <div class="grid grid-cols-2 gap-4">
            {[
              { num: data.stat1_num, label: data.stat1_label },
              { num: data.stat2_num, label: data.stat2_label },
              { num: data.stat3_num, label: data.stat3_label },
              { num: data.stat4_num, label: data.stat4_label },
            ].map(item => (
              <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
                <div class="text-3xl font-extrabold text-navy-700 mb-1">{item.num}</div>
                <div class="text-xs text-charcoal-500">{item.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-10 text-center">{data.process_headline}</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {[
          { num: data.step1_num, title: data.step1_title, desc: data.step1_desc },
          { num: data.step2_num, title: data.step2_title, desc: data.step2_desc },
          { num: data.step3_num, title: data.step3_title, desc: data.step3_desc },
          { num: data.step4_num, title: data.step4_title, desc: data.step4_desc },
        ].map(item => (
          <div class="bg-white rounded-xl p-7 border border-gray-200">
            <div class="text-4xl font-extrabold text-brand-100 mb-4">{item.num}</div>
            <h3 class="font-bold text-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-charcoal-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-4">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
        <a href={site.phone_href} class="inline-flex items-center justify-center px-6 py-3.5 border-2 border-gray-200 hover:border-gray-400 text-charcoal-700 font-semibold rounded-md transition-colors">{site.phone}</a>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Úsporné vytápění s.r.o.",
    "url": "https://uspornevytapeni.cz",
    "foundingDate": "2006",
    "description": "Specialisté na tepelná čerpadla a úsporné vytápění. Autorizovaný partner Master Therm, nositelé Značky kvality AVTČ. Od roku 2006.",
    "telephone": "+420777724573",
    "email": "info@uspornevytapeni.cz",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Dělnická 395",
      "addressLocality": "Jičín",
      "postalCode": "506 01",
      "addressCountry": "CZ"
    },
    "memberOf": {
      "@type": "Organization",
      "name": "Asociace pro využití tepelných čerpadel (AVTČ)"
    },
    "award": "Značka kvality AVTČ",
    "knowsAbout": ["tepelná čerpadla vzduch-voda", "tepelná čerpadla země-voda", "tepelná čerpadla voda-voda", "úsporné vytápění", "Nová zelená úsporám", "Master Therm"],
    "employee": [
      {
        "@type": "Person",
        "name": "Jakub Křikava",
        "jobTitle": "Obchod a technická podpora",
        "telephone": "+420777724573",
        "email": "j.krikava@uspornevytapeni.cz"
      },
      {
        "@type": "Person",
        "name": "Ing. Jana Křikavová",
        "jobTitle": "Ekonom"
      }
    ],
    "sameAs": ["https://share.google/66F7YjcrxXkEXskH6", "https://www.firmy.cz/detail/2538489-usporne-vytapeni-s-r-o-tepelna-cerpadla-jicin-valdicke-predmesti.html"]
  })} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jakub Křikava",
    "jobTitle": "Specialista na tepelná čerpadla",
    "worksFor": {
      "@type": "Organization",
      "name": "Úsporné vytápění s.r.o.",
      "url": "https://uspornevytapeni.cz"
    },
    "telephone": "+420777724573",
    "email": "j.krikava@uspornevytapeni.cz",
    "knowsAbout": ["tepelná čerpadla vzduch-voda", "tepelná čerpadla země-voda", "tepelná čerpadla voda-voda", "úsporné vytápění", "Nová zelená úsporám"]
  })} />
</Layout>
