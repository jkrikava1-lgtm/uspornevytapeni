---
import Layout from '../layouts/Layout.astro';
import mt from '../data/mastertherm.json';
import ref from '../data/reference.json';
import poptavka from '../data/poptavka.json';
import site from '../data/site.json';

// Ikony karet — klíč z mastertherm.json → SVG path
const icons: Record<string, string> = {
  factory: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  temp: 'M9.5 14.5V4a2.5 2.5 0 015 0v10.5a5 5 0 11-5 0z',
  wave: 'M3 12h2.5l2-6 3 12 3-9 2 3H21',
  check: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  wrench: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
  ruler: 'M9 7h6m-6 4h6m-6 4h4M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z',
  pin: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
};
---

<Layout title={mt.meta_title} description={mt.meta_description} simpleNav={true} ctaHref="#poptavka">

  <!-- ═══ HERO ═══ -->
  <section class="relative bg-navy-700 text-white overflow-hidden pt-16 lg:pt-[72px]">
    <div class="absolute inset-0 opacity-5">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="mt-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#mt-grid)" />
      </svg>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div>
          <div class="inline-flex items-start gap-2.5 bg-navy-600 text-navy-100 text-sm font-semibold px-4 py-2.5 rounded-xl sm:rounded-full mb-6">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full flex-shrink-0 mt-2"></span>
            {mt.hero_badge}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-4">
            {mt.hero_h1}<br>
            <span class="text-brand-300">{mt.hero_h1_sub}</span>
          </h1>
          <p class="text-lg text-navy-100 leading-relaxed mb-8 max-w-xl">
            {mt.hero_text}
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#poptavka" class="inline-flex items-center justify-center px-7 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-md transition-colors text-base">
              {mt.hero_cta_primary}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/cenova-kalkulace" class="inline-flex items-center justify-center px-7 py-4 border border-navy-500 hover:border-navy-300 text-navy-100 hover:text-white font-semibold rounded-md transition-colors text-base">
              {mt.hero_cta_secondary}
            </a>
          </div>

          <p class="mt-6 text-base text-navy-100">
            {mt.hero_phone_note}
            <a href={site.phone_href} class="font-extrabold text-white text-lg hover:text-brand-300 transition-colors whitespace-nowrap ml-1">{site.phone}</a>
          </p>

          <!-- Mikro-důvěra: klíčové argumenty ještě nad ohybem -->
          <div class="mt-7 flex flex-wrap gap-2.5">
            {mt.hero_chips.map(chip => (
              <span class="inline-flex items-center gap-2 text-sm font-semibold bg-white/10 border border-white/20 text-white/90 rounded-lg px-3 py-2">
                <svg class="w-3.5 h-3.5 text-brand-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
                {chip}
              </span>
            ))}
          </div>
        </div>

        <div class="relative">
          <img src={mt.hero_image} alt={mt.hero_image_alt} width="720" height="540" fetchpriority="high"
            class="w-full h-64 sm:h-80 lg:h-[440px] object-cover rounded-2xl shadow-2xl" />
          <div class="absolute top-4 left-4 inline-flex items-center gap-2 bg-black/50 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full">
            <svg class="w-3.5 h-3.5 text-brand-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Naše realizace
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PÁS DŮVĚRY ═══ -->
  <section class="bg-navy-900 py-7">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {mt.trust.map(item => (
          <div>
            <div class="text-2xl lg:text-3xl font-extrabold text-white">{item.num}</div>
            <div class="text-sm text-navy-200 mt-1">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PROČ MASTER THERM / PROČ OD NÁS ═══ -->
  <section class="py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-4">{mt.why_headline}</h2>
      <p class="text-lg text-charcoal-500 leading-relaxed max-w-3xl">{mt.why_intro}</p>

      <div class="text-brand-500 text-sm font-bold uppercase tracking-wider mt-12 mb-5">{mt.why_brand_label}</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {mt.why_brand_cards.map(card => (
          <div class="bg-gray-50 rounded-xl p-7 border border-gray-200">
            <div class="w-11 h-11 bg-navy-700 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[card.icon]}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 mb-2">{card.title}</h3>
            <p class="text-[15px] text-charcoal-500 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-brand-500 text-sm font-bold uppercase tracking-wider mt-12 mb-5">{mt.why_us_label}</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {mt.why_us_cards.map(card => (
          <div class="bg-gray-50 rounded-xl p-7 border border-gray-200">
            <div class="w-11 h-11 bg-brand-500 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[card.icon]}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 mb-2">{card.title}</h3>
            <p class="text-[15px] text-charcoal-500 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ REKONSTRUKCE — hlavní use-case návštěvníků ═══ -->
  <section class="bg-navy-700 py-14 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4">{mt.rekon_headline}</h2>
          <p class="text-lg text-navy-100 leading-relaxed mb-7">{mt.rekon_text}</p>
          <ul class="space-y-4 mb-9">
            {mt.rekon_items.map(item => (
              <li class="flex gap-3.5">
                <span class="w-6 h-6 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </span>
                <span class="text-base text-navy-100 leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
          <a href="#poptavka" class="inline-flex items-center justify-center px-7 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-md transition-colors">
            {mt.rekon_cta}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <div class="bg-white/8 border border-white/10 rounded-2xl p-10 text-center">
          <div class="text-6xl lg:text-7xl font-extrabold text-white leading-none mb-4">{mt.rekon_big_num}</div>
          <div class="text-base text-navy-100 max-w-xs mx-auto leading-relaxed">{mt.rekon_big_label}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CENA + FINANCOVÁNÍ ═══ -->
  <section class="py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-brand-500 text-sm font-bold uppercase tracking-wider mb-3">{mt.cena_label}</div>
      <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-4">{mt.cena_headline}</h2>
      <p class="text-lg text-charcoal-500 mb-8">{mt.cena_lead}</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {mt.cena_cards.map(card => (
          <div class="border border-gray-200 rounded-xl p-7 text-center">
            <h3 class="font-bold text-charcoal-900 mb-2">{card.typ}</h3>
            <div class="text-2xl font-extrabold text-navy-700 mb-2">{card.cena}</div>
            <p class="text-[15px] text-charcoal-500 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-sm text-charcoal-400 mt-5">{mt.cena_note}</p>

      <h3 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mt-14 mb-6">{mt.fin_headline}</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {mt.fin_cards.map(card => (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-8">
            <h4 class="font-bold text-charcoal-900 mb-2">{card.title}</h4>
            <div class="text-3xl font-extrabold text-navy-700 mb-3">{card.big}</div>
            <p class="text-[15px] text-charcoal-500 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-base text-charcoal-500 mt-6 leading-relaxed">
        {mt.fin_note}
        <a href="/dotace" class="text-brand-500 font-semibold hover:text-brand-600 transition-colors whitespace-nowrap ml-1">{mt.fin_link} →</a>
      </p>
    </div>
  </section>

  <!-- ═══ CENOVÁ KALKULAČKA ═══ -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-3">{mt.calc_headline}</h2>
          <p class="text-lg text-charcoal-500 leading-relaxed">{mt.calc_text}</p>
        </div>
        <a href="/cenova-kalkulace" class="flex-shrink-0 inline-flex items-center justify-center px-7 py-4 bg-navy-700 hover:bg-navy-800 text-white font-bold rounded-md transition-colors">
          {mt.calc_cta}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ REFERENCE + MAPA REALIZACÍ ═══ -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"/>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"/>
  <section class="py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-4">{mt.ref_headline}</h2>
      <p class="text-lg text-charcoal-500 leading-relaxed max-w-3xl mb-8">{mt.ref_lead}</p>

      <!-- Mapa realizací — stejná komponenta jako na /reference -->
      <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm mb-10">
        <div style="background:#1B3A5C;color:white;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <div style="font-size:0.82rem;display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
            <strong>{ref.map_legend_label}</strong>
            <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:50%;background:#C41E2A;border:2px solid white;display:inline-block;"></span>{ref.map_legend_vzduch}</span>
            <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:50%;background:#27AE60;border:2px solid white;display:inline-block;"></span>{ref.map_legend_zeme}</span>
            <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:50%;background:#1464a0;border:2px solid white;display:inline-block;"></span>{ref.map_legend_voda}</span>
          </div>
          <div style="display:flex;gap:16px;text-align:right;">
            <div><div style="font-size:1.3rem;font-weight:700;line-height:1;">{ref.map_stat1_num}</div><div style="font-size:0.65rem;opacity:0.6;text-transform:uppercase;letter-spacing:0.05em;">{ref.map_stat1_label}</div></div>
            <div><div style="font-size:1.3rem;font-weight:700;line-height:1;">{ref.map_stat2_num}</div><div style="font-size:0.65rem;opacity:0.6;text-transform:uppercase;letter-spacing:0.05em;">{ref.map_stat2_label}</div></div>
          </div>
        </div>
        <div id="mt-map" style="height:480px;width:100%;"></div>
      </div>

      <!-- Vybrané realizace -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {mt.ref_items.map(item => (
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <img src={item.image} alt={`Instalace ${item.system} — ${item.lokalita}`} class="h-52 w-full object-cover" loading="lazy" width="480" height="320" />
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-brand-500 uppercase tracking-wider">{item.lokalita}</span>
                <span class="text-xs text-charcoal-400">{item.rok}</span>
              </div>
              <h3 class="font-bold text-charcoal-900 text-[15px] mb-0.5">{item.typ}</h3>
              <div class="text-sm text-navy-700 font-semibold">{item.system}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Citace zákazníka -->
      <div class="bg-gray-50 rounded-2xl p-8 lg:p-10 flex flex-col sm:flex-row items-center gap-7 mb-6">
        <img src={mt.quote_image} alt={mt.quote_name} class="w-36 sm:w-44 rounded-xl object-cover object-top flex-shrink-0 self-stretch" loading="lazy" />
        <div>
          <blockquote class="text-base lg:text-lg text-charcoal-600 leading-relaxed mb-4">
            „{mt.quote_text}"
          </blockquote>
          <div class="font-bold text-charcoal-900">{mt.quote_name}</div>
          <div class="text-sm text-charcoal-500">{mt.quote_location}</div>
        </div>
      </div>

      <!-- Hodnocení Google -->
      <div class="border border-gray-200 rounded-xl px-7 py-5 flex flex-wrap items-center gap-x-6 gap-y-3">
        <span class="text-3xl font-extrabold text-navy-700">{mt.gmb_score}</span>
        <span class="text-xl tracking-[0.15em] text-amber-500" aria-label={`Hodnocení ${mt.gmb_score} z 5`}>★★★★★</span>
        <span class="text-[15px] text-charcoal-500 leading-relaxed flex-1 min-w-[240px]">{mt.gmb_text}</span>
        <a href={mt.gmb_href} target="_blank" rel="noopener" class="text-[15px] font-bold text-navy-700 hover:text-brand-500 transition-colors whitespace-nowrap">
          {mt.gmb_cta} →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ FVE + TUV ═══ -->
  <section class="pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-l-4 border-navy-700 bg-gray-50 rounded-r-xl px-7 py-6 max-w-4xl">
        <p class="text-base text-charcoal-600 leading-relaxed [&_strong]:text-charcoal-900 [&_a]:text-brand-500 [&_a]:font-semibold hover:[&_a]:text-brand-600" set:html={mt.fve_text}></p>
      </div>
    </div>
  </section>

  <!-- ═══ JAK TO PROBÍHÁ ═══ -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-9">{mt.steps_headline}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {mt.steps.map((step, i) => (
          <div class="bg-white rounded-xl p-7 border border-gray-200">
            <div class="w-10 h-10 bg-brand-500 rounded-full flex items-center justify-center text-white font-extrabold mb-5">{i + 1}</div>
            <h3 class="font-bold text-charcoal-900 mb-2">{step.title}</h3>
            <p class="text-[15px] text-charcoal-500 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-9">{mt.faq_headline}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {mt.faq.map(item => (
          <details class="group bg-white border border-gray-200 rounded-xl px-6 py-5 open:border-gray-300">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-bold text-charcoal-900 text-base marker:hidden [&::-webkit-details-marker]:hidden">
              {item.q}
              <svg class="w-5 h-5 text-brand-500 flex-shrink-0 mt-0.5 transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <p class="text-[15px] text-charcoal-500 leading-relaxed mt-3">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ B2B LIŠTA ═══ -->
  <section class="bg-navy-900 py-9">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <p class="text-base text-navy-100 leading-relaxed max-w-3xl [&_strong]:text-white [&_strong]:font-bold" set:html={mt.b2b_text}></p>
        <div class="flex flex-wrap items-center gap-5 flex-shrink-0">
          <a href="/navrh-reseni/velky-vykon" class="text-sm font-semibold text-navy-100 hover:text-white underline underline-offset-4 transition-colors">{mt.b2b_link}</a>
          <a href="#poptavka" class="inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-md transition-colors">{mt.b2b_cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ POPTÁVKOVÝ FORMULÁŘ ═══ -->
  <section id="poptavka" class="bg-gray-50 py-14 scroll-mt-16 lg:scroll-mt-[72px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-charcoal-900 mb-4">{mt.form_headline}</h2>
      <p class="text-lg text-charcoal-500 leading-relaxed max-w-2xl mb-9">{mt.form_lead}</p>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2">
          <div id="mt-form-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-8 text-center">
            <svg class="w-12 h-12 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h3 class="text-xl font-bold text-charcoal-900 mb-1">{poptavka.success_title}</h3>
            <p class="text-base text-charcoal-600">{poptavka.success_text}</p>
          </div>
          <div id="mt-form-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-4 text-sm text-red-700">
            {poptavka.error_text}
          </div>

          <form id="mt-poptavka-form" class="bg-white border border-gray-200 rounded-2xl p-7 lg:p-9 space-y-6" method="POST" action="/api/poptavka">
            <!-- Honeypot proti botům -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_loaded" id="mt-loaded" value="" />
            <input type="hidden" name="zdroj" value="Master Therm (PPC landing page)" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="mt-jmeno" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_jmeno}</label>
                <input id="mt-jmeno" type="text" name="jmeno" required autocomplete="name" placeholder={poptavka.placeholder_jmeno} class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
              </div>
              <div>
                <label for="mt-telefon" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_telefon}</label>
                <input id="mt-telefon" type="tel" name="telefon" required autocomplete="tel" placeholder={poptavka.placeholder_telefon} class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="mt-email" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_email}</label>
                <input id="mt-email" type="email" name="email" required autocomplete="email" placeholder={poptavka.placeholder_email} class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
              </div>
              <div>
                <label for="mt-obec" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_obec}</label>
                <input id="mt-obec" type="text" name="obec" required autocomplete="address-level2" placeholder={poptavka.placeholder_obec} class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="mt-objekt" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_objekt}</label>
                <select id="mt-objekt" name="objekt" class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors text-charcoal-700">
                  <option value="">{poptavka.placeholder_objekt}</option>
                  {poptavka.options_objekt.map(opt => (<option>{opt}</option>))}
                </select>
              </div>
              <div>
                <label for="mt-vytapeni" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_vytapeni}</label>
                <select id="mt-vytapeni" name="vytapeni" class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors text-charcoal-700">
                  <option value="">{poptavka.placeholder_vytapeni}</option>
                  {poptavka.options_vytapeni.map(opt => (<option>{opt}</option>))}
                </select>
              </div>
            </div>

            <div>
              <label for="mt-zprava" class="block text-sm font-semibold text-charcoal-800 mb-2">{poptavka.label_zprava}</label>
              <textarea id="mt-zprava" name="zprava" rows="4" placeholder={poptavka.placeholder_zprava} class="w-full px-4 py-3.5 border border-gray-300 rounded-md text-base focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors resize-none"></textarea>
            </div>

            <div>
              <label for="mt-priloha" class="block text-sm font-semibold text-charcoal-800 mb-2">Příloha <span class="font-normal text-charcoal-400">(nepovinné)</span></label>
              <input id="mt-priloha" type="file" name="priloha" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" class="w-full text-sm text-charcoal-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-charcoal-700 hover:file:bg-gray-200 file:cursor-pointer file:transition-colors" />
              <p class="text-xs text-charcoal-400 mt-1">Max. 5 MB — PDF, obrázky, dokumenty</p>
            </div>

            <div class="flex items-start gap-3">
              <input type="checkbox" name="souhlas" id="mt-souhlas" required class="mt-1 w-4 h-4 accent-brand-500 flex-shrink-0" />
              <label for="mt-souhlas" class="text-xs text-charcoal-500 leading-relaxed">{poptavka.souhlas_text}</label>
            </div>

            <button type="submit" data-label={poptavka.submit_button} data-loading={poptavka.submit_loading} class="w-full sm:w-auto inline-flex items-center justify-center px-9 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-md transition-colors text-base">
              {poptavka.submit_button}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Osobní kontakt vedle formuláře -->
        <div class="space-y-6">
          <div class="bg-white rounded-xl p-7 border border-gray-200">
            <p class="text-[15px] text-charcoal-500 leading-relaxed mb-5">{mt.contact_who}</p>
            <div class="flex items-center gap-4 mb-5 pb-5 border-b border-gray-200">
              <img src={mt.contact_image} alt={mt.contact_name} class="w-16 h-16 rounded-full object-cover flex-shrink-0" loading="lazy" />
              <div>
                <div class="font-bold text-charcoal-900 text-lg">{mt.contact_name}</div>
                <div class="text-xs text-charcoal-500">{mt.contact_role}</div>
              </div>
            </div>
            <a href={site.phone_href} class="flex items-center gap-3 text-2xl font-extrabold text-navy-700 hover:text-brand-500 transition-colors mb-4">
              <svg class="w-5 h-5 text-brand-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {site.phone}
            </a>
            <p class="text-[15px] text-charcoal-500 leading-relaxed">{mt.contact_note}</p>
          </div>

          <div class="bg-navy-700 rounded-xl p-7 text-white">
            <div class="text-brand-300 text-xs font-bold uppercase tracking-wider mb-4">{poptavka.sidebar_why_label}</div>
            <ul class="space-y-3 text-[15px] text-navy-100">
              {poptavka.sidebar_why_items.map(item => (
                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-brand-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky lišta „Zavolat" — jen mobil -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-brand-500 lg:hidden">
    <a href={site.phone_href} class="flex items-center justify-center gap-2.5 py-3.5 text-white font-bold text-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      {mt.sticky_call}
    </a>
  </div>
  <div class="h-14 lg:hidden" aria-hidden="true"></div>

  <!-- FAQ schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": mt.faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />

  <!-- Mapa realizací -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script is:inline>
    (function() {
      fetch('/data/cities.json').then(function(r){return r.json()}).then(function(CITIES){
        var map = L.map('mt-map', { center: [50.0, 15.5], zoom: 8, scrollWheelZoom: false });
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution: '© OpenStreetMap © CartoDB', maxZoom: 19
        }).addTo(map);
        var cluster = L.markerClusterGroup({
          maxClusterRadius: 45,
          iconCreateFunction: function(c) {
            var n = c.getChildCount(), s = n<5?32:n<20?40:50;
            return L.divIcon({
              html: '<div style="background:#1B3A5C;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3);width:'+s+'px;height:'+s+'px;font-size:'+(n<10?13:11)+'px">'+n+'</div>',
              className: '', iconSize: [s,s], iconAnchor: [s/2,s/2]
            });
          }
        });
        function clr(d) {
          var m = Math.max(d.vzduch, d.zeme, d.voda);
          return d.vzduch===m ? '#C41E2A' : d.zeme===m ? '#27AE60' : '#1464a0';
        }
        function pop(d) {
          var b = [];
          if (d.vzduch>0) b.push('<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:0.74rem;font-weight:600;background:#fad7d3;color:#7b1a1a">vzduch–voda: '+d.vzduch+'×</span>');
          if (d.zeme>0) b.push('<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:0.74rem;font-weight:600;background:#d5f5e3;color:#1a6b3a">země–voda: '+d.zeme+'×</span>');
          if (d.voda>0) b.push('<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:0.74rem;font-weight:600;background:#cce3f5;color:#0d4a7a">voda–voda: '+d.voda+'×</span>');
          return '<div style="font-weight:700;font-size:1rem;color:#1a2e12;margin-bottom:6px">'+d.city+'</div>'+
            '<div style="font-size:0.82rem;color:#555;margin:2px 0">Instalací: <strong>'+d.count+'</strong></div>'+
            '<div style="margin-top:7px;display:flex;flex-wrap:wrap;gap:4px">'+b.join('')+'</div>';
        }
        CITIES.forEach(function(d) {
          var r = d.count===1?7:d.count<=3?9:d.count<=7?12:16;
          var m = L.circleMarker([d.lat, d.lng], {
            radius:r, fillColor:clr(d), color:'white', weight:2, opacity:1, fillOpacity:0.87
          });
          m.bindPopup(pop(d), {maxWidth:270});
          cluster.addLayer(m);
        });
        map.addLayer(cluster);
      });
    })();
  </script>
</Layout>

<script>
  // Anti-spam: timestamp při načtení (stejná logika jako /poptavka)
  document.getElementById('mt-loaded')?.setAttribute('value', String(Date.now()));

  const form = document.getElementById('mt-poptavka-form') as HTMLFormElement;
  const successBox = document.getElementById('mt-form-success')!;
  const errorBox = document.getElementById('mt-form-error')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = btn.dataset.loading || 'Odesílám…';

    try {
      const formData = new FormData(form);
      const jsonData: Record<string, any> = {};
      formData.forEach((val, key) => { if (key !== 'priloha') jsonData[key] = String(val); });

      const fileInput = document.getElementById('mt-priloha') as HTMLInputElement;
      const file = fileInput?.files?.[0];
      if (file) {
        if (file.size > 5 * 1024 * 1024) {
          errorBox.textContent = 'Soubor je příliš velký (max. 5 MB).';
          errorBox.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = btn.dataset.label || 'Odeslat poptávku';
          return;
        }
        const reader = new FileReader();
        const base64 = await new Promise<string>((resolve) => {
          reader.onload = () => resolve((reader.result as string).split(',')[1]);
          reader.readAsDataURL(file);
        });
        jsonData.priloha = { name: file.name, type: file.type, data: base64 };
      }

      const res = await fetch('/api/poptavka/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(jsonData),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        // Konverzní událost — přesnou definici doplní specifikace měření od DataAds
        (window as any).dataLayer?.push({ event: 'poptavka_odeslana', zdroj: 'mastertherm' });
      } else {
        errorBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = btn.dataset.label || 'Odeslat poptávku';
      }
    } catch {
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Odeslat poptávku';
    }
  });
</script>
