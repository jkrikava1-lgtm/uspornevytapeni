---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/katalog-index.json';
---

<Layout title={data.meta.title} description={data.meta.description}>
  <PageHero
    title={data.hero.title}
    subtitle={data.hero.subtitle}
    breadcrumb={[{ label: data.hero.breadcrumbLabel, href: '/katalog' }]}
  />

  <article class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-charcoal-600 text-sm leading-relaxed max-w-3xl mb-10">Nabízíme tepelná čerpadla Master Therm — český výrobce s vlastní výrobou od roku 1994, roční kapacitou 3 000 čerpadel a exportem do 15+ zemí Evropy. V katalogu najdete kompletní přehled modelů vzduch-voda, země-voda i voda-voda včetně technických parametrů a dokumentace ke stažení.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {data.cards.map(card => (
          <a href={card.href} class="group relative rounded-xl overflow-hidden hover:shadow-xl transition-all">
            <div class={`relative h-44 bg-gradient-to-br from-${card.gradientFrom} to-${card.gradientTo} overflow-hidden`}>
              {card.image && <img src={card.image} alt={card.title} class="absolute inset-0 w-full h-full object-cover opacity-50" loading="lazy" />}
              <div class={`absolute inset-0 bg-gradient-to-r from-${card.overlayColor} via-${card.overlayColor}/60 to-transparent`}></div>
            </div>
            <div class="bg-white border border-gray-200 border-t-0 rounded-b-xl p-6 text-center">
              <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{card.title}</h2>
              <p class="text-sm text-charcoal-500 mb-4">{card.description}</p>
              <span class="text-sm font-semibold text-brand-500 group-hover:text-brand-600">{card.linkText}</span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </article>

  <!-- O Master Therm -->
  <section class="py-12 lg:py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6">Proč Master Therm?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm text-charcoal-600 leading-relaxed">
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Česká výroba, mezinárodní ocenění</h3>
          <p>Master Therm vyrábí tepelná čerpadla v České republice od roku 1994. Výrobní závod v Jablonci nad Jizerou patří k nejmodernějším v celé střední Evropě s roční kapacitou přes 3 000 čerpadel. Výroba v ČR znamená rychlou dostupnost náhradních dílů a servis bez zbytečného čekání.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Inverterová technologie pro nižší spotřebu</h3>
          <p>Všechna čerpadla Master Therm jsou vybavena inverterovým kompresorem, který plynule reguluje výkon podle aktuální potřeby. Na rozdíl od čerpadel s pevným výkonem nespotřebovávají energii navíc a pracují tišeji. Výsledkem je vyšší roční COP a nižší účet za elektřinu.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Certifikace a mezinárodní uznání</h3>
          <p>Všechna čerpadla Master Therm nesou certifikát Heat Pump KEYMARK (evropský standard kvality), jsou certifikována dle ISO 9001:2015 a splňují britský standard BBA MCS. Produkty prošly testováním v nezávislé zkušebně ETI/SZÚ v Brně a jsou certifikovány institutem Kiwa. Více než 70 % produkce míří do 15+ zemí Evropy.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Servis přímo od výrobce</h3>
          <p>Jako autorizovaný partner Master Therm zajišťujeme záruční i pozáruční servis přímo přes výrobce. Technici jsou školeni v továrně a mají přístup k originálním dílům. Katalog zahrnuje přes 60 modelů ve stovkách variant — vždy doporučujeme konkrétní model po konzultaci a výpočtu tepelné ztráty.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Co hledat při výběru modelu?</h3>
          <p>Klíčové parametry jsou topný výkon (kW), topný faktor COP a hlučnost (dB). Výkon by měl odpovídat tepelné ztrátě budovy — tu spočítáme při prohlídce objektu. Nepodceňujte ani zásobník teplé vody: správně dimenzovaný zásobník výrazně snižuje provozní náklady.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta.headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta.text}</p>
      <a href={data.cta.href} class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta.button}</a>
    </div>
  </section>
</Layout>
