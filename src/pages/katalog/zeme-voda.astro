---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/katalog-zeme-voda.json';
---

<Layout title={data.meta.title} description={data.meta.description}>
  <PageHero
    title={data.hero.title}
    subtitle={data.hero.subtitle}
    breadcrumb={data.hero.breadcrumb}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex gap-3 mb-8">
        {data.categoryTabs.map(tab => (
          tab.active
            ? <span class={`inline-flex px-3 py-1 rounded-full text-xs font-semibold ${tab.activeClass}`}>{tab.label}</span>
            : <a href={tab.href} class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-charcoal-500 hover:bg-gray-200 transition-colors">{tab.label}</a>
        ))}
      </div>

      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 mb-12">
        <div class="text-xs text-charcoal-400 font-semibold uppercase tracking-wider mb-3">{data.quickNavLabel}</div>
        <div class="flex flex-wrap gap-3">
          {data.quickNav.map((item, i) => (
            <>
              {i > 0 && <span class="text-gray-300">|</span>}
              <a href={item.anchor} class="text-sm font-semibold text-navy-700 hover:text-brand-500 transition-colors">{item.label}</a>
            </>
          ))}
        </div>
      </div>

      {data.sections.map((section, sIdx) => (
        <div id={section.id} class={`scroll-mt-24 ${sIdx < data.sections.length - 1 ? 'mb-16' : 'mb-8'}`}>
          <!-- Ilustrační banner -->
          <div class={`relative h-48 rounded-2xl overflow-hidden mb-6 bg-gradient-to-br ${section.bannerGradient}`}>
            {section.bannerImage && <img src={section.bannerImage} alt={section.title} class="absolute right-0 top-0 h-full w-1/2 object-contain object-right-bottom opacity-30 lg:opacity-50" loading="lazy" />}
            <div class={`absolute inset-0 bg-gradient-to-r ${section.bannerOverlay} to-transparent`}></div>
            <div class="relative z-10 flex items-center gap-4 p-6 h-full">
              <div class={`w-10 h-10 ${section.numberStyle === 'brand' ? 'bg-brand-500 text-white' : 'bg-white text-green-700'} rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0`}>{section.number}</div>
              <div>
                <h2 class="text-2xl font-extrabold text-white">{section.title}</h2>
                <p class={`${section.subtitleColor} text-sm mt-1`}>{section.subtitle}</p>
              </div>
            </div>
          </div>

          <div class="mb-6 overflow-hidden">
            {section.productImages && (
              <div class="float-left mr-6 mb-4 flex gap-3">
                {section.productImages.map(img => (
                  <img src={img} alt={section.title} class="h-36 lg:h-48 object-contain rounded-xl" loading="lazy" />
                ))}
              </div>
            )}
            <p class="text-charcoal-600 text-sm leading-relaxed mb-4">{section.description}</p>
            <div class="space-y-2">
              {section.features.map(item => (
                <div class="flex gap-2 items-start">
                  <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-charcoal-600 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="w-full text-sm">
              <thead class="bg-navy-700 text-white">
                <tr>
                  <th class="text-left px-5 py-3 font-semibold">{data.tableHeaders.model}</th>
                  <th class="text-left px-5 py-3 font-semibold">{data.tableHeaders.vykon}</th>
                  <th class="text-left px-5 py-3 font-semibold">{data.tableHeaders.cop}</th>
                  <th class="px-5 py-3"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {section.products.map((p, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                    <td class="px-5 py-3 font-bold text-charcoal-900">{p.model}</td>
                    <td class="px-5 py-3 text-charcoal-700">{p.vykon}</td>
                    <td class="px-5 py-3 font-semibold text-navy-700">{p.cop}</td>
                    <td class="px-5 py-3">
                      <a href={p.pdf} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-500 hover:text-brand-600 whitespace-nowrap">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        {data.tableHeaders.pdfLabel}
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {section.footnote && <p class="text-xs text-charcoal-400 mt-2">{section.footnote}</p>}
        </div>
      ))}

      <div class="mt-8">
        <a href={data.moreLink.href} class="text-sm font-semibold text-brand-500 hover:text-brand-600 flex items-center gap-1">
          {data.moreLink.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta.headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta.text}</p>
      <a href={data.cta.href} class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta.button}</a>
    </div>
  </section>
</Layout>
