---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/tepelna-cerpadla-index.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Jaký typ tepelného čerpadla je pro můj dům nejvhodnější?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pro rodinné domy bez velkého pozemku je nejčastější volbou čerpadlo vzduch–voda — instalace trvá 2–3 dny a nevyžaduje zemní práce. Pokud máte zahradní pozemek alespoň 400 m² nebo je možný vrt, doporučujeme zemní čerpadlo pro vyšší efektivitu v zimě. Čerpadlo voda–voda se hodí tam, kde je dostatek podzemní vody. Správný typ vždy doporučujeme po konzultaci a prohlídce objektu."
        }
      },
      {
        "@type": "Question",
        "name": "Funguje tepelné čerpadlo i při velkých mrazech?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Moderní inverterová tepelná čerpadla vzduch–voda fungují spolehlivě až do –20 °C. Zemní čerpadla jsou zcela nezávislá na venkovní teplotě, protože čerpají teplo z hloubky, kde je celoroční teplota kolem 10–12 °C. Všechna naše čerpadla Master Therm mají integrovanou elektrickou dotopovou spirálu pro extrémní mrazy."
        }
      },
      {
        "@type": "Question",
        "name": "Lze tepelné čerpadlo kombinovat se stávajícím kotlem?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ano. Takzvaný bivalentní provoz — kdy čerpadlo pokrývá většinu sezóny a záložní kotel pouze nejstudenější dny — je zcela běžný. Umožňuje levnější investici a rychlou návratnost. Stávající radiátorové otopné soustavy většinou není nutné předělávat, optimalizujeme pouze provozní teplotu."
        }
      },
      {
        "@type": "Question",
        "name": "Kolik stojí tepelné čerpadlo a jaká je návratnost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pořizovací cena včetně instalace se pohybuje od 300 000 do 600 000 Kč podle typu a výkonu. Po odečtení dotace Nová zelená úsporám (která může pokrýt až 50 % nákladů) vychází návratnost investice typicky na 5–8 let. Po celou dobu životnosti (20–25 let) platíte pouze za elektřinu."
        }
      }
    ]
  })} />
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla' }]}
  />

  <article class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-charcoal-600 text-sm leading-relaxed max-w-3xl mb-10">Tepelné čerpadlo je moderní zdroj vytápění, který odebírá energii z okolního prostředí — ze vzduchu, ze země nebo z vody — a přeměňuje ji na teplo pro váš dům. Dodáváme výhradně inverterová tepelná čerpadla Master Therm, českého výrobce s vlastní výrobou od roku 1994. Vyberte typ podle zdroje energie:</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {data.cards.map(card => (
          <a href={card.href} class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-xl transition-all">
            <div class="h-48 bg-gray-50 relative overflow-hidden">
              {card.image ? <img src={card.image} alt={card.title} class="w-full h-full object-cover" loading="lazy" /> : <div class="flex items-center justify-center h-full"><span class="text-5xl">{card.emoji}</span></div>}
            </div>
            <div class="p-6">
              <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{card.title}</h2>
              <p class="text-sm text-charcoal-500 leading-relaxed mb-4">{card.desc}</p>
              <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
                {data.card_link_text}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </article>

  <!-- Srovnávací tabulka typů -->
  <section class="py-12 lg:py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">Porovnání typů tepelných čerpadel</h2>
      <p class="text-charcoal-500 text-sm mb-8">Který typ se hodí pro váš dům?</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="text-left py-3 pr-4 text-charcoal-500 font-medium w-36"></th>
              <th class="text-center py-3 px-3 text-navy-700 font-bold">Vzduch – voda</th>
              <th class="text-center py-3 px-3 text-green-700 font-bold">Země – voda</th>
              <th class="text-center py-3 px-3 text-cyan-700 font-bold">Voda – voda</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {[
              { label: "Cena systému", a: "od 349 000 Kč", b: "od 429 000 Kč", c: "od 379 000 Kč" },
              { label: "COP (účinnost)", a: "~3,3", b: "až 5,0", c: "až 7,0" },
              { label: "Zemní práce", a: "žádné", b: "vrt nebo kolektor", c: "dvě studny" },
              { label: "Hlučnost", a: "mírná (venk. j.)", b: "tichý", c: "tichý" },
              { label: "Funkce v mrazech", a: "do −20 °C", b: "bez omezení", c: "bez omezení" },
              { label: "Pasivní chlazení", a: "ne", b: "ano (téměř zdarma)", c: "ano" },
              { label: "Délka montáže", a: "2–3 dny", b: "5–7 dní", c: "5–7 dní" },
              { label: "Pro koho", a: "95 % domů", b: "pozemek min. 200 m²", c: "dostatek spodní vody" },
            ].map(row => (
              <tr>
                <td class="py-3 pr-4 text-charcoal-500 font-medium">{row.label}</td>
                <td class="py-3 px-3 text-center text-charcoal-700">{row.a}</td>
                <td class="py-3 px-3 text-center text-charcoal-700">{row.b}</td>
                <td class="py-3 px-3 text-center text-charcoal-700">{row.c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-charcoal-400 text-xs mt-4">* COP při podmínkách W10W35 (teplota zdroje 10 °C, výstupní voda 35 °C). Ceny jsou orientační, závisí na výkonu a konkrétním objektu.</p>
    </div>
  </section>

  <!-- Proč tepelné čerpadlo -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6">Proč zvolit tepelné čerpadlo?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm text-charcoal-600 leading-relaxed">
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Nízké provozní náklady</h3>
          <p>Tepelné čerpadlo dokáže z 1 kWh elektrické energie vyrobit 3–5 kWh tepla. To znamená, že za stejnou cenu elektriny vytopíte dům 3× až 5× levněji než přímotopem nebo elektrokotlem. Roční úspora oproti plynovému kotli se pohybuje od 20 000 do 60 000 Kč podle velikosti objektu.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Ekologické vytápění</h3>
          <p>Tepelné čerpadlo využívá obnovitelnou energii z přírody — ze vzduchu, ze země nebo z vody. Nevznikají při něm spaliny ani emise CO₂ přímo v domě. V kombinaci s fotovoltaikou můžete vytápět prakticky zadarmo a s nulovými emisemi.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Chlazení zdarma</h3>
          <p>Moderní tepelná čerpadla umí v létě pracovat v reverzním režimu a dům chladit. Pasivní chlazení u zemních čerpadel téměř nic nestojí — stačí jen cirkulační čerpadlo. Aktivní chlazení vzduch-voda má spotřebu srovnatelnou s běžnou klimatizací.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-2">Dotace a státní podpora</h3>
          <p>Na pořízení tepelného čerpadla lze získat dotaci Nová zelená úsporám nebo kotlíkové dotace kraje. Výše podpory dosahuje 50–80 % z pořizovací ceny v závislosti na příjmu domácnosti a typu čerpadla. Rádi vám pomůžeme s výběrem i podáním žádosti.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 lg:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-8">Nejčastější otázky o tepelných čerpadlech</h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-bold text-charcoal-800 mb-1">Jaký typ tepelného čerpadla je pro můj dům nejvhodnější?</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">Pro rodinné domy bez velkého pozemku je nejčastější volbou čerpadlo vzduch–voda — instalace trvá 2–3 dny a nevyžaduje zemní práce. Pokud máte zahradní pozemek alespoň 400 m² nebo je možný vrt, doporučujeme zemní čerpadlo pro vyšší efektivitu v zimě. Čerpadlo voda–voda se hodí tam, kde je dostatek podzemní vody. Správný typ vždy doporučujeme po konzultaci a prohlídce objektu.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-1">Funguje tepelné čerpadlo i při velkých mrazech?</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">Moderní inverterová tepelná čerpadla vzduch–voda fungují spolehlivě až do –20 °C. Zemní čerpadla jsou zcela nezávislá na venkovní teplotě, protože čerpají teplo z hloubky, kde je celoroční teplota kolem 10–12 °C. Všechna naše čerpadla Master Therm mají integrovanou elektrickou dotopovou spirálu pro extrémní mrazy.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-1">Lze tepelné čerpadlo kombinovat se stávajícím kotlem?</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">Ano. Takzvaný bivalentní provoz — kdy čerpadlo pokrývá většinu sezóny a záložní kotel pouze nejstudenější dny — je zcela běžný. Umožňuje levnější investici a rychlou návratnost. Stávající radiátorové otopné soustavy většinou není nutné předělávat, optimalizujeme pouze provozní teplotu.</p>
        </div>
        <div>
          <h3 class="font-bold text-charcoal-800 mb-1">Kolik stojí tepelné čerpadlo a jaká je návratnost?</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">Pořizovací cena včetně instalace se pohybuje od 300 000 do 600 000 Kč podle typu a výkonu. Po odečtení dotace Nová zelená úsporám (která může pokrýt až 50 % nákladů) vychází návratnost investice typicky na 5–8 let. Po celou dobu životnosti (20–25 let) platíte pouze za elektřinu.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-navy-700 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl font-extrabold text-white">{data.cta_headline}</h3>
        <p class="text-navy-100 text-sm mt-1">{data.cta_text}</p>
      </div>
      <a href="/poptavka" class="flex-shrink-0 inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm">
        {data.cta_button}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
