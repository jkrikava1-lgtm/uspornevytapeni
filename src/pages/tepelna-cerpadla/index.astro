---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/tepelna-cerpadla-index.json';
import ref from '../../data/reference.json';

// Jeden zdroj pro schéma i pro viditelné otázky — aby se nemohly rozejít.
const faq = [
  {
    q: 'Jaký typ tepelného čerpadla je pro můj dům nejvhodnější?',
    a: 'Pro rodinné domy bez velkého pozemku je nejčastější volbou čerpadlo vzduch–voda — instalace trvá 2–5 dní a nevyžaduje zemní práce. Pokud máte zahradní pozemek alespoň 400 m² nebo je možný vrt, doporučujeme zemní čerpadlo pro vyšší efektivitu v zimě. Čerpadlo voda–voda se hodí tam, kde je dostatek podzemní vody. Správný typ vždy doporučujeme po konzultaci a prohlídce objektu.'
  },
  {
    q: 'Funguje tepelné čerpadlo i při velkých mrazech?',
    a: 'Moderní inverterová tepelná čerpadla vzduch–voda fungují spolehlivě až do −20 °C. Zemní čerpadla jsou zcela nezávislá na venkovní teplotě, protože čerpají teplo z hloubky, kde je celoroční teplota kolem 10–12 °C. Všechna naše čerpadla Master Therm mají integrovanou elektrickou dotopovou spirálu pro extrémní mrazy.'
  },
  {
    q: 'Lze tepelné čerpadlo kombinovat se stávajícím kotlem?',
    a: 'Ano. Takzvaný bivalentní provoz — kdy čerpadlo pokrývá většinu sezóny a záložní kotel pouze nejstudenější dny — je zcela běžný. Umožňuje levnější investici a rychlou návratnost. Stávající radiátorové otopné soustavy většinou není nutné předělávat, optimalizujeme pouze provozní teplotu.'
  },
  {
    q: 'Kolik stojí tepelné čerpadlo a jaká je návratnost?',
    a: 'Systém vzduch-voda na klíč začíná na 334 000 Kč, u zemních čerpadel se připočítávají vrty nebo kolektor. Z programu Nová zelená úsporám lze čerpat bezúročný úvěr až 350 000 Kč (vzduch-voda), respektive až 400 000 Kč (země-voda), zranitelné domácnosti mají nárok na přímou dotaci až 150 000 Kč. Návratnost investice vychází typicky na 7–10 let, po celou dobu životnosti 20–25 let pak platíte jen za elektřinu.'
  },
];
---

<Layout title={data.meta_title} description={data.meta_description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla' }]}
  />

  <article class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-charcoal-600 text-sm leading-relaxed max-w-3xl mb-10">Tepelné čerpadlo je moderní zdroj vytápění, který odebírá energii z okolního prostředí — ze vzduchu, ze země nebo z vody — a přeměňuje ji na teplo pro váš dům. Dodáváme výhradně inverterová <a href="/mastertherm/" class="text-brand-500 font-semibold hover:text-brand-600 transition-colors">tepelná čerpadla Master Therm</a>, českého výrobce s vlastní výrobou od roku 1994. Vyberte typ podle zdroje energie:</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {data.cards.map(card => (
          <a href={card.href} class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-xl transition-all">
            <div class="h-48 bg-gray-50 relative overflow-hidden">
              {card.image ? <img src={card.image} alt={card.title} class="w-full h-full object-cover" loading="lazy" /> : <div class="flex items-center justify-center h-full"><span class="text-5xl">{card.emoji}</span></div>}
            </div>
            <div class="p-6">
              <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{card.title}</h2>
              <p class="text-sm text-charcoal-500 leading-relaxed mb-4">{card.desc}</p>
              <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
                {data.card_link_text}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </article>

  <!-- Srovnávací tabulka typů -->
  <section class="py-12 lg:py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-3">Porovnání typů tepelných čerpadel</h2>
      <p class="text-charcoal-500 mb-8">Který typ se hodí pro váš dům?</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="text-left py-3 pr-4 text-charcoal-500 font-medium w-36"></th>
              <th class="text-center py-4 px-3 bg-white rounded-t-xl border-t border-x border-gray-200">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-500 mb-1">Nejčastější volba</span>
                <span class="text-navy-700 font-bold">Vzduch – voda</span>
              </th>
              <th class="text-center py-3 px-3 align-bottom text-green-700 font-bold">Země – voda</th>
              <th class="text-center py-3 px-3 align-bottom text-cyan-700 font-bold">Voda – voda</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {[
              { label: "Cena systému", a: "od 334 000 Kč", b: "od 429 000 Kč", c: "od 379 000 Kč" },
              { label: "Průměrný COP", a: "3,3", b: "4,3", c: "5,0" },
              { label: "Zemní práce", a: "žádné", b: "vrt nebo kolektor", c: "dvě studny" },
              { label: "Hlučnost", a: "mírná (venk. j.)", b: "tichý", c: "tichý" },
              { label: "Funkce v mrazech", a: "do −20 °C", b: "bez omezení", c: "bez omezení" },
              { label: "Pasivní chlazení", a: "ne", b: "ano (téměř zdarma)", c: "ano" },
              { label: "Délka montáže", a: "2–5 dní", b: "5–7 dní", c: "5–7 dní" },
              { label: "Pro koho", a: "95 % domů", b: "pozemek min. 200 m²", c: "dostatek spodní vody" },
            ].map((row, i, arr) => (
              <tr>
                <td class="py-3 pr-4 text-charcoal-500 font-medium">{row.label}</td>
                <td class={`py-3 px-3 text-center text-charcoal-900 font-semibold bg-white border-x border-gray-200 ${i === arr.length - 1 ? 'border-b rounded-b-xl' : ''}`}>{row.a}</td>
                <td class="py-3 px-3 text-center text-charcoal-700">{row.b}</td>
                <td class="py-3 px-3 text-center text-charcoal-700">{row.c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-charcoal-400 text-xs mt-4">* Uvedený topný faktor je průměr za topnou sezónu, se kterým počítáme i v porovnání nákladů na vytápění. Maxima jednotlivých modelů z technických listů najdete v katalogu. Ceny jsou orientační, závisí na výkonu a konkrétním objektu.</p>
    </div>
  </section>

  <!-- Realizace — důkaz mezi tabulkou a argumenty -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-2">Takhle to vypadá u zákazníků</h2>
          <p class="text-charcoal-500">
            <strong class="text-charcoal-900">{ref.map_stat1_num} instalací</strong> ve <strong class="text-charcoal-900">{ref.map_stat2_num} obcích</strong> — rodinné domy, bytové domy i komerční objekty.
          </p>
        </div>
        <a href="/reference" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
          Všechny reference
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        {ref.references.slice(0, 4).map(item => (
          <a href="/reference" class="group block">
            <div class="rounded-xl overflow-hidden border border-gray-200 mb-3">
              <img src={item.image} alt={`Instalace ${item.system} — ${item.lokalita}`} loading="lazy"
                width="480" height="360"
                class="w-full h-40 lg:h-48 object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="flex items-center justify-between gap-2 mb-0.5">
              <span class="text-xs font-bold text-brand-500 uppercase tracking-wider truncate">{item.lokalita}</span>
              <span class="text-xs text-charcoal-400 flex-shrink-0">{item.rok}</span>
            </div>
            <div class="text-sm font-semibold text-navy-700">{item.system}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Proč tepelné čerpadlo -->
  <section class="py-12 lg:py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-8">Proč zvolit tepelné čerpadlo?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          {
            title: "Nízké provozní náklady",
            icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
            text: "Tepelné čerpadlo vyrobí z 1 kWh elektřiny 3–5 kWh tepla. Za stejnou cenu elektřiny vytopíte dům několikanásobně levněji než přímotopem nebo elektrokotlem. Proti plynu ušetříte kolem 28 000 Kč ročně.",
            link: { href: "/porovnani-nakladu", label: "Porovnat náklady" }
          },
          {
            title: "Ekologické vytápění",
            icon: "M13 10V3L4 14h7v7l9-11h-7z",
            text: "Využívá obnovitelnou energii z prostředí — ze vzduchu, ze země nebo z vody. V domě nevznikají žádné spaliny ani emise. V kombinaci s fotovoltaikou topíte převážně z vlastní elektřiny.",
            link: { href: "/chytre-funkce/fotovoltaika", label: "Spolupráce s fotovoltaikou" }
          },
          {
            title: "V létě umí chladit",
            icon: "M20 12H4m16 0l-4-4m4 4l-4 4M4 12l4-4m-4 4l4 4",
            text: "Stejný systém, který v zimě topí, umí v létě chladit — podlahovým okruhem nebo fancoily. Pokud máte podlahové topení, nepotřebujete k tomu nic navíc, stačí chlazení objednat.",
            link: { href: "/navrh-reseni/chlazeni", label: "Jak na chlazení" }
          },
          {
            title: "Dotace a státní podpora",
            icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
            text: "Z programu Nová zelená úsporám lze čerpat bezúročný úvěr až 350 000 Kč na vzduch-voda a až 400 000 Kč na země-voda. Zranitelné domácnosti mají nárok na přímou dotaci až 150 000 Kč. Žádost vyřídíme s vámi.",
            link: { href: "/dotace", label: "Podrobně o dotacích" }
          },
        ].map(item => (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-7">
            <div class="w-11 h-11 bg-navy-700 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <h3 class="font-bold text-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-charcoal-600 leading-relaxed mb-4">{item.text}</p>
            <a href={item.link.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
              {item.link.label}
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-3">Nejčastější otázky o tepelných čerpadlech</h2>
      <p class="text-charcoal-500 mb-8">Rozklikněte otázku, která vás zajímá.</p>
      <div class="max-w-4xl space-y-3">
        {faq.map((item, i) => (
          <details open={i === 0} class="group bg-white border border-gray-200 rounded-xl open:border-brand-200 open:shadow-sm transition-colors">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none px-6 py-4 font-bold text-charcoal-900 marker:hidden [&::-webkit-details-marker]:hidden hover:text-brand-500 transition-colors">
              {item.q}
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 group-open:bg-brand-50 flex items-center justify-center transition-colors mt-0.5">
                <svg class="w-4 h-4 text-charcoal-400 group-open:text-brand-500 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <p class="px-6 pb-5 -mt-1 text-charcoal-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy-700 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl font-extrabold text-white">{data.cta_headline}</h3>
        <p class="text-navy-100 text-sm mt-1">{data.cta_text}</p>
      </div>
      <a href="/poptavka" class="flex-shrink-0 inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm">
        {data.cta_button}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
