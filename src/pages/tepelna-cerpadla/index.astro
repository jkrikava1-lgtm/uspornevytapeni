---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Tepelná čerpadla" description="Tepelná čerpadla Master Therm — vzduch-voda, země-voda, voda-voda. Česká výroba, mezinárodní ocenění, servis od výrobce.">
  <PageHero
    title="Tepelná čerpadla"
    subtitle="Dodáváme tepelná čerpadla Master Therm — česká výroba, mezinárodní ocenění, servis přímo od výrobce."
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <a href="/tepelna-cerpadla/vzduch-voda" class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-xl transition-all">
          <div class="h-40 bg-gradient-to-br from-navy-700 to-navy-900 flex items-center justify-center">
            <span class="text-5xl">🌬️</span>
          </div>
          <div class="p-6">
            <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">Vzduch – voda</h2>
            <p class="text-sm text-charcoal-500 leading-relaxed mb-4">Nejrozšířenější typ. Snadná instalace za 2–3 dny, výborný poměr cena/výkon. Vhodné pro 95 % domácností.</p>
            <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
              Zjistit více
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>

        <a href="/tepelna-cerpadla/zeme-voda" class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-xl transition-all">
          <div class="h-40 bg-gradient-to-br from-green-700 to-green-900 flex items-center justify-center">
            <span class="text-5xl">🌱</span>
          </div>
          <div class="p-6">
            <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">Země – voda</h2>
            <p class="text-sm text-charcoal-500 leading-relaxed mb-4">Nejvyšší účinnost i v mrazivých zimách. Plošný kolektor nebo hloubkový vrt podle pozemku.</p>
            <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
              Zjistit více
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>

        <a href="/tepelna-cerpadla/voda-voda" class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-xl transition-all">
          <div class="h-40 bg-gradient-to-br from-cyan-700 to-cyan-900 flex items-center justify-center">
            <span class="text-5xl">💧</span>
          </div>
          <div class="p-6">
            <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">Voda – voda</h2>
            <p class="text-sm text-charcoal-500 leading-relaxed mb-4">Maximální výkon a účinnost využívající podzemní vodu. Ideální tam, kde je dostatek spodní vody.</p>
            <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
              Zjistit více
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <section class="bg-navy-700 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl font-extrabold text-white">Nevíte, který typ zvolit?</h3>
        <p class="text-navy-200 text-sm mt-1">Poradíme vám s výběrem — zdarma a nezávazně.</p>
      </div>
      <a href="/poptavka" class="flex-shrink-0 inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm">
        Odeslat poptávku
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
