---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/tepelna-cerpadla-index.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla' }]}
  />

  <article class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-charcoal-600 text-sm leading-relaxed max-w-3xl mb-10">Tepelné čerpadlo je moderní zdroj vytápění, který odebírá energii z okolního prostředí — ze vzduchu, ze země nebo z vody — a přeměňuje ji na teplo pro váš dům. Dodáváme výhradně inverterová tepelná čerpadla Master Therm, českého výrobce s více než 30 lety zkušeností. Vyberte typ podle zdroje energie:</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {data.cards.map(card => (
          <a href={card.href} class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-brand-300 hover:shadow-xl transition-all">
            <div class="h-48 bg-gray-50 relative overflow-hidden">
              {card.image ? <img src={card.image} alt={card.title} class="w-full h-full object-cover" loading="lazy" /> : <div class="flex items-center justify-center h-full"><span class="text-5xl">{card.emoji}</span></div>}
            </div>
            <div class="p-6">
              <h2 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{card.title}</h2>
              <p class="text-sm text-charcoal-500 leading-relaxed mb-4">{card.desc}</p>
              <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
                {data.card_link_text}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </article>

  <section class="bg-navy-700 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl font-extrabold text-white">{data.cta_headline}</h3>
        <p class="text-navy-100 text-sm mt-1">{data.cta_text}</p>
      </div>
      <a href="/poptavka" class="flex-shrink-0 inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm">
        {data.cta_button}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
