---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/vzduch-voda.json';
---

<Layout title="Tepelná čerpadla vzduch-voda" description="Tepelná čerpadla vzduch-voda Master Therm. Dvě varianty — venkovní kompakt nebo split. Rychlá montáž 2–3 dny, ověřené řešení pro české klima.">
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla/vzduch-voda' }, { label: 'Vzduch – voda', href: '/tepelna-cerpadla/vzduch-voda' }]}
  />

  <!-- Intro sekce -->
  <section class="pt-10 pb-16 lg:pt-12 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <div>
          <p class="text-charcoal-600 leading-relaxed mb-4" set:html={data.intro_text1} />
          <p class="text-charcoal-600 leading-relaxed mb-8" set:html={data.intro_text2} />

          <div class="space-y-3 mb-8">
            {data.intro_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>

          <p class="text-charcoal-700 font-semibold">
            {data.intro_summary}
          </p>
        </div>

        <div class="bg-navy-700 rounded-2xl p-8 text-white">
          <div class="text-brand-400 text-xs font-semibold uppercase tracking-wider mb-5">{data.params_label}</div>
          <div class="space-y-4">
            {data.params.map(item => (
              <div class="flex justify-between py-3 border-b border-navy-600 last:border-0 gap-4">
                <span class="text-sm text-navy-300">{item.label}</span>
                <span class="text-sm font-bold flex-shrink-0">{item.value}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Varianta 1: Venkovní kompakt -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-center gap-4 mb-6">
        <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">1</div>
        <div>
          <h2 class="text-2xl font-extrabold text-charcoal-900">{data.variant1_title}</h2>
          <p class="text-charcoal-500 text-sm mt-0.5">{data.variant1_subtitle}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div>
          <h3 class="font-bold text-charcoal-900 mb-4">{data.variant1_question}</h3>
          <div class="space-y-3 mb-8">
            {data.variant1_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>

          <h3 class="font-bold text-charcoal-900 mb-3">{data.variant1_placement_title}</h3>
          <p class="text-charcoal-600 text-sm leading-relaxed">
            {data.variant1_placement_text}
          </p>
        </div>

        <div class="space-y-6">
          <img src="/images/produkty/boxair-kompakt-dum.jpg" alt="Tepelné čerpadlo BoxAir Inverter u rodinného domu" class="rounded-2xl w-full object-cover" loading="lazy" />
          <div class="bg-white rounded-xl p-6 border border-gray-200">
            <div class="text-xs text-charcoal-400 font-semibold uppercase tracking-wider mb-2">{data.variant1_model_label}</div>
            <div class="font-bold text-charcoal-900 text-base mb-1">{data.variant1_model_name}</div>
            <div class="text-sm text-charcoal-500">{data.variant1_model_desc}</div>
          </div>

          <div class="bg-white rounded-xl p-6 border border-gray-200">
            <p class="text-charcoal-700 text-sm mb-4">{data.variant1_cta_text}</p>
            <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm w-full sm:w-auto">
              {data.variant1_cta_button}
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Varianta 2: Split -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-center gap-4 mb-6">
        <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">2</div>
        <div>
          <h2 class="text-2xl font-extrabold text-charcoal-900">{data.variant2_title}</h2>
          <p class="text-charcoal-500 text-sm mt-0.5">{data.variant2_subtitle}</p>
        </div>
      </div>

      <img src="/images/produkty/boxair-split-cihla.jpg" alt="Split tepelné čerpadlo BoxAir na fasádě domu" class="rounded-2xl w-full object-cover mb-10" loading="lazy" />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-charcoal-900 mb-4 text-sm uppercase tracking-wide">{data.variant2_outdoor_title}</h3>
          <div class="space-y-2">
            {data.variant2_outdoor_bullets.map(item => (
              <div class="flex gap-2 items-start">
                <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-600 text-xs leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-charcoal-900 mb-4 text-sm uppercase tracking-wide">{data.variant2_connection_title}</h3>
          <div class="space-y-2">
            {data.variant2_connection_bullets.map(item => (
              <div class="flex gap-2 items-start">
                <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-600 text-xs leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-charcoal-900 mb-4 text-sm uppercase tracking-wide">{data.variant2_indoor_title}</h3>
          <div class="space-y-2">
            {data.variant2_indoor_bullets.map(item => (
              <div class="flex gap-2 items-start">
                <div class="w-4 h-4 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-600 text-xs leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div>
          <h3 class="font-bold text-charcoal-900 mb-3">{data.variant2_extra_title}</h3>
          <p class="text-charcoal-600 text-sm mb-4">{data.variant2_extra_subtitle}</p>
          <div class="space-y-2">
            {data.variant2_extra_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <div class="text-xs text-charcoal-400 font-semibold uppercase tracking-wider mb-2">{data.variant2_model_label}</div>
            <div class="space-y-1 mb-2">
              {data.variant2_model_names.map(name => (
                <div class="font-bold text-charcoal-900 text-sm">{name}</div>
              ))}
            </div>
            <div class="text-xs text-charcoal-500">{data.variant2_model_desc}</div>
          </div>

          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <p class="text-charcoal-700 text-sm mb-4">{data.variant2_cta_text}</p>
            <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm w-full sm:w-auto">
              {data.variant2_cta_button}
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Závěrečná CTA -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-4">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">
        {data.cta_text}
      </p>
      <p class="text-charcoal-600 text-sm mb-6">{data.cta_subtext}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">
        {data.cta_button}
      </a>
    </div>
  </section>
</Layout>
