---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/zeme-voda.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla/zeme-voda' }, { label: 'Země – voda', href: '/tepelna-cerpadla/zeme-voda' }]}
  />

  <!-- Intro sekce -->
  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">

        <div class="space-y-3 mb-8">
          {data.intro_bullets.map(item => (
            <div class="flex gap-3 items-start">
              <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
            </div>
          ))}
        </div>

        <p class="text-charcoal-700 font-semibold">
          {data.intro_summary}
        </p>
      </div>
    </div>
  </section>

  <!-- Varianta 1: Plošný kolektor -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-center gap-4 mb-6">
        <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">1</div>
        <div>
          <h2 class="text-2xl font-extrabold text-charcoal-900">{data.variant1_title}</h2>
          <p class="text-charcoal-500 text-sm mt-0.5">{data.variant1_subtitle}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div>
          <div class="space-y-3 mb-8">
            {data.variant1_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <img src="/images/produkty/aquamaster-technicka.jpg" alt="Tepelné čerpadlo AquaMaster Inverter v technické místnosti" class="rounded-2xl w-full object-cover" loading="lazy" />
          <div class="bg-navy-700 rounded-2xl p-6 text-white">
            <div class="text-brand-300 text-xs font-semibold uppercase tracking-wider mb-4">{data.variant1_params_label}</div>
            <div class="space-y-3">
              {data.variant1_params.map(item => (
                <div class="flex justify-between py-2 border-b border-navy-600 last:border-0 gap-4">
                  <span class="text-sm text-navy-100">{item.label}</span>
                  <span class="text-sm font-bold flex-shrink-0">{item.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Varianta 2: Vrt -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-center gap-4 mb-6">
        <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">2</div>
        <div>
          <h2 class="text-2xl font-extrabold text-charcoal-900">{data.variant2_title}</h2>
          <p class="text-charcoal-500 text-sm mt-0.5">{data.variant2_subtitle}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div>
          <div class="space-y-3 mb-8">
            {data.variant2_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <img src="/images/produkty/aquamaster-interier-cerveny.jpg" alt="Tepelné čerpadlo AquaMaster v technické místnosti" class="rounded-2xl w-full object-cover" loading="lazy" />
          <div class="bg-navy-700 rounded-2xl p-6 text-white">
            <div class="text-brand-300 text-xs font-semibold uppercase tracking-wider mb-4">{data.variant2_params_label}</div>
            <div class="space-y-3">
              {data.variant2_params.map(item => (
                <div class="flex justify-between py-2 border-b border-navy-600 last:border-0 gap-4">
                  <span class="text-sm text-navy-100">{item.label}</span>
                  <span class="text-sm font-bold flex-shrink-0">{item.value}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Závěrečná CTA -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-4">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">
        {data.cta_text}
      </p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">
        {data.cta_button}
      </a>
    </div>
  </section>
</Layout>
