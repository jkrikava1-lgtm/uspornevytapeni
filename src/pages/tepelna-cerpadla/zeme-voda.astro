---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/zeme-voda.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla/zeme-voda' }, { label: 'Země – voda', href: '/tepelna-cerpadla/zeme-voda' }]}
  />

  <!-- Intro sekce -->
  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>

        <div class="space-y-3 mb-8">
          {data.intro_bullets.map(item => (
            <div class="flex gap-3 items-start">
              <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
            </div>
          ))}
        </div>

        <p class="text-charcoal-700 font-semibold">
          {data.intro_summary}
        </p>
      </div>
      <img src="/images/ilustrace/zeme-voda.jpg" alt="Tepelné čerpadlo AquaMaster Inverter v technické místnosti" class="rounded-2xl w-full object-cover max-h-72" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Varianta 1: Plošný kolektor -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">1</div>
            <div>
              <h2 class="text-2xl font-extrabold text-charcoal-900">{data.variant1_title}</h2>
              <p class="text-charcoal-500 text-sm mt-0.5">{data.variant1_subtitle}</p>
            </div>
          </div>
          <div class="space-y-3">
            {data.variant1_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-navy-700 rounded-2xl p-6 text-white">
          <div class="text-brand-300 text-xs font-semibold uppercase tracking-wider mb-4">{data.variant1_params_label}</div>
          <div class="space-y-3">
            {data.variant1_params.map(item => (
              <div class="flex justify-between py-2 border-b border-navy-600 last:border-0 gap-4">
                <span class="text-sm text-navy-100">{item.label}</span>
                <span class="text-sm font-bold flex-shrink-0">{item.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Varianta 2: Vrt -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-10 h-10 bg-navy-700 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">2</div>
            <div>
              <h2 class="text-2xl font-extrabold text-charcoal-900">{data.variant2_title}</h2>
              <p class="text-charcoal-500 text-sm mt-0.5">{data.variant2_subtitle}</p>
            </div>
          </div>
          <div class="space-y-3">
            {data.variant2_bullets.map(item => (
              <div class="flex gap-3 items-start">
                <div class="w-5 h-5 bg-brand-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-charcoal-700 text-sm leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-navy-700 rounded-2xl p-6 text-white">
          <div class="text-brand-300 text-xs font-semibold uppercase tracking-wider mb-4">{data.variant2_params_label}</div>
          <div class="space-y-3">
            {data.variant2_params.map(item => (
              <div class="flex justify-between py-2 border-b border-navy-600 last:border-0 gap-4">
                <span class="text-sm text-navy-100">{item.label}</span>
                <span class="text-sm font-bold flex-shrink-0">{item.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Katalog odkaz -->
  <section class="py-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/katalog/zeme-voda" class="group bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all block">
        <div class="text-xs text-charcoal-400 font-semibold uppercase tracking-wider mb-2">Používané modely</div>
        <h3 class="font-bold text-charcoal-900 text-base mb-1 group-hover:text-brand-500 transition-colors">AquaMaster Inverter</h3>
        <p class="text-sm text-charcoal-500 mb-3">Špičkové modely od společnosti Master Therm — český výrobce s mezinárodním oceněním</p>
        <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
          Katalog země–voda
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- Závěrečná CTA -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-4">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">
        {data.cta_text}
      </p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">
        {data.cta_button}
      </a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Jaký je rozdíl mezi tepelným čerpadlem se zemním kolektorem a vrtem?", "acceptedAnswer": { "@type": "Answer", "text": "Plošný kolektor je horizontální potrubí zakopané do hloubky 1,2–1,5 m, vyžaduje volnou plochu přibližně 400–600 m². Vrt (geotermální vrty) čerpá teplo z hloubky 80–120 m a potřebuje pouze malé místo u domu. Obě varianty zajišťují stabilní výkon nezávislý na venkovní teplotě." } },
      { "@type": "Question", "name": "Kolik stojí tepelné čerpadlo země-voda?", "acceptedAnswer": { "@type": "Answer", "text": "Kompletní instalace tepelného čerpadla země-voda včetně vrtu nebo plošného kolektoru začíná od 429 000 Kč. Cena zahrnuje dodávku, zemní práce, montáž, elektroinstalaci a uvedení do provozu. S podporou z NZÚ 2026 lze získat bezúročný úvěr až 400 000 Kč." } },
      { "@type": "Question", "name": "Je tepelné čerpadlo země-voda efektivnější než vzduch-voda?", "acceptedAnswer": { "@type": "Answer", "text": "Ano. Zemní čerpadlo má vyšší roční průměrný COP, protože čerpá teplo ze stabilní teploty v zemi (10–12 °C celoročně). Vzduch-voda pracuje s proměnlivou venkovní teplotou — v mrazivých zimách je výhoda zemního čerpadla nejvýraznější." } },
      { "@type": "Question", "name": "Jak velký pozemek potřebuji pro plošný kolektor?", "acceptedAnswer": { "@type": "Answer", "text": "Pro rodinný dům s tepelnou ztrátou 10 kW potřebujete přibližně 400–600 m² volné plochy bez stromů a staveb. Pokud nemáte dostatečnou plochu, realizujeme variantu s geotermálním vrtem, která zabere jen malé místo u domu." } }
    ]
  })} />
</Layout>
