---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import data from '../../data/voda-voda.json';
---

<Layout title={data.meta_title} description={data.meta_description} breadcrumbs={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla' }, { label: 'Voda – voda', href: '/tepelna-cerpadla/voda-voda' }]}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Tepelná čerpadla', href: '/tepelna-cerpadla/voda-voda' }, { label: 'Voda – voda', href: '/tepelna-cerpadla/voda-voda' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.how_label}</div>
          <h2 class="text-3xl font-extrabold text-charcoal-900 mb-6">{data.how_headline}</h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>{data.how_text1}</p>
            <p>{data.how_text2}</p>
          </div>

          <div class="mt-8 space-y-4">
            {[
              { title: data.feat1_title, desc: data.feat1_desc },
              { title: data.feat2_title, desc: data.feat2_desc },
              { title: data.feat3_title, desc: data.feat3_desc },
              { title: data.feat4_title, desc: data.feat4_desc },
            ].map(item => (
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-brand-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-charcoal-900 text-sm">{item.title}</div>
                  <div class="text-sm text-charcoal-500">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <img src="/images/produkty/aq22i-vizual.jpg" alt="Tepelné čerpadlo AquaMaster" class="rounded-2xl w-full object-cover max-h-72" loading="lazy" />
          <div class="bg-navy-700 rounded-2xl p-8 text-white">
            <div class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-4">{data.params_label}</div>
            <div class="space-y-3">
              {[
                { label: data.param1_label, value: data.param1_value },
                { label: data.param2_label, value: data.param2_value },
                { label: data.param3_label, value: data.param3_value },
                { label: data.param4_label, value: data.param4_value },
                { label: data.param5_label, value: data.param5_value },
                { label: data.param6_label, value: data.param6_value },
              ].map(item => (
                <div class="flex justify-between py-2 border-b border-navy-600 last:border-0">
                  <span class="text-sm text-navy-100">{item.label}</span>
                  <span class="text-sm font-semibold">{item.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-amber-50 rounded-xl p-6 border border-amber-200">
            <div class="flex gap-3">
              <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <h4 class="font-bold text-amber-900 text-sm mb-1">{data.warning_title}</h4>
                <p class="text-xs text-amber-700 leading-relaxed">{data.warning_text}</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Katalog odkaz -->
  <section class="py-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/katalog/voda-voda" class="group bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all block">
        <div class="text-xs text-charcoal-400 font-semibold uppercase tracking-wider mb-2">Používané modely</div>
        <h3 class="font-bold text-charcoal-900 text-base mb-1 group-hover:text-brand-500 transition-colors">AquaMaster Inverter</h3>
        <p class="text-sm text-charcoal-500 mb-3">Špičkové modely od společnosti Master Therm — český výrobce s mezinárodním oceněním</p>
        <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
          Katalog voda–voda
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">{data.cta_button}</a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Jak funguje tepelné čerpadlo voda-voda?", "acceptedAnswer": { "@type": "Answer", "text": "Tepelné čerpadlo voda-voda čerpá tepelnou energii z podzemní vody pomocí dvou studní — zdrojové a vsakovací. Vodu ze zdrojové studny proženeme tepelným výměníkem, odebereme z ní teplo a ochlazenou vrátíme do vsakovací studny. Díky stálé teplotě spodní vody (cca 10 °C) dosahují tato čerpadla topného faktoru COP až 7 — nejvyšší ze všech typů tepelných čerpadel." } },
      { "@type": "Question", "name": "Jaké podmínky jsou nutné pro instalaci tepelného čerpadla voda-voda?", "acceptedAnswer": { "@type": "Answer", "text": "Jsou potřeba dvě studny (zdrojová a vsakovací) s minimální vzdáleností danou hydrogeologem. Zdrojová studna musí mít dostatečnou vydatnost. Před instalací je nutný hydrogeologický průzkum a rozbor vody. K využívání spodní vody je třeba povolení od odboru životního prostředí." } },
      { "@type": "Question", "name": "Kolik stojí tepelné čerpadlo voda-voda?", "acceptedAnswer": { "@type": "Answer", "text": "Cena kompletní instalace tepelného čerpadla voda-voda začíná od 379 000 Kč. Konečná cena závisí na hloubce studní a hydrogeologických podmínkách. S podporou z NZÚ 2026 lze získat bezúročný úvěr až 400 000 Kč." } },
      { "@type": "Question", "name": "Je tepelné čerpadlo voda-voda nejúčinnější typ?", "acceptedAnswer": { "@type": "Answer", "text": "Ano. Čerpadla voda-voda dosahují COP až 7 — tedy z 1 kW elektřiny získáte až 7 kW tepla. Jsou nejefektivnějším typem tepelných čerpadel, avšak vyžadují vhodné geologické podmínky a administrativní povolení." } }
    ]
  })} />
</Layout>
