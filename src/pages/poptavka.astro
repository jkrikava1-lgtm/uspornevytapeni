---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/poptavka.json';
import site from '../data/site.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Poptávka', href: '/poptavka' }]}
  />

  <section class="pt-10 pb-10 lg:pt-12 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2">
          <div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-6 text-center">
            <svg class="w-12 h-12 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h3 class="text-lg font-bold text-charcoal-900 mb-1">{data.success_title}</h3>
            <p class="text-sm text-charcoal-600">{data.success_text}</p>
          </div>
          <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-4 text-sm text-red-700">
            {data.error_text}
          </div>
          <form id="poptavka-form" class="space-y-6" method="POST" action="/api/poptavka">
            <!-- Honeypot - skryté pole proti botům -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_loaded" id="_loaded" value="" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.label_jmeno}</label>
                <input type="text" name="jmeno" required class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" placeholder={data.placeholder_jmeno} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.label_telefon}</label>
                <input type="tel" name="telefon" required class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" placeholder={data.placeholder_telefon} />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.label_email}</label>
              <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" placeholder={data.placeholder_email} />
            </div>
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.label_objekt}</label>
              <select name="objekt" class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors text-charcoal-700">
                <option value="">{data.placeholder_objekt}</option>
                {data.options_objekt.map(opt => (<option>{opt}</option>))}
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.label_vytapeni}</label>
              <select name="vytapeni" class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors text-charcoal-700">
                <option value="">{data.placeholder_vytapeni}</option>
                {data.options_vytapeni.map(opt => (<option>{opt}</option>))}
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">{data.label_zprava}</label>
              <textarea name="zprava" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors resize-none" placeholder={data.placeholder_zprava}></textarea>
            </div>
            <div>
              <label class="block text-sm font-semibold text-charcoal-800 mb-2">Příloha <span class="font-normal text-charcoal-400">(nepovinné)</span></label>
              <input type="file" name="priloha" id="priloha" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" class="w-full text-sm text-charcoal-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-charcoal-700 hover:file:bg-gray-200 file:cursor-pointer file:transition-colors" />
              <p class="text-xs text-charcoal-400 mt-1">Max. 5 MB — PDF, obrázky, dokumenty</p>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" name="souhlas" id="souhlas" required class="mt-1 w-4 h-4 accent-brand-500" />
              <label for="souhlas" class="text-xs text-charcoal-500 leading-relaxed">{data.souhlas_text}</label>
            </div>
            <button type="submit" data-label={data.submit_button} data-loading={data.submit_loading} class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-base">
              {data.submit_button}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </button>
          </form>
        </div>

        <div class="space-y-6">
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <div class="flex items-center gap-4 mb-5 pb-5 border-b border-gray-200">
              <img src="/images/team/kuba.webp" alt="Jakub Křikava" class="w-14 h-14 rounded-full object-cover cursor-pointer hover:ring-4 hover:ring-brand-200 transition-all flex-shrink-0" data-lightbox />
              <div>
                <div class="font-bold text-charcoal-900">Jakub Křikava</div>
                <div class="text-xs text-charcoal-500">obchod a technická podpora</div>
              </div>
            </div>
            <h3 class="font-bold text-charcoal-900 mb-4">{data.sidebar_title}</h3>
            <div class="space-y-3 text-sm text-charcoal-600">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-navy-700 rounded-md flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <div class="text-xs text-charcoal-400">{data.sidebar_telefon_label}</div>
                  <a href={site.phone_href} class="font-semibold text-charcoal-900 hover:text-brand-500 transition-colors">{site.phone}</a>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-navy-700 rounded-md flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <div class="text-xs text-charcoal-400">{data.sidebar_email_label}</div>
                  <a href={`mailto:${site.email}`} class="font-semibold text-charcoal-900 hover:text-brand-500 transition-colors">{site.email}</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-navy-700 rounded-md flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <div class="text-xs text-charcoal-400">{data.sidebar_adresa_label}</div>
                  <div class="font-semibold text-charcoal-900" set:html={data.sidebar_adresa}></div>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-navy-700 rounded-xl p-6 text-white">
            <div class="text-brand-300 text-xs font-semibold uppercase tracking-wider mb-3">{data.sidebar_why_label}</div>
            <ul class="space-y-3 text-sm text-navy-100">
              {data.sidebar_why_items.map(item => (
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-brand-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-50 bg-black/70 flex items-center justify-center hidden cursor-pointer">
    <img id="lightbox-img" src="" alt="" class="max-w-sm max-h-[80vh] rounded-2xl shadow-2xl object-contain" />
  </div>
</Layout>

<script>
  // Anti-spam: timestamp při načtení
  document.getElementById('_loaded')?.setAttribute('value', String(Date.now()));

  const form = document.getElementById('poptavka-form') as HTMLFormElement;
  const successBox = document.getElementById('form-success')!;
  const errorBox = document.getElementById('form-error')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = btn.dataset.loading || 'Odesílám…';

    try {
      const formData = new FormData(form);
      const jsonData: Record<string, any> = {};
      formData.forEach((val, key) => { if (key !== 'priloha') jsonData[key] = String(val); });

      const fileInput = document.getElementById('priloha') as HTMLInputElement;
      const file = fileInput?.files?.[0];
      if (file) {
        if (file.size > 5 * 1024 * 1024) {
          errorBox.textContent = 'Soubor je příliš velký (max. 5 MB).';
          errorBox.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = btn.dataset.label || 'Odeslat poptávku';
          return;
        }
        const reader = new FileReader();
        const base64 = await new Promise<string>((resolve) => {
          reader.onload = () => resolve((reader.result as string).split(',')[1]);
          reader.readAsDataURL(file);
        });
        jsonData.priloha = { name: file.name, type: file.type, data: base64 };
      }

      const res = await fetch('/api/poptavka/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(jsonData),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      } else {
        errorBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = btn.dataset.label || 'Odeslat poptávku';
      }
    } catch {
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Odeslat poptávku';
    }
  });

  document.querySelectorAll('[data-lightbox]').forEach(img => {
    img.addEventListener('click', () => {
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightbox-img');
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lb.classList.remove('hidden');
    });
  });
  document.getElementById('lightbox').addEventListener('click', (e) => {
    e.currentTarget.classList.add('hidden');
  });
</script>
