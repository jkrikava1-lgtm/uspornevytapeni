---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/cena.json';
import site from '../data/site.json';
---

<Layout title={data.meta_title} description={data.meta_description} breadcrumbs={[{ label: 'Cena', href: '/cena' }]}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Cena', href: '/cena' }]}
  />

  <section class="pt-10 pb-6 lg:pt-12 lg:pb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Úvod -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center mb-6">
        <div>
          <h2 class="text-xl font-extrabold text-charcoal-900 mb-3">{data.intro_headline}</h2>
          <p class="text-charcoal-600 text-sm leading-relaxed" set:html={data.intro_text} />
        </div>
        <img src="/images/reference/tuklaty-1.webp" alt="Tepelné čerpadlo Master Therm u rodinného domu v Tuklatech" class="rounded-2xl w-full max-h-64 object-cover" style="object-position: 50% 45%;" loading="lazy" />
      </div>

      <!-- Cenové tabulky -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        {[
          {
            typ: data.price1_typ,
            rozsah: data.price1_rozsah,
            poznamka: data.price1_poznamka,
            body: [data.price1_body1, data.price1_body2, data.price1_body3],
            highlight: true,
          },
          {
            typ: data.price2_typ,
            rozsah: data.price2_rozsah,
            poznamka: data.price2_poznamka,
            body: [data.price2_body1, data.price2_body2, data.price2_body3],
            highlight: false,
          },
          {
            typ: data.price3_typ,
            rozsah: data.price3_rozsah,
            poznamka: data.price3_poznamka,
            body: [data.price3_body1, data.price3_body2, data.price3_body3],
            highlight: false,
          },
        ].map(item => (
          <div class={`rounded-xl p-7 border-2 ${item.highlight ? 'border-brand-500 bg-brand-50' : 'border-gray-200 bg-white'}`}>
            {item.highlight && <div class="text-xs text-brand-500 font-semibold uppercase tracking-wider mb-3">{data.highlight_badge}</div>}
            <h3 class="text-lg font-bold text-charcoal-900 mb-2">{item.typ}</h3>
            <div class="text-2xl font-extrabold text-navy-700 mb-1">{item.rozsah}</div>
            <div class="text-xs text-charcoal-400 mb-5">{item.poznamka}</div>
            <ul class="space-y-2">
              {item.body.map(b => (
                <li class="flex items-center gap-2 text-sm text-charcoal-600">
                  <svg class="w-4 h-4 text-brand-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div>
        <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6">{data.factors_headline}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { title: data.factor1_title, desc: data.factor1_desc },
            { title: data.factor2_title, desc: data.factor2_desc },
            { title: data.factor3_title, desc: data.factor3_desc },
            { title: data.factor4_title, desc: data.factor4_desc },
          ].map(item => (
            <div class="flex gap-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
              <div class="w-8 h-8 bg-navy-700 rounded-md flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-charcoal-900 text-sm">{item.title}</div>
                <div class="text-sm text-charcoal-500 mt-0.5">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Co zahrnuje cena montáže -->

  <!-- Modelové příklady — vykreslí se, až budou v cena.json vyplněné modely -->
  {data.modely && data.modely.length > 0 && (
  <section class="py-10 lg:py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.modely_label}</div>
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-4">{data.modely_headline}</h2>
      <p class="text-charcoal-500 leading-relaxed max-w-3xl mb-10">{data.modely_lead}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.modely.map(m => (
          <div class="bg-white border border-gray-200 rounded-xl p-7 flex flex-col">
            <div class="text-xs font-bold text-charcoal-400 uppercase tracking-wider mb-2">{m.plocha}</div>
            <div class="text-2xl font-extrabold text-navy-700 mb-4">{m.cena}</div>
            <dl class="space-y-2.5 text-sm flex-1">
              {m.ztrata && (
                <div class="flex justify-between gap-3 border-b border-gray-100 pb-2.5">
                  <dt class="text-charcoal-400">Tepelná ztráta</dt><dd class="text-charcoal-700 font-semibold text-right">{m.ztrata}</dd>
                </div>
              )}
              <div class="flex justify-between gap-3 border-b border-gray-100 pb-2.5">
                <dt class="text-charcoal-400">Model</dt><dd class="text-charcoal-700 font-semibold text-right">{m.model}</dd>
              </div>
              {m.system && (
                <div class="flex justify-between gap-3 border-b border-gray-100 pb-2.5">
                  <dt class="text-charcoal-400">Otopná soustava</dt><dd class="text-charcoal-700 font-semibold text-right">{m.system}</dd>
                </div>
              )}
              {m.zdroj && (
                <div class="flex justify-between gap-3">
                  <dt class="text-charcoal-400">Nahradilo</dt><dd class="text-charcoal-700 font-semibold text-right">{m.zdroj}</dd>
                </div>
              )}
            </dl>
            {m.poznamka && <p class="text-sm text-charcoal-500 leading-relaxed mt-4 pt-4 border-t border-gray-100">{m.poznamka}</p>}
          </div>
        ))}
      </div>

      <p class="text-sm text-charcoal-400 leading-relaxed mt-8 max-w-3xl">{data.modely_note}</p>
      <div class="mt-8 max-w-3xl rounded-xl border border-gray-200 bg-white p-5 sm:p-6">
        <p class="text-charcoal-700 leading-relaxed">
          <strong class="text-charcoal-900">Žádný z těch domů ale není ten váš.</strong> Přesnou cenu určuje tepelná ztráta — tu spočítáme a pošleme vám návrh systému i s cenou do 24 hodin. Zdarma a bez závazků.
        </p>
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <a href="/poptavka" data-place="cena-po-modelech"
             class="inline-flex items-center justify-center px-5 py-3 bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold rounded-lg transition-colors">
            Chci nabídku pro svůj dům
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <span class="text-sm text-charcoal-500">
            nebo zavolejte
            <a href={site.phone_href} data-place="cena-po-modelech" class="font-bold text-navy-700 hover:text-brand-500 transition-colors whitespace-nowrap">{site.phone}</a>
          </span>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- Cena podle typu — míří na dotazy „cena tepelného čerpadla vzduch voda / země voda / voda voda" -->
  <section class="py-10 lg:py-14 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-brand-500 text-sm font-semibold uppercase tracking-wider mb-3">{data.typy_label}</div>
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-4">{data.typy_headline}</h2>
      <p class="text-charcoal-500 leading-relaxed max-w-3xl mb-10">{data.typy_lead}</p>

      <div class="space-y-8">
        {data.typy.map(t => (
          <div id={t.anchor} class="bg-white border border-gray-200 rounded-2xl overflow-hidden scroll-mt-24">
            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,320px)_1fr]">

              <div class="relative h-52 lg:h-full lg:min-h-[300px]">
                <img src={t.image} alt={t.image_alt} loading="lazy" width="640" height="600"
                  class="absolute inset-0 w-full h-full object-cover" />
                {t.badge && (
                  <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-brand-500 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    {t.badge}
                  </span>
                )}
              </div>

              <div class="p-7 lg:p-9">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-4">
                  <h3 class="text-2xl font-extrabold text-charcoal-900">{t.typ}</h3>
                  <div class="text-2xl font-extrabold text-brand-500 whitespace-nowrap">{t.cena}</div>
                </div>
                <p class="text-charcoal-600 leading-relaxed mb-7">{t.text}</p>

                <div class="text-xs font-bold text-charcoal-400 uppercase tracking-wider mb-3">Co cenu nejvíc ovlivní</div>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 mb-7">
                  {t.ovlivnuje.map(o => (
                    <li class="flex gap-2.5 text-sm text-charcoal-600 leading-relaxed">
                      <svg class="w-4 h-4 text-brand-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span>{o}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pt-6 border-t border-gray-100">
                  <div>
                    <div class="text-[11px] font-bold text-charcoal-400 uppercase tracking-wider">Topný faktor COP</div>
                    <div class="text-xl font-extrabold text-navy-700 mt-0.5">{t.cop}</div>
                  </div>
                  <div class="flex-1 min-w-[200px]">
                    <div class="text-[11px] font-bold text-charcoal-400 uppercase tracking-wider">Řady, které dodáváme</div>
                    <div class="text-sm text-charcoal-600 mt-0.5 leading-relaxed">{t.rady}</div>
                  </div>
                  <a href={t.katalog_href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors whitespace-nowrap">
                    {t.katalog_label}
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-5 mt-8">
        <p class="text-sm text-charcoal-400 leading-relaxed flex-1">{data.typy_note}</p>
        <a href="/cenova-kalkulace" data-place="cena-typy" class="flex-shrink-0 inline-flex items-center justify-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors text-sm">
          {data.typy_cta}
        </a>
      </div>
    </div>
  </section>

  <section class="py-10 lg:py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">Co zahrnuje cena montáže tepelného čerpadla?</h2>
      <p class="text-charcoal-500 text-sm mb-8">Naše cena je vždy za kompletní realizaci na klíč — žádné skryté náklady.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: "M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18", title: "Tepelné čerpadlo", desc: "Dodávka jednotky Master Therm včetně zásobníku TUV a příslušenství." },
          { icon: "M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z", title: "Montáž a zapojení", desc: "Instalace venkovní i vnitřní jednotky, propojení trubkami, elektroinstalace." },
          { icon: "M13 10V3L4 14h7v7l9-11h-7z", title: "Elektroinstalace", desc: "Zapojení na HDO tarif, jistič, případné posílení přípojky." },
          { icon: "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 4a2 2 0 100 4m0-4a2 2 0 110 4m6-4a2 2 0 100 4m0-4a2 2 0 110 4", title: "Uvedení do provozu", desc: "Nastavení regulace, napojení na otopnou soustavu, první spuštění a seřízení." },
          { icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z", title: "Zaškolení", desc: "Obsluhu vás naučíme pracovat s regulací a ovládáním přes mobil." },
          { icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2", title: "Dokumentace", desc: "Revizní zpráva, protokol o uvedení do provozu, podklady pro dotaci NZÚ." },
        ].map(item => (
          <div class="flex gap-3 p-5 bg-white rounded-xl border border-gray-200">
            <div class="w-8 h-8 bg-brand-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <div>
              <div class="font-semibold text-charcoal-900 text-sm mb-0.5">{item.title}</div>
              <div class="text-sm text-charcoal-500 leading-relaxed">{item.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Návratnost investice -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-2">{data.roi_headline}</h2>
      <p class="text-charcoal-500 text-sm mb-8">Modelový příklad pro rodinný dům 150 m², přechod z plynového kotle.</p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="bg-navy-700 rounded-xl p-6 text-white">
          <div class="space-y-0">
            {[
              { label: data.roi_price_label, value: data.roi_price, highlight: false },
              { label: data.roi_dotace_label, value: data.roi_dotace, highlight: false },
              { label: data.roi_net_label, value: data.roi_net, highlight: true },
              { label: data.roi_annual_savings_label, value: data.roi_annual_savings, highlight: false },
              { label: data.roi_payback_label, value: data.roi_payback, highlight: true },
            ].map(row => (
              <div class={`flex justify-between py-3 border-b border-navy-600 last:border-0 gap-4 ${row.highlight ? 'pt-4' : ''}`}>
                <span class={`text-sm ${row.highlight ? 'text-white font-semibold' : 'text-navy-200'}`}>{row.label}</span>
                <span class={`text-sm font-bold flex-shrink-0 ${row.highlight ? 'text-brand-400 text-base' : 'text-white'}`}>{row.value}</span>
              </div>
            ))}
          </div>
          <p class="text-navy-300 text-xs mt-4 leading-relaxed [&_a]:text-white [&_a]:underline [&_a]:underline-offset-2" set:html={data.roi_footnote}></p>
        </div>
        <div class="space-y-4">
          <div class="p-5 bg-green-50 border border-green-200 rounded-xl">
            <h3 class="font-bold text-green-800 mb-2 text-sm">Roční úspora oproti plynovému kotli</h3>
            <p class="text-green-700 text-sm leading-relaxed">Tepelné čerpadlo vzduch-voda vyjde na 1 kWh tepla zhruba na 1,20 Kč. Plynový kotel vychází na 2,10 Kč, elektrokotel na 3,40 Kč. U domu s roční potřebou 31 191 kWh to proti plynu znamená úsporu <strong>kolem 28 000 Kč</strong>, proti elektrokotli 69 000 Kč.</p>
          </div>
          <div class="p-5 bg-blue-50 border border-blue-200 rounded-xl">
            <h3 class="font-bold text-blue-800 mb-2 text-sm">Záruka 7 let a životnost</h3>
            <p class="text-blue-700 text-sm leading-relaxed">Master Therm dává <strong>7 let záruky na celé tepelné čerpadlo</strong>, ne jen na kompresor. Podmínkou je připojení čerpadla k internetu a servisní prohlídka jednou za dvě topné sezóny. Životnost čerpadla je okolo 20 let.</p>
          </div>
          <div class="p-5 bg-navy-50 border border-navy-200 rounded-xl">
            <h3 class="font-bold text-navy-800 mb-2 text-sm">Online správa v ceně</h3>
            <p class="text-navy-700 text-sm leading-relaxed">Internetový modul i přístup do online správy jsou součástí každého čerpadla — <strong>bez příplatku a bez měsíčních poplatků</strong>. Topení ovládáte z mobilu a my vidíme případnou poruchu dřív, než ji poznáte doma.</p>
          </div>
          <div class="p-5 bg-amber-50 border border-amber-200 rounded-xl">
            <h3 class="font-bold text-amber-800 mb-2 text-sm">Jak dlouho trvá montáž?</h3>
            <p class="text-amber-700 text-sm leading-relaxed">Vzduch-voda: <strong>2–5 dní</strong>. Země-voda s vrty: <strong>5–7 dní</strong> (z toho 1–2 dny vrtné práce). Voda-voda: <strong>5–7 dní</strong> podle podmínek studní.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": data.faq.map((item: {q: string, a: string}) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />

  <!-- FAQ sekce -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 mb-3">{data.faq_headline}</h2>
      <p class="text-charcoal-500 mb-8 max-w-2xl">Rozklikněte otázku, která vás zajímá.</p>
      <div class="max-w-4xl space-y-3">
        {data.faq.map((item: {q: string, a: string}, i: number) => (
          <details open={i === 0} class="group bg-white border border-gray-200 rounded-xl open:border-brand-200 open:shadow-sm transition-colors">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none px-6 py-4 font-bold text-charcoal-900 marker:hidden [&::-webkit-details-marker]:hidden hover:text-brand-500 transition-colors">
              {item.q}
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 group-open:bg-brand-50 flex items-center justify-center transition-colors mt-0.5">
                <svg class="w-4 h-4 text-charcoal-400 group-open:text-brand-500 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <p class="px-6 pb-5 -mt-1 text-charcoal-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Související stránky -->
  <section class="py-6">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">{data.tools_headline}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href="/cenova-kalkulace" data-place="cenik" class="group bg-white rounded-xl p-7 border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all">
          <img src="/images/ikony/cenova-kalkulace.webp" alt="Ikona cenové kalkulace" class="w-12 h-12 object-contain mb-4" />
          <h3 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{data.tool1_title}</h3>
