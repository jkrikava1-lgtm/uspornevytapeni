---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/cena.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero
    title={data.hero_title}
    subtitle={data.hero_subtitle}
    breadcrumb={[{ label: 'Cena', href: '/cena' }]}
  />

  <section class="pt-10 pb-16 lg:pt-12 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Úvod -->
      <div class="max-w-3xl mb-12">
        <h2 class="text-xl font-extrabold text-charcoal-900 mb-3">{data.intro_headline}</h2>
        <p class="text-charcoal-600 text-sm leading-relaxed mb-4" set:html={data.intro_text} />
        <div class="bg-brand-50 border border-brand-200 rounded-lg p-4">
          <p class="text-sm text-brand-800 leading-relaxed" set:html={data.intro_highlight} />
        </div>
      </div>

      <!-- Cenové tabulky -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {[
          {
            typ: data.price1_typ,
            rozsah: data.price1_rozsah,
            poznamka: data.price1_poznamka,
            body: [data.price1_body1, data.price1_body2, data.price1_body3],
            highlight: true,
          },
          {
            typ: data.price2_typ,
            rozsah: data.price2_rozsah,
            poznamka: data.price2_poznamka,
            body: [data.price2_body1, data.price2_body2, data.price2_body3],
            highlight: false,
          },
          {
            typ: data.price3_typ,
            rozsah: data.price3_rozsah,
            poznamka: data.price3_poznamka,
            body: [data.price3_body1, data.price3_body2, data.price3_body3],
            highlight: false,
          },
        ].map(item => (
          <div class={`rounded-xl p-7 border-2 ${item.highlight ? 'border-brand-500 bg-brand-50' : 'border-gray-200 bg-white'}`}>
            {item.highlight && <div class="text-xs text-brand-500 font-semibold uppercase tracking-wider mb-3">{data.highlight_badge}</div>}
            <h3 class="text-lg font-bold text-charcoal-900 mb-2">{item.typ}</h3>
            <div class="text-2xl font-extrabold text-navy-700 mb-1">{item.rozsah}</div>
            <div class="text-xs text-charcoal-400 mb-5">{item.poznamka}</div>
            <ul class="space-y-2">
              {item.body.map(b => (
                <li class="flex items-center gap-2 text-sm text-charcoal-600">
                  <svg class="w-4 h-4 text-brand-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6">{data.factors_headline}</h2>
          <div class="space-y-4">
            {[
              { title: data.factor1_title, desc: data.factor1_desc },
              { title: data.factor2_title, desc: data.factor2_desc },
              { title: data.factor3_title, desc: data.factor3_desc },
              { title: data.factor4_title, desc: data.factor4_desc },
            ].map(item => (
              <div class="flex gap-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                <div class="w-8 h-8 bg-navy-700 rounded-md flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-charcoal-900 text-sm">{item.title}</div>
                  <div class="text-sm text-charcoal-500 mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-navy-700 rounded-2xl p-8 text-white">
          <div class="text-brand-400 text-sm font-semibold uppercase tracking-wider mb-4">{data.roi_label}</div>
          <h3 class="text-xl font-extrabold mb-6">{data.roi_headline}</h3>
          <div class="space-y-5">
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="text-navy-300">{data.roi_annual_savings_label}</span>
                <span class="font-bold">{data.roi_annual_savings}</span>
              </div>
              <div class="flex justify-between text-sm mb-2">
                <span class="text-navy-300">{data.roi_price_label}</span>
                <span class="font-bold">{data.roi_price}</span>
              </div>
              <div class="flex justify-between text-sm mb-2">
                <span class="text-navy-300">{data.roi_dotace_label}</span>
                <span class="font-bold text-brand-400">{data.roi_dotace}</span>
              </div>
              <div class="border-t border-navy-600 pt-3 mt-3">
                <div class="flex justify-between text-sm">
                  <span class="text-navy-300">{data.roi_net_label}</span>
                  <span class="font-bold text-white">{data.roi_net}</span>
                </div>
                <div class="flex justify-between text-sm mt-1">
                  <span class="text-navy-300">{data.roi_payback_label}</span>
                  <span class="font-extrabold text-brand-400 text-lg">{data.roi_payback}</span>
                </div>
              </div>
            </div>
          </div>
          <p class="text-xs text-navy-400 mt-6">{data.roi_footnote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Související stránky -->
  <section class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-extrabold text-charcoal-900 mb-5">{data.tools_headline}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href="/cenova-kalkulace" class="group bg-white rounded-xl p-7 border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all">
          <div class="w-11 h-11 bg-brand-50 group-hover:bg-brand-500 rounded-lg flex items-center justify-center mb-4 transition-colors">
            <svg class="w-5 h-5 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{data.tool1_title}</h3>
          <p class="text-sm text-charcoal-500 leading-relaxed mb-3">{data.tool1_desc}</p>
          <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
            {data.tool1_cta}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
        <a href="/porovnani-nakladu" class="group bg-white rounded-xl p-7 border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all">
          <div class="w-11 h-11 bg-brand-50 group-hover:bg-brand-500 rounded-lg flex items-center justify-center mb-4 transition-colors">
            <svg class="w-5 h-5 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{data.tool2_title}</h3>
          <p class="text-sm text-charcoal-500 leading-relaxed mb-3">{data.tool2_desc}</p>
          <span class="text-sm font-semibold text-brand-500 flex items-center gap-1">
            {data.tool2_cta}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-3">{data.cta_headline}</h2>
      <p class="text-charcoal-500 mb-8">{data.cta_text}</p>
      <a href="/poptavka" class="inline-flex items-center justify-center px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-md transition-colors">
        {data.cta_button}
      </a>
    </div>
  </section>
</Layout>
