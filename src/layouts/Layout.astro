---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href: string }[];
  /** Dopadové stránky (PPC): jen logo + telefon + CTA. Čím míň odboček, tím víc poptávek. */
  simpleNav?: boolean;
  /** Cíl hlavního CTA v hlavičce — u LP kotva na formulář na stránce. */
  ctaHref?: string;
  /** Firemní podpis za titulkem. Zkrácený, aby se titulek vešel do výpisu
   *  Googlu (~60 znaků). Stránky s domluveným zněním titulku posílají site.name. */
  titleSuffix?: string;
  heroImg?: string;
}

const { title, description = 'Tepelná čerpadla a úsporné vytápění. Navrhujeme, dodáváme a servisujeme systémy na míru.', breadcrumbs, simpleNav = false, ctaHref = '/poptavka', titleSuffix = site.name_short, heroImg } = Astro.props;
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Úvod", "item": "https://uspornevytapeni.cz" },
    ...breadcrumbs.map((b, i) => ({ "@type": "ListItem", "position": i + 2, "name": b.label, "item": `https://uspornevytapeni.cz${b.href}` }))
  ]
} : null;
const canonicalURL = new URL(Astro.url.pathname, 'https://uspornevytapeni.cz');
const ogImage = 'https://uspornevytapeni.cz/images/hero/boxairy-strecha.webp';

const navGroups = [
  { label: site.nav_navrh, href: '/navrh-reseni', items: site.nav_navrh_items, width: 'w-64' },
  { label: site.nav_tc, href: '/tepelna-cerpadla', items: site.nav_tc_items, width: 'w-56' },
  { label: site.nav_funkce, href: '/chytre-funkce', items: site.nav_funkce_items, width: 'w-72' },
  { label: site.nav_katalog, href: '/katalog', items: site.nav_katalog_items, width: 'w-52' },
  { label: site.nav_cena, href: '/cena', items: site.nav_cena_items, width: 'w-52' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="seznam-wmt" content="VZLutCQRBcU0HCpPb1dH0vNGZMjDRvbo" />
    <meta name="seznam-wmt" content="cQejZgn0VQKVi9Ga4opIWK8lklJLgOQT" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    {heroImg && <link rel="preload" as="image" href={heroImg} fetchpriority="high" media="(min-width: 1024px)" />}
    <title>{title} | {titleSuffix}</title>
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${titleSuffix}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${titleSuffix}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Úsporné vytápění s.r.o.",
      "description": "Navrhujeme a instalujeme tepelná čerpadla a systémy úsporného vytápění od roku 2006.",
      "url": "https://uspornevytapeni.cz",
      "telephone": "+420777724573",
      "email": "info@uspornevytapeni.cz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dělnická 395",
        "addressLocality": "Jičín",
        "postalCode": "506 01",
        "addressCountry": "CZ"
      },
      "foundingDate": "2006",
      "areaServed": {
        "@type": "Country",
        "name": "Česká republika"
      },
      "priceRange": "$$",
      "image": "https://uspornevytapeni.cz/images/hero/boxairy-strecha.webp",
      "knowsAbout": [
        "tepelná čerpadla vzduch-voda",
        "tepelná čerpadla země-voda",
        "tepelná čerpadla voda-voda",
        "geotermální vytápění",
        "podlahové vytápění",
        "úsporné vytápění",
        "Nová zelená úsporám",
        "inverterová tepelná čerpadla",
        "Master Therm"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Instalace tepelných čerpadel",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tepelné čerpadlo vzduch-voda", "url": "https://uspornevytapeni.cz/tepelna-cerpadla/vzduch-voda" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tepelné čerpadlo země-voda", "url": "https://uspornevytapeni.cz/tepelna-cerpadla/zeme-voda" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tepelné čerpadlo voda-voda", "url": "https://uspornevytapeni.cz/tepelna-cerpadla/voda-voda" } }
        ]
      },
      "openingHours": ["Mo-Fr 08:00-17:00"],
      "sameAs": ["https://share.google/66F7YjcrxXkEXskH6", "https://www.firmy.cz/detail/2538489-usporne-vytapeni-s-r-o-tepelna-cerpadla-jicin-valdicke-predmesti.html"]
    })} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <!-- Consent Mode v2 — musí být synchronní a PŘED načtením gtag.js -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }

      /* ── Vyloučení vlastních návštěv z měření ───────────────────────
         Zapne se otevřením libovolné stránky s ?bez-mereni=1, vypne
         přes ?bez-mereni=0. Volba se pamatuje v prohlížeči, takže stačí
         jednou na každém zařízení a prohlížeči.
         GA4 a Google Ads se vypínají oficiálním přepínačem ga-disable-*,
         Sklik a Clarity se na uvBezMereni() ptají samy níž v kódu.
      ─────────────────────────────────────────────────────────────── */
      window.UV_VYLOUCENI_KEY = 'uv-bez-mereni';
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('bez-mereni');
          if (q === '1') localStorage.setItem(window.UV_VYLOUCENI_KEY, '1');
          else if (q === '0') localStorage.removeItem(window.UV_VYLOUCENI_KEY);
        } catch (e) {}
      })();

      window.uvBezMereni = function () {
        try { return localStorage.getItem(window.UV_VYLOUCENI_KEY) === '1'; }
        catch (e) { return false; }
      };

      if (window.uvBezMereni()) {
        window['ga-disable-G-QYVPWZ4YR7'] = true;
        window['ga-disable-AW-1019513575'] = true;
      }

      window.CONSENT_KEY = 'uv-consent-v2';
      window.CONSENT_TTL_DAYS = 365;

      window.readConsent = function () {
        try {
          var raw = localStorage.getItem(window.CONSENT_KEY);
          if (raw) {
            var c = JSON.parse(raw);
            if (c && c.timestamp && (Date.now() - c.timestamp) < window.CONSENT_TTL_DAYS * 86400000) return c;
            return null;
          }
          // převod staršího souhlasu: analytika ano, marketing NE (na ten souhlas nebyl)
          var old = localStorage.getItem('cookie-consent');
          if (old === 'accepted' || old === 'analytics') {
            return { version: 1, timestamp: Date.now(), analytics: true, marketing: false, migrated: true };
          }
          if (old === 'rejected') {
            return { version: 1, timestamp: Date.now(), analytics: false, marketing: false, migrated: true };
          }
          return null;
        } catch (e) { return null; }
      };

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('set', 'url_passthrough', true);
      gtag('set', 'ads_data_redaction', true);

      (function () {
        var c = window.readConsent();
        if (!c) return;
        gtag('consent', 'update', {
          analytics_storage: c.analytics ? 'granted' : 'denied',
          ad_storage:        c.marketing ? 'granted' : 'denied',
          ad_user_data:      c.marketing ? 'granted' : 'denied',
          ad_personalization: c.marketing ? 'granted' : 'denied'
        });
      })();
    </script>
    <!-- gtag.js se načítá VŽDY; bez souhlasu neukládá nic a posílá jen anonymní signál.
         Výjimkou je vyloučení vlastních návštěv (?bez-mereni=1) — tam se
         nenačítá vůbec. Samotný přepínač ga-disable-* totiž umlčí GA4, ale
         NE reklamní tag: ten i tak odešle remarketingový zásah do Google Ads.
         Jediné spolehlivé řešení je gtag.js vůbec nespustit. -->
    <script is:inline>
      window.addEventListener('load', function () {
        if (window.uvBezMereni && window.uvBezMereni()) return;
        var t = document.createElement('script');
        t.async = true;
        t.src = 'https://www.googletagmanager.com/gtag/js?id=G-QYVPWZ4YR7';
        document.head.appendChild(t);
        gtag('js', new Date());
        gtag('config', 'G-QYVPWZ4YR7');
        gtag('config', 'AW-1019513575');
      });
    </script>
    <!-- Google Tag Manager — načítá se po load, consent defaults jsou v dataLayer výš -->
    <script is:inline>
      window.addEventListener('load', function () {
        if (window.uvBezMereni && window.uvBezMereni()) return;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;
        f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-W9PGNXHG');
      });
    </script>
  </head>
  <body class="antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9PGNXHG"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- ═══ Cookie lišta — první vrstva (přijmout / odmítnout rovnocenně) ═══ -->
    <div id="cookie-banner" class="fixed inset-0 z-[100] hidden">
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[calc(100%-2rem)] max-w-md bg-white border border-gray-200 rounded-2xl shadow-2xl p-7">
        <div class="w-10 h-10 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
          <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h2 class="text-lg font-bold text-charcoal-800 mb-2">Tento web používá cookies</h2>
        <p class="text-charcoal-500 text-sm leading-relaxed mb-3">
          Nezbytné cookies zajišťují chod webu. S vaším souhlasem měříme také návštěvnost (Google Analytics) a účinnost reklamy (Google Ads, Sklik). Souhlas můžete kdykoli změnit v patičce webu.
        </p>
        <a href="/gdpr" class="inline-block text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors mb-6">Zásady ochrany osobních údajů</a>
        <div class="space-y-2.5">
          <div class="grid grid-cols-2 gap-2.5">
            <button id="cookie-accept-1" class="py-3 bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold rounded-lg transition-colors">Přijmout vše</button>
            <button id="cookie-reject-1" class="py-3 bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold rounded-lg transition-colors">Odmítnout vše</button>
          </div>
          <button id="cookie-settings" class="w-full py-2.5 text-sm text-charcoal-500 hover:text-charcoal-700 underline underline-offset-4 transition-colors">Nastavení</button>
        </div>
      </div>
    </div>

    <!-- ═══ Cookie lišta — druhá vrstva (nastavení) ═══ -->
    <div id="cookie-modal" class="fixed inset-0 z-[200] hidden">
      <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
      <div class="absolute bottom-0 left-0 right-0 sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:w-full sm:max-w-lg bg-white border border-gray-200 sm:rounded-xl shadow-2xl p-6">
        <h3 class="text-xl font-bold text-charcoal-800 mb-1">Nastavení cookies</h3>
        <p class="text-sm text-charcoal-500 mb-6">Vyberte, které cookies povolíte. Nezbytné jsou vždy aktivní.</p>
        <div class="mb-6">
          <div class="flex items-start justify-between gap-4 py-3 border-b border-gray-100">
            <div class="flex-1">
              <p class="text-sm font-semibold text-charcoal-700">Nezbytné</p>
              <p class="text-xs text-gray-400 mt-0.5">Zajišťují základní funkce webu, nelze vypnout.</p>
            </div>
            <div class="flex-shrink-0 w-10 h-6 bg-brand-500 rounded-full opacity-40 cursor-not-allowed relative mt-0.5" aria-hidden="true">
              <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
            </div>
          </div>
          <div class="flex items-start justify-between gap-4 py-3 border-b border-gray-100">
            <div class="flex-1">
              <p class="text-sm font-semibold text-charcoal-700">Analytické</p>
              <p class="text-xs text-gray-400 mt-0.5">Google Analytics 4, měření návštěvnosti a chování na webu.</p>
            </div>
            <button data-consent-toggle="analytics" role="switch" aria-checked="false" aria-label="Analytické cookies"
              class="flex-shrink-0 w-10 h-6 rounded-full transition-colors duration-200 bg-gray-200 relative mt-0.5">
              <div class="absolute top-1 w-4 h-4 bg-white rounded-full shadow transition-all duration-200 left-1"></div>
            </button>
          </div>
          <div class="flex items-start justify-between gap-4 py-3">
            <div class="flex-1">
              <p class="text-sm font-semibold text-charcoal-700">Marketingové</p>
              <p class="text-xs text-gray-400 mt-0.5">Měření konverzí a účinnosti reklamy v Google Ads a Sklik.</p>
            </div>
            <button data-consent-toggle="marketing" role="switch" aria-checked="false" aria-label="Marketingové cookies"
              class="flex-shrink-0 w-10 h-6 rounded-full transition-colors duration-200 bg-gray-200 relative mt-0.5">
              <div class="absolute top-1 w-4 h-4 bg-white rounded-full shadow transition-all duration-200 left-1"></div>
            </button>
          </div>
        </div>
        <div class="space-y-2.5">
          <button id="cookie-save" class="w-full py-2.5 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-lg transition-colors">Uložit volbu</button>
          <div class="grid grid-cols-2 gap-2.5">
            <button id="cookie-accept-2" class="py-2.5 text-sm font-semibold text-charcoal-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">Přijmout vše</button>
            <button id="cookie-reject-2" class="py-2.5 text-sm font-semibold text-charcoal-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">Odmítnout vše</button>
          </div>
        </div>
        <a href="/gdpr" class="block mt-4 text-center text-xs text-charcoal-400 hover:text-brand-500 transition-colors">Zásady ochrany osobních údajů</a>
      </div>
    </div>

    <script is:inline>
      (function () {
        if (window.location.search.indexOf('reset-cookies') !== -1) {
          try {
            localStorage.removeItem(window.CONSENT_KEY);
            localStorage.removeItem('cookie-consent');
          } catch (e) {}
          window.location.href = window.location.pathname;
          return;
        }

        var banner = document.getElementById('cookie-banner');
        var modal  = document.getElementById('cookie-modal');
        var toggles = {};

        function setToggle(btn, on) {
          btn.setAttribute('aria-checked', String(on));
          btn.classList.toggle('bg-brand-500', on);
          btn.classList.toggle('bg-gray-200', !on);
          var knob = btn.firstElementChild;
          knob.classList.toggle('right-1', on);
          knob.classList.toggle('left-1', !on);
        }
        function isOn(name) {
          return !!(toggles[name] && toggles[name].getAttribute('aria-checked') === 'true');
        }

        Array.prototype.forEach.call(document.querySelectorAll('[data-consent-toggle]'), function (btn) {
          toggles[btn.getAttribute('data-consent-toggle')] = btn;
          btn.addEventListener('click', function () {
            setToggle(btn, btn.getAttribute('aria-checked') !== 'true');
          });
        });

        function hideUI() {
          banner.classList.add('hidden');
          modal.classList.add('hidden');
        }

        window.saveConsent = function (analytics, marketing) {
          var payload = {
            version: 2,
            timestamp: Date.now(),
            analytics: !!analytics,
            marketing: !!marketing
          };
          try { localStorage.setItem(window.CONSENT_KEY, JSON.stringify(payload)); } catch (e) {}
          try { localStorage.removeItem('cookie-consent'); } catch (e) {}

          gtag('consent', 'update', {
            analytics_storage: payload.analytics ? 'granted' : 'denied',
            ad_storage:        payload.marketing ? 'granted' : 'denied',
            ad_user_data:      payload.marketing ? 'granted' : 'denied',
            ad_personalization: payload.marketing ? 'granted' : 'denied'
          });

          document.dispatchEvent(new CustomEvent('uv-consent-updated', { detail: payload }));
          hideUI();
        };

        window.openCookieSettings = function () {
          var c = window.readConsent() || { analytics: false, marketing: false };
          if (toggles.analytics) setToggle(toggles.analytics, !!c.analytics);
          if (toggles.marketing) setToggle(toggles.marketing, !!c.marketing);
          banner.classList.add('hidden');
          modal.classList.remove('hidden');
        };

        function on(id, fn) {
          var el = document.getElementById(id);
          if (el) el.addEventListener('click', fn);
        }
        on('cookie-accept-1', function () { window.saveConsent(true, true); });
        on('cookie-reject-1', function () { window.saveConsent(false, false); });
        on('cookie-accept-2', function () { window.saveConsent(true, true); });
        on('cookie-reject-2', function () { window.saveConsent(false, false); });
        on('cookie-save',     function () { window.saveConsent(isOn('analytics'), isOn('marketing')); });
        on('cookie-settings', window.openCookieSettings);

        // Zavření klikem mimo se nepočítá jako souhlas — lišta se vrátí.
        if (modal) {
          modal.addEventListener('click', function (e) {
            if (e.target === this || e.target === this.firstElementChild) {
              modal.classList.add('hidden');
              if (!window.readConsent()) banner.classList.remove('hidden');
            }
          });
        }

        if (!window.readConsent()) banner.classList.remove('hidden');
      })();
    </script>

    <!-- Měřicí kód Seznamu (Sklik) — načítá se po page load, souhlas se předává parametrem consent -->
    <script is:inline>
      window.addEventListener('load', function () {
        if (window.uvBezMereni && window.uvBezMereni()) return;
        var t = document.createElement('script');
        t.src = 'https://c.seznam.cz/js/rc.js';
        t.defer = true;
        document.head.appendChild(t);
      });
    </script>

    <!-- ═══ Měřicí modul — všechny události chodí přes uvTrack() ═══ -->
    <script is:inline>
    (function () {
      var ADS_ID       = 'AW-1019513575';
      var SKLIK_RTG_ID = 14594;   // ID retargetingového publika Sklik

      var KONVERZE = {
        poptavka:  { adsLabel: 'LULNCLWp9PEcEOeVkuYD', hodnota: 400, sklikId: 100060861 },
        kalkulace: { adsLabel: 'WgJ2CLip9PEcEOeVkuYD', hodnota: 400, sklikId: 100060862 },
        telefon:   { adsLabel: 'wxm9CLup9PEcEOeVkuYD', hodnota: 200, sklikId: 100288614 },
        email:     { adsLabel: 'QcR7CI3j9fEcEOeVkuYD', hodnota: 100, sklikId: 100288615 }
      };

      window.uvMarketingConsent = function () {
        try {
          var c = window.readConsent && window.readConsent();
          return !!(c && c.marketing);
        } catch (e) { return false; }
      };

      function normalizePhone(t) {
        if (!t) return '';
        var d = String(t).replace(/[^\d+]/g, '');
        if (d.indexOf('+') === 0) return d;
        if (d.length === 9) return '+420' + d;
        if (d.indexOf('420') === 0) return '+' + d;
        return d;
      }
      window.uvNormalizePhone = normalizePhone;

      // rc.js se načítá s defer, při rychlé akci nemusí být hotový — krátce počkáme (max 3 s)
      function sklikConversion(id, hodnota, userData) {
        var pokus = 0;
        (function odesli() {
          if (window.rc && window.rc.conversionHit) {
            var souhlas = window.uvMarketingConsent() ? 1 : 0;
            if (souhlas && userData && window.sznIVA && window.sznIVA.IS) {
              window.sznIVA.IS.updateIdentities({
                eid: (userData.email || '').trim().toLowerCase(),
                tid: normalizePhone(userData.telefon)
              });
            }
            window.rc.conversionHit({ id: id, value: hodnota, consent: souhlas });
            return;
          }
          if (pokus++ < 30) setTimeout(odesli, 100);
        })();
      }

      window.uvTrack = function (name, params, opts) {
        if (window.uvBezMereni && window.uvBezMereni()) return;
        params = params || {};
        opts = opts || {};
        var k = opts.konverze ? KONVERZE[opts.konverze] : null;

        if (typeof gtag === 'function') gtag('event', name, params);
        if (!k) return;

        if (typeof gtag === 'function' && ADS_ID && k.adsLabel) {
          if (opts.userData) {
            // vylepšené konverze: gtag hodnoty zahashuje sám, nešifrované web neopustí
            gtag('set', 'user_data', {
              email: (opts.userData.email || '').trim().toLowerCase(),
              phone_number: normalizePhone(opts.userData.telefon)
            });
          }
          gtag('event', 'conversion', {
            send_to: ADS_ID + '/' + k.adsLabel,
            value: k.hodnota,
            currency: 'CZK'
          });
        }

        if (k.sklikId) sklikConversion(k.sklikId, k.hodnota, opts.userData);
      };

      // ── Kliknutí na telefon, e-mail a kalkulačku ──
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var place = a.getAttribute('data-place') || 'neurceno';

        if (href.indexOf('tel:') === 0) {
          window.uvTrack('klik_telefon', { umisteni: place }, { konverze: 'telefon' });
        } else if (href.indexOf('mailto:') === 0) {
          window.uvTrack('klik_email', { umisteni: place }, { konverze: 'email' });
        } else if (href.indexOf('/cenova-kalkulace') === 0) {
          window.uvTrack('klik_kalkulacka', { umisteni: place });
        }
      });

      // ── Sklik retargeting (aktivuje se doplněním SKLIK_RTG_ID) ──
      function retargetingHit(consent) {
        if (window.uvBezMereni && window.uvBezMereni()) return;
        if (!SKLIK_RTG_ID || !window.rc || !window.rc.retargetingHit) return;
        window.rc.retargetingHit({ rtgId: SKLIK_RTG_ID, consent: consent });
      }
      if (SKLIK_RTG_ID) {
        var pokusRtg = 0;
        (function cekej() {
          if (window.rc && window.rc.retargetingHit) {
            retargetingHit(window.uvMarketingConsent() ? 1 : 0);
            return;
          }
          if (pokusRtg++ < 30) setTimeout(cekej, 100);
        })();
      }
      document.addEventListener('uv-consent-updated', function (e) {
        if (e.detail && e.detail.marketing) retargetingHit(1);
      });
    })();

    /* ── Microsoft Clarity ──────────────────────────────────────────────
       Nahrávky relací a mapy rolování. Spadá do kategorie „analytika",
       takže se načte teprve po souhlasu — nikdy dřív. Když návštěvník
       souhlas udělí až dodatečně přes lištu, chytneme to na události
