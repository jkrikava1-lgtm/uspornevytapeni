---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Tepelná čerpadla a úsporné vytápění. Navrhujeme, dodáváme a servisujeme systémy na míru.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://uspornevytapeni.cz');
const ogImage = 'https://uspornevytapeni.cz/images/hero/boxairy-strecha.jpg';

const navGroups = [
  { label: site.nav_navrh, href: '/navrh-reseni', items: site.nav_navrh_items, width: 'w-64' },
  { label: site.nav_tc, href: '/tepelna-cerpadla', items: site.nav_tc_items, width: 'w-56' },
  { label: site.nav_funkce, href: '/chytre-funkce', items: site.nav_funkce_items, width: 'w-72' },
  { label: site.nav_katalog, href: '/katalog', items: site.nav_katalog_items, width: 'w-52' },
  { label: site.nav_cena, href: '/cena', items: site.nav_cena_items, width: 'w-52' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="seznam-wmt" content="VZLutCQRBcU0HCpPb1dH0vNGZMjDRvbo" />
    <meta name="seznam-wmt" content="cQejZgn0VQKVi9Ga4opIWK8lklJLgOQT" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <title>{title} | {site.name}</title>
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${site.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Úsporné vytápění s.r.o.",
      "description": "Navrhujeme a instalujeme tepelná čerpadla a systémy úsporného vytápění od roku 2006.",
      "url": "https://uspornevytapeni.cz",
      "telephone": "+420777724573",
      "email": "info@uspornevytapeni.cz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dělnická 395",
        "addressLocality": "Jičín",
        "postalCode": "506 01",
        "addressCountry": "CZ"
      },
      "foundingDate": "2006",
      "areaServed": "CZ",
      "priceRange": "$$",
      "image": "https://uspornevytapeni.cz/images/hero/boxairy-strecha.jpg",
      "sameAs": []
    })} />
    <!-- GA4 - načte se až po souhlasu s cookies -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
    </script>
  </head>
  <body class="antialiased">

    <!-- Cookies lišta -->
    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[100] bg-white border-t border-gray-200 shadow-lg p-4 sm:p-6 hidden">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <p class="text-sm text-charcoal-600 flex-1">
          Tento web používá cookies pro měření návštěvnosti (Google Analytics). Pokračováním souhlasíte s jejich použitím.
          <a href="/gdpr" class="text-brand-500 hover:underline ml-1">Více informací</a>
        </p>
        <div class="flex gap-3 flex-shrink-0">
          <button id="cookie-reject" class="px-4 py-2 text-sm font-semibold text-charcoal-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">Odmítnout</button>
          <button id="cookie-accept" class="px-4 py-2 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-600 rounded-lg transition-colors">Přijmout</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        if (window.location.search.indexOf('reset-cookies') !== -1) {
          localStorage.removeItem('cookie-consent');
          window.location.href = window.location.pathname;
          return;
        }
        var consent = localStorage.getItem('cookie-consent');
        if (consent === 'accepted') {
          loadGA();
        } else if (consent !== 'rejected') {
          document.getElementById('cookie-banner').classList.remove('hidden');
        }
        document.getElementById('cookie-accept')?.addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'accepted');
          document.getElementById('cookie-banner').classList.add('hidden');
          loadGA();
        });
        document.getElementById('cookie-reject')?.addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'rejected');
          document.getElementById('cookie-banner').classList.add('hidden');
        });
        function loadGA() {
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-QYVPWZ4YR7';
          s.async = true;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', 'G-QYVPWZ4YR7');
        }
      })();
    </script>

    <header id="header" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200 transition-shadow duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Mobile layout -->
        <div class="flex items-center justify-between h-16 lg:hidden">
          <a href="/" class="flex items-center flex-shrink-0">
            <img src="/logo-cropped.png" alt={site.name} class="h-10 w-auto" />
          </a>
          <div class="flex items-center gap-2">
            <a href="/poptavka" class="inline-flex items-center px-3 py-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-md transition-colors">
              {site.nav_poptavka}
            </a>
            <button id="mobile-menu-toggle" class="relative w-9 h-9 flex items-center justify-center text-charcoal-600 hover:text-brand-500 hover:bg-gray-50 rounded-md" aria-label={site.aria_open_menu} aria-expanded="false">
              <span class="sr-only">Menu</span>
              <svg id="icon-hamburger" class="w-5 h-5 transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
              <svg id="icon-close" class="w-5 h-5 absolute transition-opacity duration-200 opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Desktop: logo vlevo, nav vpravo ve dvou řádcích -->
        <div class="hidden lg:flex" style="height:80px;">

          <!-- Logo: vyplňuje celou výšku -->
          <a href="/" class="flex items-center flex-shrink-0 pr-6 border-r border-gray-100">
            <img src="/logo-cropped.png" alt={site.name} style="height:56px;width:auto;" />
          </a>

          <!-- Nav sloupec: dva řádky -->
          <div class="flex-1 flex flex-col pl-4">

            <!-- Řádek 1: sekundární nav -->
            <div class="flex items-center justify-end gap-1 h-10 border-b border-gray-100">
              <a href="/o-nas" class="px-3 py-1 text-xs text-charcoal-500 hover:text-brand-500 rounded hover:bg-gray-50 transition-colors">{site.nav_o_nas}</a>
              <a href="/kontakty" class="px-3 py-1 text-xs text-charcoal-500 hover:text-brand-500 rounded hover:bg-gray-50 transition-colors">{site.nav_kontakty}</a>
            </div>

            <!-- Řádek 2: hlavní nav -->
            <nav class="flex items-center justify-end gap-1 h-10">

          {navGroups.map(group => (
            <div class="relative" data-nav-group>
              <a href={group.href} class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-charcoal-700 hover:text-brand-500 rounded-md hover:bg-gray-50 transition-colors">
                {group.label}
                <svg class="w-3.5 h-3.5 text-gray-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>
              <div data-nav-dropdown style="opacity:0;visibility:hidden;pointer-events:none;" class={`absolute top-full left-0 mt-1 ${group.width} bg-white rounded-lg shadow-lg border border-gray-100 transition-opacity duration-150 py-1 z-50`}>
                {group.items.map(item => (
                  <a href={item.href} class="block px-4 py-2.5 text-sm text-charcoal-700 hover:bg-gray-50 hover:text-brand-500">{item.label}</a>
                ))}
              </div>
            </div>
          ))}
          <a href="/reference" class="px-3 py-2 text-sm font-medium text-charcoal-700 hover:text-brand-500 rounded-md hover:bg-gray-50 transition-colors">{site.nav_reference}</a>
          <a href="/dotace" class="px-3 py-2 text-sm font-medium text-charcoal-700 hover:text-brand-500 rounded-md hover:bg-gray-50 transition-colors">{site.nav_dotace}</a>
          <a href="/poptavka" class="inline-flex items-center px-3 py-1.5 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-md transition-colors whitespace-nowrap">
            {site.nav_poptavka}
          </a>
            </nav>

          </div><!-- /nav sloupec -->

        </div><!-- /desktop flex -->

      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white overflow-y-auto" style="max-height:calc(100dvh - 64px);">
        <nav class="max-w-7xl mx-auto px-4 py-3">

          {navGroups.map(group => (
            <div class="border-b border-gray-100" data-mobile-accordion>
              <div class="flex items-center justify-between" data-mobile-trigger>
                <a href={group.href} class="flex-1 px-3 py-3 text-sm font-semibold text-charcoal-800 hover:text-brand-500">{group.label}</a>
                <button class="px-3 py-3" aria-label={site.aria_expand_sub}>
                  <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" data-mobile-chevron fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
              </div>
              <div class="hidden pb-2 pl-3" data-mobile-panel>
                {group.items.map(item => (
                  <a href={item.href} class="block px-3 py-2 text-sm text-charcoal-600 hover:text-brand-500 hover:bg-gray-50 rounded-md">{item.label}</a>
                ))}
                {group.label === site.nav_cena && site.nav_cena_mobile_extra.map(item => (
                  <a href={item.href} class="block px-3 py-2 text-sm text-charcoal-600 hover:text-brand-500 hover:bg-gray-50 rounded-md">{item.label}</a>
                ))}
              </div>
            </div>
          ))}

          <!-- Přímé odkazy -->
          <a href="/reference" class="block px-3 py-3 text-sm font-semibold text-charcoal-800 border-b border-gray-100 hover:text-brand-500">{site.nav_reference}</a>
          <a href="/dotace" class="block px-3 py-3 text-sm font-semibold text-charcoal-800 border-b border-gray-100 hover:text-brand-500">{site.nav_dotace}</a>
          <a href="/o-nas" class="block px-3 py-3 text-sm font-semibold text-charcoal-800 border-b border-gray-100 hover:text-brand-500">{site.nav_o_nas}</a>
          <a href="/kontakty" class="block px-3 py-3 text-sm font-semibold text-charcoal-800 border-b border-gray-100 hover:text-brand-500">{site.nav_kontakty}</a>

          <!-- CTA -->
          <div class="pt-4 pb-2">
            <a href="/poptavka" class="block w-full text-center px-4 py-3 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg transition-colors">
              {site.nav_poptavka_mobile}
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-navy-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

          <div class="lg:col-span-1">
            <div class="mb-5 flex items-center gap-3">
              <img src="/images/logo-icon.png" alt="Úsporné vytápění logo" class="w-10 h-10 rounded-lg flex-shrink-0" />
              <div>
                <div class="font-extrabold text-white text-sm leading-tight">{site.name}</div>
                <div class="text-[10px] text-navy-200 font-semibold tracking-widest uppercase">Tepelná čerpadla</div>
              </div>
            </div>
            <p class="text-sm text-navy-100 leading-relaxed mb-6">
              {site.footer_desc}
            </p>
            <div class="space-y-2 text-sm text-navy-100">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <a href={site.phone_href} class="hover:text-white transition-colors">{site.phone}</a>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">{site.email}</a>
              </div>
            </div>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">{site.footer_col1_title}</h4>
            <ul class="space-y-2 text-sm text-navy-100">
              {site.footer_col1_items.map(item => (
                <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">{site.footer_col2_title}</h4>
            <ul class="space-y-2 text-sm text-navy-100">
              {site.footer_col2_items.map(item => (
                <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">{site.footer_col3_title}</h4>
            <ul class="space-y-2 text-sm text-navy-100">
              {site.footer_col3_items.map(item => (
                <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-navy-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-navy-200">
          <p>{site.footer_copyright}</p>
          <p>{site.footer_made_in}</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconHamburger = document.getElementById('icon-hamburger');
      const iconClose = document.getElementById('icon-close');
      toggle?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden');
        if (isOpen) {
          iconHamburger?.classList.remove('opacity-0');
          iconClose?.classList.add('opacity-0');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          iconHamburger?.classList.add('opacity-0');
          iconClose?.classList.remove('opacity-0');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });

      // Mobile accordion
      document.querySelectorAll('[data-mobile-accordion]').forEach(acc => {
        const triggerBtn = acc.querySelector('[data-mobile-trigger] button');
        const panel = acc.querySelector('[data-mobile-panel]') as HTMLElement | null;
        const chevron = acc.querySelector('[data-mobile-chevron]') as HTMLElement | null;
        triggerBtn?.addEventListener('click', () => {
          const isOpen = !panel?.classList.contains('hidden');
          if (isOpen) {
            panel?.classList.add('hidden');
            chevron?.style.setProperty('transform', 'rotate(0deg)');
          } else {
            panel?.classList.remove('hidden');
            chevron?.style.setProperty('transform', 'rotate(180deg)');
          }
        });
      });
      const header = document.getElementById('header');
      window.addEventListener('scroll', () => {
        header?.classList.toggle('shadow-md', window.scrollY > 10);
      });

      // Desktop nav dropdowns
      document.querySelectorAll('[data-nav-group]').forEach(group => {
        const dd = group.querySelector('[data-nav-dropdown]') as HTMLElement | null;
        if (!dd) return;
        let t: ReturnType<typeof setTimeout>;
        const show = () => {
          clearTimeout(t);
          dd.style.opacity = '1';
          dd.style.visibility = 'visible';
          dd.style.pointerEvents = 'auto';
        };
        const hide = () => {
          t = setTimeout(() => {
            dd.style.opacity = '0';
            dd.style.visibility = 'hidden';
            dd.style.pointerEvents = 'none';
          }, 150);
        };
        group.addEventListener('mouseenter', show);
        group.addEventListener('mouseleave', hide);
        dd.addEventListener('mouseenter', show);
        dd.addEventListener('mouseleave', hide);
      });
    </script>
  </body>
</html>
