    ──────────────────────────────────────────────────────────────────── */
    (function () {
      var CLARITY_ID = 'ymqwhclwvu';
      var nacteno = false;

      function nactiClarity() {
        if (nacteno || !CLARITY_ID) return;
        if (window.uvBezMereni && window.uvBezMereni()) return;
        nacteno = true;
        (function (c, l, a, r, i, t, y) {
