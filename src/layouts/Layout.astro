        if (!(window.uvBezMereni && window.uvBezMereni())) return;
        function zobraz() {
          var d = document.createElement('div');
          d.textContent = 'měření vypnuté';
          d.title = 'Vaše návštěvy se nezapočítávají. Vypnout tuto výjimku: přidejte k adrese ?bez-mereni=0';
          d.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:2147483647;' +
            'background:#1C1C1C;color:#fff;font:600 11px/1 system-ui,sans-serif;' +
            'padding:6px 9px;border-radius:6px;opacity:.65;pointer-events:none;' +
            'letter-spacing:.02em';
          document.body.appendChild(d);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', zobraz);
        } else { zobraz(); }
      })();
