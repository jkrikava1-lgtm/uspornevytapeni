---
// Vložené YouTube video přes "fasádu": do kliknutí se zobrazuje jen náhled
// z našeho serveru. Standardní <iframe> by stáhl skoro megabajt skriptů
// a hlavně nasadil cookies Googlu ještě před souhlasem v liště.
// Po kliknutí se načte youtube-nocookie.com — ten klik je souhlas s tím
// konkrétním přehráním.
interface Props {
  id: string;
  titulek: string;
  nahled: string;
  start?: number;
  popisek?: string;
  pozn?: string;
}

const { id, titulek, nahled, start = 0, popisek, pozn } = Astro.props;
---

<figure class="mt-6">
  <div
    class="video-fasada relative overflow-hidden rounded-2xl bg-charcoal-900"
    data-video={id}
    data-start={start}
    data-titulek={titulek}
  >
    <button
      type="button"
      class="group block w-full cursor-pointer border-0 p-0"
      aria-label={`Přehrát video: ${titulek}`}
    >
      <img
        src={nahled}
        width="1280"
        height="720"
        loading="lazy"
        alt=""
        class="block w-full transition-opacity group-hover:opacity-85"
      />
      <span
        class="pointer-events-none absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-brand-500 shadow-lg transition-transform group-hover:scale-110 sm:h-20 sm:w-20"
      >
        <svg class="ml-1 h-7 w-7 text-white sm:h-9 sm:w-9" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </button>
  </div>

  {(popisek || pozn) && (
    <figcaption class="mt-2.5 text-sm text-charcoal-400">
      {popisek}
      {pozn && <span class="block text-xs">{pozn}</span>}
    </figcaption>
  )}
</figure>

<style>
  .video-fasada {
    aspect-ratio: 16 / 9;
  }
  .video-fasada iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.video-fasada').forEach(obal => {
    const tlacitko = obal.querySelector('button');
    tlacitko?.addEventListener('click', () => {
      const id = obal.dataset.video;
      const start = obal.dataset.start || '0';
      const ramec = document.createElement('iframe');
      // nocookie doména + rel=0, ať se po dohrání nenabízí cizí videa
      ramec.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&start=${start}`;
      ramec.title = obal.dataset.titulek || 'Video';
      ramec.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
      ramec.allowFullscreen = true;
      obal.replaceChildren(ramec);
    });
  });
</script>
