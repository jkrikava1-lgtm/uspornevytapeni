---
// Blok "související témata" pro podstránky Návrhu řešení. Rodičovské stránky
// (Novostavba, Stávající dům) ho měly vlastní, podstránky nic — končily slepě.
// Bere karty rodiče a vynechá tu, na které zrovna jsme.
interface Karta {
  href: string;
  title: string;
  desc: string;
  icon_img?: string;
}

interface Props {
  headline: string;
  items: Karta[];
  krome?: string;
}

const { headline, items, krome } = Astro.props;
const karty = krome ? items.filter(i => i.href !== krome) : items;

// Ať poslední řádek nezůstane rozbitý — mřížku volíme podle počtu karet.
const sloupce = karty.length % 3 === 0 ? 'lg:grid-cols-3' : karty.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4';
---

{karty.length > 0 && (
  <section class="border-t border-gray-100 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold text-charcoal-900 mb-6 text-center">{headline}</h2>
      <div class:list={['grid grid-cols-1 sm:grid-cols-2 gap-4', sloupce]}>
        {karty.map(item => (
          <a
            href={item.href}
            class="group bg-white rounded-xl border border-gray-200 hover:border-brand-300 hover:shadow-lg transition-all p-5"
          >
            {item.icon_img && (
              <img src={item.icon_img} width="48" height="48" loading="lazy" alt="" class="w-12 h-12 object-contain mb-3" />
            )}
            <h3 class="font-bold text-charcoal-900 mb-2 group-hover:text-brand-500 transition-colors">{item.title}</h3>
            <p class="text-sm text-charcoal-500 mb-3">{item.desc}</p>
            <span class="text-xs font-semibold text-brand-500 flex items-center gap-1">
              Více
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
